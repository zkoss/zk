<?page title="Chip" contentType="text/html;charset=UTF-8"?>
<zk>
<div sclass="z-p-8 z-d-flex z-flex-col z-gap-6">
    <div sclass="z-border-bottom z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Chip"/></div>

    <div>
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Severities"/></div>
        <div sclass="z-d-flex z-gap-3 z-flex-wrap z-items-center">
            <chip label="Info"      severity="info"/>
            <chip label="Success"   severity="success"/>
            <chip label="Warning"   severity="warning"/>
            <chip label="Danger"    severity="error"/>
            <chip label="Secondary" severity="neutral"/>
        </div>
    </div>

    <div>
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Sizes"/></div>
        <div sclass="z-d-flex z-gap-3 z-flex-wrap z-items-center">
            <chip label="Small"  severity="info" size="small"/>
            <chip label="Medium" severity="info" size="medium"/>
        </div>
    </div>

    <div>
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Rounded"/></div>
        <div sclass="z-d-flex z-gap-3 z-flex-wrap z-items-center">
            <chip label="Rounded Info"    severity="info" rounded="true"/>
            <chip label="Rounded Success" severity="success" rounded="true"/>
        </div>
    </div>

    <div>
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Closable"/></div>
        <div sclass="z-d-flex z-gap-3 z-flex-wrap z-items-center">
            <chip label="Closable"          severity="info" closable="true"/>
            <chip label="Closable Rounded"  severity="success" closable="true" rounded="true"/>
        </div>
    </div>

    <div>
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Disabled"/></div>
        <div sclass="z-d-flex z-gap-3 z-flex-wrap z-items-center">
            <chip label="Disabled"          severity="info" disabled="true"/>
            <chip label="Disabled Closable" severity="info" disabled="true" closable="true"/>
        </div>
    </div>

    <div>
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Custom color (style hook)"/></div>
        <div sclass="z-d-flex z-gap-3 z-flex-wrap z-items-center">
            <chip label="Custom" style="--zk-chip-bg:#ede7f6;--zk-chip-border:#d1c4e9;--zk-chip-color:#5e35b1"/>
        </div>
    </div>
</div>
</zk>
