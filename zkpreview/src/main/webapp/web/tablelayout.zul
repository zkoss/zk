<?page title="Tablelayout" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">Tablelayout</h:span></h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">2-Column Table Layout</h:span></h:div>
        <h:div class="z-py-3">
            <tablelayout columns="2">
                <tablechildren>
                    <panel title="Table 1" border="normal" maximizable="true"
                        collapsible="true" width="200px" height="200px">
                        <panelchildren>Panel Content</panelchildren>
                    </panel>
                </tablechildren>
                <tablechildren>
                    <panel title="Table 2" border="normal" maximizable="true"
                        collapsible="true" width="200px" height="200px">
                        <panelchildren>Panel Content</panelchildren>
                    </panel>
                </tablechildren>
                <tablechildren>
                    <panel title="Table 3" border="normal" maximizable="true"
                        collapsible="true" width="200px" height="200px">
                        <panelchildren>Panel Content</panelchildren>
                    </panel>
                </tablechildren>
                <tablechildren>
                    <panel title="Table 4" border="normal" maximizable="true"
                        collapsible="true" width="200px" height="200px">
                        <panelchildren>Panel Content</panelchildren>
                    </panel>
                </tablechildren>
            </tablelayout>
        </h:div>
    </h:div>

</h:div>
</zk>
