<?page title="Marble Use Cases"?>
<?link rel="stylesheet" type="text/css" href="~./usecase/usecase.css"?><zk>
<script src="http://localhost:50000/zk-live-reload.js" defer="true"/>
<!-- defines marbleReportIssue(), called by the sidebar's "Report this page" button -->
<script src="~./usecase/report-issue.js"/>
<borderlayout height="100vh" viewModel="@id('vm') @init('zk.example.UseCaseVM')"
    onBookmarkChange="@command('handleBookmarkChange', bookmark=event.bookmark)">

    <west size="258px" border="none" collapsible="false" autoscroll="true">
        <div sclass="z-p-2">
            <div sclass="sidebar-brand z-d-flex z-items-baseline z-gap-2">
                <label value="Marble"/>
                <!-- HEAD commit date + short hash, stamped in at build time so a design
                     reviewer can pin a screenshot to a commit. See UseCaseVM.getCommitStamp(). -->
                <label value="@load(vm.commitStamp)" sclass="z-text-xs z-fw-normal z-text-secondary"/>
            </div>
            <div sclass="z-d-flex z-items-center z-gap-2 z-px-2 z-py-2 z-mb-2 z-border-bottom">
                <label value="Compact density" sclass="z-text-sm z-flex-1"/>
                <checkbox mold="switch" checked="@load(vm.compactMode)"
                          onCheck="@command('toggleCompactMode', on=self.checked)"/>
            </div>
            <button label="Report this page" iconSclass="z-icon-flag"
                    sclass="z-button-outlined z-w-100 z-mb-2"
                    xmlns:w="client" w:onClick="marbleReportIssue()"/>
            <navbar orient="vertical">
                <nav label="Use Cases" open="@load(vm.openNavLabel eq 'Use Cases')">
                    <navitem label="Inventory List"       selected="@load(vm.currentPage eq '~./usecase/inventory-table.zul')" onClick="@command('navigate', page='~./usecase/inventory-table.zul')" />
                    <navitem label="Item Detail"          selected="@load(vm.currentPage eq '~./usecase/item-editor.zul')" onClick="@command('navigate', page='~./usecase/item-editor.zul')" />
                    <navitem label="Support Ticket Inbox" selected="@load(vm.currentPage eq '~./usecase/ticket-inbox.zul')" onClick="@command('navigate', page='~./usecase/ticket-inbox.zul')" />
                    <navitem label="Operations Dashboard" selected="@load(vm.currentPage eq '~./usecase/ops-dashboard.zul')" onClick="@command('navigate', page='~./usecase/ops-dashboard.zul')" />
                    <navitem label="Onboarding Wizard"    selected="@load(vm.currentPage eq '~./usecase/onboarding-wizard.zul')" onClick="@command('navigate', page='~./usecase/onboarding-wizard.zul')" />
                    <navitem label="Account Settings"     selected="@load(vm.currentPage eq '~./usecase/account-settings.zul')" onClick="@command('navigate', page='~./usecase/account-settings.zul')" />
                    <navitem label="Sign-In"              selected="@load(vm.currentPage eq '~./usecase/sign-in.zul')" onClick="@command('navigate', page='~./usecase/sign-in.zul')" />
                    <navitem label="Brand Presets"        selected="@load(vm.currentPage eq '~./usecase/brand-switcher.zul')" onClick="@command('navigate', page='~./usecase/brand-switcher.zul')" />
                </nav>
                <nav label="Inputs" open="@load(vm.openNavLabel eq 'Inputs')">
                    <navitem label="Bandbox"          selected="@load(vm.currentPage eq '~./bandbox.zul')" onClick="@command('navigate', page='~./bandbox.zul')" />
                    <navitem label="Button"           selected="@load(vm.currentPage eq '~./button.zul')" onClick="@command('navigate', page='~./button.zul')" />
                    <navitem label="Calendar"         selected="@load(vm.currentPage eq '~./calendar.zul')" onClick="@command('navigate', page='~./calendar.zul')" />
                    <navitem label="Cascader"         selected="@load(vm.currentPage eq '~./cascader.zul')" onClick="@command('navigate', page='~./cascader.zul')" />
