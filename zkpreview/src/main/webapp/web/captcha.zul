<?page title="Captcha" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">Captcha</h:span></h:div>
    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Verify</h:span></h:div>
        <h:div class="z-py-3 z-d-flex z-flex-col z-gap-4">
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-3">
                <captcha id="cpa" length="5" width="200px" height="50px"/>
                <h:div class="z-d-flex z-items-center z-gap-3">
                    <textbox id="answer" width="120px" placeholder="Enter text"/>
                    <button label="Verify">
                        <attribute name="onClick">
                            if (cpa.getValue().equalsIgnoreCase(answer.getValue())) {
                                Clients.showNotification("Correct!", "info", null, "top_right", 2000, true);
                            } else {
                                Clients.showNotification("Incorrect, try again.", "error", null, "top_right", 2000, true);
                                cpa.regenerate();
                            }
                        </attribute>
                    </button>
                    <button label="Refresh" onClick="cpa.regenerate()"/>
                </h:div>
            </h:div>
        </h:div>
    </h:div>
</h:div>
</zk>
