<?page title="Signature" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">Signature</h:span></h:div>
    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Signature Pad</h:span></h:div>
        <h:div class="z-py-3 z-d-flex z-flex-col z-gap-4">
            <signature id="signature" width="600px" height="200px"
                       onSave="image.content = event.media"
                       undoLabel="Undo" saveLabel="Save" clearLabel="Clear"/>
        </h:div>
    </h:div>
    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Customization</h:span></h:div>
        <h:div class="z-py-3 z-d-flex z-flex-col z-gap-4">
            <h:span class="z-text-xs z-text-secondary">penColor="#d32f2f"</h:span>
            <signature width="600px" height="200px" penColor="#d32f2f"/>
            <h:span class="z-text-xs z-text-secondary">backgroundColor="#FFF8E1"</h:span>
            <signature width="600px" height="200px" backgroundColor="#FFF8E1"/>
            <h:span class="z-text-xs z-text-secondary">penSize="5"</h:span>
            <signature width="600px" height="200px" penSize="5"/>
        </h:div>
    </h:div>
    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Saved Signature</h:span></h:div>
        <h:div class="z-py-3">
            <image id="image" width="600px" height="200px" style="border: 1px solid var(--zk-color-outline);"/>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Toolbar Hidden</h:span></h:div>
        <h:div class="z-py-3 z-d-flex z-flex-col z-gap-4">
            <h:span class="z-text-xs z-text-secondary">toolbarVisible="false" — toolbar strip permanently hidden (.z-signature-toolbar-hide)</h:span>
            <signature width="600px" height="200px" toolbarVisible="false"/>
        </h:div>
    </h:div>
</h:div>
</zk>
