<?page title="Barcode" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">Barcode</h:span></h:div>
    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">1D Barcodes</h:span></h:div>
        <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">Code128 — &quot;test&quot;</h:span></h:div>
                <barcode value="test" barWidth="3" height="50px"/>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">EAN13</h:span></h:div>
                <barcode type="EAN13" value="7610700948859"/>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">EAN13 with value label</h:span></h:div>
                <barcode type="EAN13" value="7610700948859" displayValue="true" fontSize="15" height="75px"/>
            </h:div>
        </h:div>
    </h:div>
    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">2D Barcodes</h:span></h:div>
        <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">QR — zkoss.org</h:span></h:div>
                <barcode type="QR" value="https://www.zkoss.org/" height="100px" width="100px"/>
            </h:div>
        </h:div>
    </h:div>
</h:div>
</zk>
