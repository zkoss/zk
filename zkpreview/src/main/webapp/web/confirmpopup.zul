<?page title="ConfirmPopup" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">ConfirmPopup</h:span></h:div>

    <h:div class="z-mb-8">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-3"><h:span class="z-text-md z-fw-bold z-text-secondary">ConfirmPopup — State Gallery (Severity)</h:span></h:div>

        <h:div class="z-d-flex z-flex-wrap z-gap-8 z-items-start z-py-4 z-mb-2">
            <h:div class="z-d-flex z-flex-col z-items-center z-gap-2">
                <h:div class="z-text-uppercase z-text-center"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Info</h:span></h:div>
                <h:div class="z-confirmpopup z-confirmpopup-info z-confirmpopup-placement-top" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-header">Confirm</h:div>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">Here is some info for you.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-center z-gap-2">
                <h:div class="z-text-uppercase z-text-center"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Success</h:span></h:div>
                <h:div class="z-confirmpopup z-confirmpopup-success z-confirmpopup-placement-top" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-header">Confirm</h:div>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">The operation completed successfully.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-center z-gap-2">
                <h:div class="z-text-uppercase z-text-center"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Warning</h:span></h:div>
                <h:div class="z-confirmpopup z-confirmpopup-warning z-confirmpopup-placement-top" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-header">Confirm</h:div>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">This action may have side effects.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-center z-gap-2">
                <h:div class="z-text-uppercase z-text-center"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Danger</h:span></h:div>
                <h:div class="z-confirmpopup z-confirmpopup-error z-confirmpopup-placement-top" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-header">Delete item?</h:div>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">This cannot be undone.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-center z-gap-2">
                <h:div class="z-text-uppercase z-text-center"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Secondary</h:span></h:div>
                <h:div class="z-confirmpopup z-confirmpopup-neutral z-confirmpopup-placement-top" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-header">Confirm</h:div>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">Would you like to proceed?</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </h:div>
        </h:div>
    </h:div>

    <h:div class="z-mb-8">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-3"><h:span class="z-text-md z-fw-bold z-text-secondary">ConfirmPopup — State Gallery (Placement)</h:span></h:div>

        <h:div class="z-d-flex z-flex-wrap z-gap-8 z-items-start z-py-4 z-mb-2">
            <h:div class="z-d-flex z-flex-col z-items-center z-gap-2">
                <h:div class="z-text-uppercase z-text-center"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Top</h:span></h:div>
                <h:div class="z-confirmpopup z-confirmpopup-warning z-confirmpopup-placement-top" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">Box above trigger, arrow bottom edge.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-center z-gap-2">
                <h:div class="z-text-uppercase z-text-center"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Bottom</h:span></h:div>
                <h:div class="z-confirmpopup z-confirmpopup-warning z-confirmpopup-placement-bottom" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">Box below trigger, arrow top edge.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-center z-gap-2">
                <h:div class="z-text-uppercase z-text-center"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Left</h:span></h:div>
                <h:div class="z-confirmpopup z-confirmpopup-warning z-confirmpopup-placement-left" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">Box left of trigger, arrow right edge.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-center z-gap-2">
                <h:div class="z-text-uppercase z-text-center"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Right</h:span></h:div>
                <h:div class="z-confirmpopup z-confirmpopup-warning z-confirmpopup-placement-right" style="position:relative;">
                    <h:span class="z-confirmpopup-arrow"/>
                    <h:div class="z-confirmpopup-body">
                        <h:i class="z-confirmpopup-icon z-icon-exclamation-triangle"/>
                        <h:div class="z-confirmpopup-message">Box right of trigger, arrow left edge.</h:div>
                    </h:div>
                    <h:div class="z-confirmpopup-footer">
                        <h:button type="button" class="z-confirmpopup-cancel">Cancel</h:button>
                        <h:button type="button" class="z-confirmpopup-ok">OK</h:button>
                    </h:div>
                </h:div>
            </h:div>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Live — By Severity</h:span></h:div>
        <h:div class="z-py-3 z-d-flex z-gap-4 z-flex-wrap">
            <button label="Info" popup="cpInfo"/>
            <button label="Success" popup="cpSuccess"/>
            <button label="Warning" popup="cpWarning"/>
            <button label="Danger" popup="cpDanger"/>
            <button label="Secondary" popup="cpSecondary"/>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Live — Placement</h:span></h:div>
        <h:div class="z-py-3 z-d-flex z-gap-4 z-flex-wrap">
            <button label="Top" popup="cpTop"/>
            <button label="Bottom" popup="cpBottom"/>
            <button label="Left" popup="cpLeft"/>
            <button label="Right" popup="cpRight"/>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Live — OK / Cancel Feedback</h:span></h:div>
        <h:div class="z-py-3 z-d-flex z-gap-4 z-flex-wrap z-items-center">
            <button label="Delete item" popup="cpDelete"/>
            <label id="deleteResult" value=""/>
        </h:div>
    </h:div>

    <confirmpopup id="cpInfo" severity="info" title="Confirm" message="Here is some info for you."/>
    <confirmpopup id="cpSuccess" severity="success" title="Confirm" message="The operation completed successfully."/>
    <confirmpopup id="cpWarning" severity="warning" title="Confirm" message="This action may have side effects."/>
    <confirmpopup id="cpDanger" severity="error" title="Delete item?" message="This cannot be undone." defaultFocus="cancel"/>
    <confirmpopup id="cpSecondary" severity="neutral" title="Confirm" message="Would you like to proceed?"/>

    <confirmpopup id="cpTop" placement="top" message="Box above trigger, arrow bottom edge."/>
    <confirmpopup id="cpBottom" placement="bottom" message="Box below trigger, arrow top edge."/>
    <confirmpopup id="cpLeft" placement="left" message="Box left of trigger, arrow right edge."/>
    <confirmpopup id="cpRight" placement="right" message="Box right of trigger, arrow left edge."/>

    <confirmpopup id="cpDelete" severity="error" title="Delete item?" message="This cannot be undone." defaultFocus="cancel">
        <attribute name="onOK">deleteResult.setValue("OK — item deleted.");</attribute>
        <attribute name="onCancel">deleteResult.setValue("Cancelled.");</attribute>
    </confirmpopup>
</h:div>
</zk>
