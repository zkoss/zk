<?page title="Rangeslider" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<zscript><![CDATA[
    java.util.LinkedHashMap rangeMarks = new java.util.LinkedHashMap();
    rangeMarks.put(0, "Start");
    rangeMarks.put(25, "Q1");
    rangeMarks.put(50, "Mid");
    rangeMarks.put(75, "Q3");
    rangeMarks.put(100, "End");
]]></zscript>
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">Rangeslider</h:span></h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Horizontal</h:span></h:div>
        <h:div class="z-d-flex z-flex-col z-items-start z-gap-4 z-py-3">
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">Default</h:span></h:div>
                <rangeslider startValue="10" endValue="90" width="500px"/>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">With scale marks</h:span></h:div>
                <rangeslider startValue="20" endValue="80" markScale="20" width="500px"/>
            </h:div>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Vertical</h:span></h:div>
        <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <h:div class="z-d-flex z-flex-col z-items-center z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">Default</h:span></h:div>
                <rangeslider orient="vertical" startValue="20" endValue="80" height="500px"/>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-center z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">With scale marks</h:span></h:div>
                <rangeslider orient="vertical" startValue="20" endValue="80" markScale="20" height="500px"/>
            </h:div>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Marks / Disabled / Tooltip Visible</h:span></h:div>
        <h:div class="z-d-flex z-flex-col z-items-start z-gap-8 z-py-3">
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">Custom text marks (Start/Q1/Mid/Q3/End)</h:span></h:div>
                <rangeslider startValue="25" endValue="75" marks="${rangeMarks}" width="500px"/>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">Disabled</h:span></h:div>
                <rangeslider startValue="20" endValue="80" disabled="true" width="500px"/>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-8">
                <h:div><h:span class="z-text-xs z-text-secondary">Always-visible tooltips</h:span></h:div>
                <rangeslider startValue="30" endValue="70" tooltipVisible="true" width="500px"/>
            </h:div>
        </h:div>
    </h:div>
</h:div>
</zk>
