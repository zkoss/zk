<?page title="Paging" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Paging"/></div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Paging Variants"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Default mold (detailed)"/></div>
                <paging totalSize="300" pageSize="5" activePage="15" detailed="true"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="OS mold (detailed)"/></div>
                <paging totalSize="300" pageSize="5" activePage="15" detailed="true" mold="os"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="OS mold (compact)"/></div>
                <paging totalSize="50" pageSize="5" mold="os" />
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Default Mold — Jump-to-Page Input Field (.z-paging-input)"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Default mold (shows page input + total)"/></div>
                <paging totalSize="200" pageSize="10" activePage="4"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Default mold — first page (prev/first disabled)"/></div>
                <paging totalSize="200" pageSize="10" activePage="0"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Default mold — last page (next/last disabled)"/></div>
                <paging totalSize="200" pageSize="10" activePage="19"/>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Disabled Paging (disabled=&quot;true&quot;)"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Default mold (buttons, input and total text disabled)"/></div>
                <paging sclass="pv-paging-disabled-default" totalSize="200" pageSize="10" activePage="4" disabled="true"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="OS mold (buttons disabled)"/></div>
                <paging sclass="pv-paging-disabled-os" totalSize="50" pageSize="5" activePage="4" mold="os" disabled="true"/>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Pagination with Data Grid"/></div>
        <div sclass="z-py-3">
            <grid mold="default">
                <columns>
                    <column label="#"/>
                    <column label="First Name"/>
                    <column label="Last Name"/>
                    <column label="Username"/>
                </columns>
                <rows>
                    <row>
                        <label value="1"/>
                        <label value="Mark"/>
                        <label value="Otto"/>
                        <label value="@mdo"/>
                    </row>
                    <row>
                        <label value="2"/>
                        <label value="Jacob"/>
                        <label value="Thornton"/>
                        <label value="@fat"/>
                    </row>
                    <row>
                        <label value="3"/>
                        <label value="Larry"/>
                        <label value="the Bird"/>
                        <label value="@twitter"/>
                    </row>
                    <row>
                        <label value="4"/>
                        <label value="John"/>
                        <label value="Smith"/>
                        <label value="@jsmith"/>
                    </row>
                    <row>
                        <label value="5"/>
                        <label value="Jane"/>
                        <label value="Doe"/>
                        <label value="@jdoe"/>
                    </row>
                </rows>
            </grid>
            <paging totalSize="50" pageSize="5" mold="os" />
        </div>
    </div>
</div>
</zk>
