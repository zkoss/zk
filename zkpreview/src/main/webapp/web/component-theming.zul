<?page title="Component Theme Variables" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Component Theme Variables"/></div>

    <div sclass="z-mb-8" style="max-width:60ch"><label sclass="z-text-sm z-text-secondary" value="Adopters restyle one component by setting its --zk-&lt;comp&gt;-* custom properties, either at :root (whole app) or on any container element (one region — descendants inherit it). Each pair below shows a stock &quot;Default&quot; and a scoped override box; the defaults reproduce stock Marble exactly. Pilot components: button, input, window, grid. See doc/spec/component-theme-variables.md."/></div>

    <!-- Default: no override — proves zero regression -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Default (no override)"/></div>
    <div sclass="z-hstack z-mb-8">
        <button label="Default Primary"/>
        <button label="Default Icon" iconSclass="z-icon-settings"/>
        <button label="Default Disabled" disabled="true"/>
    </div>

    <!-- Regional override: pill radius + purple fill, scoped to THIS container only.
         The buttons above are unaffected (override lives on this box, inherited only by its subtree). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Regional override (scoped to this box)"/></div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-button-bg:#6750a4; --zk-button-fg:#ffffff; --zk-button-overlay-color:#ffffff; --zk-button-radius:9999px">
        <button label="Scoped Primary"/>
        <button label="Scoped Icon" iconSclass="z-icon-settings"/>
        <button label="Scoped Disabled" disabled="true"/>
    </div>

    <!-- Input: per-state border-color + surface knobs -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Input (default)"/></div>
    <div sclass="z-hstack z-mb-6">
        <textbox value="Default field"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Input (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-input-radius:12px; --zk-input-border-color:#6750a4; --zk-input-border-color-hover:#6750a4">
        <textbox value="Scoped field"/>
    </div>

    <!-- Window: surface + chrome knobs (elevation stays mode-driven) -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Window (default)"/></div>
    <div sclass="z-mb-6">
        <window title="Default Window" border="normal" width="260px">
            <div sclass="z-p-4">Body content</div>
        </window>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Window (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-window-radius:16px; --zk-window-bg:#eef2ff; --zk-window-border-color:#6750a4">
        <window title="Scoped Window" border="normal" width="260px">
            <div sclass="z-p-4">Body content</div>
        </window>
    </div>

    <!-- Grid: outlined-table lines + fills -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Grid (default)"/></div>
    <div sclass="z-mb-6">
        <grid width="320px">
            <columns>
                <column label="Name"/>
                <column label="Value"/>
            </columns>
            <rows>
                <row><label value="Alpha"/><label value="1"/></row>
                <row><label value="Beta"/><label value="2"/></row>
                <row><label value="Gamma"/><label value="3"/></row>
            </rows>
        </grid>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Grid (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-grid-radius:0px; --zk-grid-border-color:#6750a4; --zk-grid-stripe-bg:#efe6ff">
        <grid width="320px">
            <columns>
                <column label="Name"/>
                <column label="Value"/>
            </columns>
            <rows>
                <row><label value="Alpha"/><label value="1"/></row>
                <row><label value="Beta"/><label value="2"/></row>
                <row><label value="Gamma"/><label value="3"/></row>
            </rows>
        </grid>
    </div>

    <!-- Listbox: data table + row selection knobs -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Listbox (default)"/></div>
    <div sclass="z-mb-6">
        <listbox width="320px">
            <listhead>
                <listheader label="Name"/>
                <listheader label="Value"/>
            </listhead>
            <listitem selected="true"><listcell label="Alpha"/><listcell label="1"/></listitem>
            <listitem><listcell label="Beta"/><listcell label="2"/></listitem>
            <listitem><listcell label="Gamma"/><listcell label="3"/></listitem>
        </listbox>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Listbox (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-listbox-radius:0px; --zk-listbox-border-color:#6750a4; --zk-listbox-selected-bg:#6750a4; --zk-listbox-selected-fg:#ffffff">
        <listbox width="320px">
            <listhead>
                <listheader label="Name"/>
                <listheader label="Value"/>
            </listhead>
            <listitem selected="true"><listcell label="Alpha"/><listcell label="1"/></listitem>
            <listitem><listcell label="Beta"/><listcell label="2"/></listitem>
            <listitem><listcell label="Gamma"/><listcell label="3"/></listitem>
        </listbox>
    </div>

    <!-- Tree: tree table + row selection knobs -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Tree (default)"/></div>
    <div sclass="z-mb-6">
        <tree width="320px">
            <treecols>
                <treecol label="Name"/>
                <treecol label="Type"/>
            </treecols>
            <treechildren>
                <treeitem selected="true">
                    <treerow><treecell label="Root"/><treecell label="folder"/></treerow>
                </treeitem>
                <treeitem>
                    <treerow><treecell label="Leaf"/><treecell label="file"/></treerow>
                </treeitem>
            </treechildren>
        </tree>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Tree (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-tree-radius:0px; --zk-tree-border-color:#6750a4; --zk-tree-selected-bg:#6750a4; --zk-tree-selected-fg:#ffffff">
        <tree width="320px">
            <treecols>
                <treecol label="Name"/>
                <treecol label="Type"/>
            </treecols>
            <treechildren>
                <treeitem selected="true">
                    <treerow><treecell label="Root"/><treecell label="folder"/></treerow>
                </treeitem>
                <treeitem>
                    <treerow><treecell label="Leaf"/><treecell label="file"/></treerow>
                </treeitem>
            </treechildren>
        </tree>
    </div>

    <!-- Panel: card surface + header (window-like, with elevation) -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Panel (default)"/></div>
    <div sclass="z-mb-6">
        <panel border="rounded" width="260px">
            <caption label="Default Panel"/>
            <panelchildren><div sclass="z-p-2">Body content</div></panelchildren>
        </panel>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Panel (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-panel-radius:0px; --zk-panel-border-color:#6750a4; --zk-panel-bg:#eef2ff">
        <panel border="rounded" width="260px">
            <caption label="Scoped Panel"/>
            <panelchildren><div sclass="z-p-2">Body content</div></panelchildren>
        </panel>
    </div>

    <!-- Groupbox: bordered container + header -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Groupbox (default)"/></div>
    <div sclass="z-mb-6">
        <groupbox width="260px">
            <caption label="Default Group"/>
            <div sclass="z-p-2">Body content</div>
        </groupbox>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Groupbox (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-groupbox-radius:0px; --zk-groupbox-border-color:#6750a4">
        <groupbox width="260px">
            <caption label="Scoped Group"/>
            <div sclass="z-p-2">Body content</div>
        </groupbox>
    </div>

    <!-- Combobox: outlined field + dropdown popup + option selection -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Combobox (default)"/></div>
    <div sclass="z-hstack z-mb-6">
        <combobox width="200px">
            <comboitem label="Alpha"/>
            <comboitem label="Beta"/>
            <comboitem label="Gamma"/>
        </combobox>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Combobox (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-combobox-radius:0px; --zk-combobox-border-color:#6750a4; --zk-combobox-selected-bg:#6750a4; --zk-combobox-selected-fg:#ffffff">
        <combobox width="200px">
            <comboitem label="Alpha"/>
            <comboitem label="Beta"/>
            <comboitem label="Gamma"/>
        </combobox>
    </div>

    <!-- Datebox / Timebox / Spinner / Bandbox: dropdown-input family (wrapper-border model).
         Border sits on the root wrapper; focus is an inset ring. Same field knobs as combobox. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Datebox / Timebox / Spinner / Bandbox (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <datebox/>
        <timebox/>
        <spinner value="5"/>
        <bandbox/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Dropdown-input family (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-datebox-radius:0px; --zk-datebox-border-color:#6750a4;
                --zk-timebox-radius:0px; --zk-timebox-border-color:#6750a4;
                --zk-spinner-radius:0px; --zk-spinner-border-color:#6750a4;
                --zk-bandbox-radius:0px; --zk-bandbox-border-color:#6750a4">
        <datebox/>
        <timebox/>
        <spinner value="5"/>
        <bandbox/>
    </div>

    <!-- Daterangebox (EE, zkmax): two-ended date-range picker field + range-calendar popup.
         Same wrapper-border knob vocabulary as datebox/timebox/spinner/bandbox (bg/fg/radius,
         per-state border color, plus a popup-bg/popup-radius pair); the trigger button's
         radius reuses the same radius knob. Invalid state stays on the color-error token,
         not knob-driven (same convention as datebox). -->
    <zscript>
        java.util.Date daterangeThemingBegin = new java.util.Date(125, 0, 10);  // 2025-01-10
        java.util.Date daterangeThemingEnd   = new java.util.Date(125, 0, 15);  // 2025-01-15
    </zscript>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Daterangebox (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <daterangebox beginValue="${daterangeThemingBegin}" endValue="${daterangeThemingEnd}"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Daterangebox (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-daterangebox-radius:0px; --zk-daterangebox-border-color:#6750a4">
        <daterangebox beginValue="${daterangeThemingBegin}" endValue="${daterangeThemingEnd}"/>
    </div>

    <!-- Tab (tabbox): nav chrome + active accent -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Tabbox (default)"/></div>
    <div sclass="z-mb-6">
        <tabbox width="320px">
            <tabs><tab label="One"/><tab label="Two"/><tab label="Three"/></tabs>
            <tabpanels><tabpanel>One</tabpanel><tabpanel>Two</tabpanel><tabpanel>Three</tabpanel></tabpanels>
        </tabbox>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Tabbox (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-tab-border-color:#6750a4; --zk-tab-accent:#6750a4">
        <tabbox width="320px">
            <tabs><tab label="One"/><tab label="Two"/><tab label="Three"/></tabs>
            <tabpanels><tabpanel>One</tabpanel><tabpanel>Two</tabpanel><tabpanel>Three</tabpanel></tabpanels>
        </tabbox>
    </div>

    <!-- Menu: menubar surface + dropdown popup + selected item -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Menubar (default)"/></div>
    <div sclass="z-mb-6">
        <menubar width="320px">
            <menu label="File"><menupopup><menuitem label="New"/><menuitem label="Open"/></menupopup></menu>
            <menu label="Edit"><menupopup><menuitem label="Cut"/></menupopup></menu>
        </menubar>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Menubar (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded" style="--zk-menubar-bg:#6750a4">
        <menubar width="320px">
            <menu label="File"><menupopup><menuitem label="New"/><menuitem label="Open"/></menupopup></menu>
            <menu label="Edit"><menupopup><menuitem label="Cut"/></menupopup></menu>
        </menubar>
    </div>

    <!-- Avatar (native): base defaults hoisted to :root → regionally overridable.
         Chip base is also hoisted for consistency, but ZK stamps a default severity
         class (z-chip-info) that sets the fill on the element, so chip is themed
         per-severity / inline — see doc/spec/component-theme-variables.md. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Avatar + Chip (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <avatar label="AB"/>
        <chip label="Tag"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Avatar (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-avatar-bg:#6750a4; --zk-avatar-fg:#ffffff">
        <avatar label="AB"/>
    </div>

    <!-- Badge (native): the default (info) fill flows through the base zk-badge-bg
         knob at :root, so a region override DOES reach a default badge; explicit
         non-default severities pin their own fill. See component-theme-variables spec. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Badge (default + success)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <badge count="4"/>
        <badge count="4" severity="success"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Badge (regional override — default fill only)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-badge-bg:#6750a4">
        <badge count="4"/>
        <badge count="4" severity="success"/>
    </div>

    <!-- Rating: star glyph fill only (no bg/border/radius — icon-only, no
         container box). Resting stars read the fg knob; selected/hover swap to
         the accent knob (the defining state). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Rating (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <rating rating="3"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Rating (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-rating-accent:#6750a4">
        <rating rating="3"/>
    </div>

    <!-- Progressmeter: MD3 linear progress — track fill + progress-bar fill knobs.
         The color variants (z-progressmeter-secondary/-success/-warning/-error) keep
         their own semantic colors via higher-specificity rules, same treatment as
         button's color variants — not knob-driven. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Progressmeter (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <progressmeter value="60" width="200px"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Progressmeter (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-progressmeter-bg:#efe6ff; --zk-progressmeter-fill:#6750a4">
        <progressmeter value="60" width="200px"/>
    </div>

    <!-- Paging: pager button shape/fg + selected (current-page) fill/text.
         mold="os" is required to render numbered page buttons — the default
         mold only shows prev/next + a jump-to-page input, with no
         .z-paging-selected. The jump-to-page input (default mold only) has
         its own bg/fg/border-color trio (see spec), not demoed on this page.
         Disabled buttons are intentionally not knob-driven (same convention
         as button/input). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Paging (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <paging mold="os" totalSize="200" pageSize="10" activePage="4"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Paging (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-paging-radius:4px; --zk-paging-selected-bg:#6750a4; --zk-paging-selected-fg:#ffffff">
        <paging mold="os" totalSize="200" pageSize="10" activePage="4"/>
    </div>

    <!-- Combobutton: split button (filled base) — shares the button family's overlay
         state model (bg/fg + radius + overlay color/opacities), plus its own divider
         accent between the content and arrow areas. The toolbar mold is a color
         VARIANT (like button's outlined/text variants) and disabled stays on base
         tokens — both intentionally not knob-driven, same convention as button. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Combobutton (default)"/></div>
    <div sclass="z-hstack z-mb-6">
        <combobutton label="Default Action">
            <menupopup><menuitem label="Option 1"/><menuitem label="Option 2"/></menupopup>
        </combobutton>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Combobutton (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-combobutton-bg:#6750a4; --zk-combobutton-fg:#ffffff; --zk-combobutton-overlay-color:#ffffff; --zk-combobutton-radius:9999px">
        <combobutton label="Scoped Action">
            <menupopup><menuitem label="Option 1"/><menuitem label="Option 2"/></menupopup>
        </combobutton>
    </div>

    <!-- Selectbox: native select element (Listbox "select" mold, .z-select).
         Renders as a single native select, no wrapper; state is a per-state
         border-color change (no overlay), same model as Input. Disabled stays
         off the knobs (same convention as input/button). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Selectbox (default)"/></div>
    <div sclass="z-hstack z-mb-6">
        <listbox rows="1" mold="select">
            <listitem label="Inbox"/>
            <listitem label="Sent"/>
            <listitem label="Draft"/>
        </listbox>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Selectbox (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-selectbox-radius:0px; --zk-selectbox-border-color:#6750a4">
        <listbox rows="1" mold="select">
            <listitem label="Inbox"/>
            <listitem label="Sent"/>
            <listitem label="Draft"/>
        </listbox>
    </div>

    <!-- Inputgroup: input + addon(s) combined into a single field. Border color
         and radius are shared by the addon and the grouped input (one continuous
         outline); the addon also carries its own fill/text pair. Focus stays on
         the global focus-ring token (same as button/window/grid), not a knob. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Inputgroup (default)"/></div>
    <div sclass="z-hstack z-mb-6">
        <inputgroup>@<textbox placeholder="username"/></inputgroup>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Inputgroup (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-inputgroup-radius:0px; --zk-inputgroup-border-color:#6750a4; --zk-inputgroup-text-bg:#efe6ff; --zk-inputgroup-text-fg:#6750a4">
        <inputgroup>@<textbox placeholder="username"/></inputgroup>
    </div>

    <!-- Calendar: self-contained month grid + nav header. zk-calendar-accent
         and zk-calendar-accent-fg are a single defining-state pair — they
         recolor the selected day's fill, that day's own hover blend, the
         today ring, and the Today-link label together (same "one knob,
         several roles" pattern as tab's accent). A fixed value date keeps
         the selected cell deterministic for the regression test below. -->
    <zscript>
        java.util.Calendar _calThemingCal = java.util.Calendar.getInstance();
        _calThemingCal.set(2020, java.util.Calendar.MARCH, 15, 10, 30, 0);
        java.util.Date calendarThemingDate = _calThemingCal.getTime();
    </zscript>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Calendar (default)"/></div>
    <div sclass="z-hstack z-mb-6">
        <calendar value="${calendarThemingDate}"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Calendar (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-calendar-radius:0px; --zk-calendar-border-color:#6750a4; --zk-calendar-accent:#6750a4; --zk-calendar-accent-fg:#ffffff">
        <calendar value="${calendarThemingDate}"/>
    </div>

    <!-- Toolbar: chrome bar — fill + shared divider-line knob (border-color drives
         the bar's own edge — border-bottom in the default horizontal mold — same
         "one knob, multiple border roles" precedent as tab's zk-tab-border-color).
         The app-bar context variant (.z-north .z-toolbar) is a distinct color
         VARIANT and keeps its own colors, not knob-driven (same convention as
         combobutton's toolbar mold). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Toolbar (default)"/></div>
    <div sclass="z-mb-6">
        <toolbar>
            <toolbarbutton label="Cut" iconSclass="z-icon-scissors"/>
            <toolbarbutton label="Copy" iconSclass="z-icon-copy"/>
            <toolbarbutton label="Paste" iconSclass="z-icon-clipboard"/>
        </toolbar>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Toolbar (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-toolbar-bg:#eef2ff; --zk-toolbar-border-color:#6750a4">
        <toolbar>
            <toolbarbutton label="Cut" iconSclass="z-icon-scissors"/>
            <toolbarbutton label="Copy" iconSclass="z-icon-copy"/>
            <toolbarbutton label="Paste" iconSclass="z-icon-clipboard"/>
        </toolbar>
    </div>

    <!-- Toolbarbutton: icon/text button rendered inside toolbar chrome (its
         own widget/knob family, not a button variant). The fg knob drives
         both the resting text/icon color and the state-layer overlay (which
         reads currentColor). checked-bg / checked-fg is the one defining
         state (mode="toggle" checked="true"), the same "resting + defining
         state pair" precedent as listbox/tree's selected-bg/-fg. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Toolbarbutton (default)"/></div>
    <div sclass="z-hstack z-mb-6">
        <toolbarbutton label="Cut" iconSclass="z-icon-scissors"/>
        <toolbarbutton label="Starred" iconSclass="z-icon-star" mode="toggle" checked="true"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Toolbarbutton (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-toolbarbutton-fg:#6750a4; --zk-toolbarbutton-radius:0px; --zk-toolbarbutton-checked-bg:#6750a4; --zk-toolbarbutton-checked-fg:#ffffff">
        <toolbarbutton label="Cut" iconSclass="z-icon-scissors"/>
        <toolbarbutton label="Starred" iconSclass="z-icon-star" mode="toggle" checked="true"/>
    </div>

    <!-- Slider: MD3 range input (track + fill + thumb). zk-slider-accent is a
         single defining-state pair role — it colors the active fill AND the
         thumb (same "one knob, several roles" pattern as tab/calendar's
         accent); the hover/focus/active state-layer ring is a tint of the
         same accent. Disabled stays on opacity only, not knob-driven (same
         convention as button/input/rating). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Slider (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <slider curpos="60" width="200px"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Slider (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-slider-track-bg:#efe6ff; --zk-slider-accent:#6750a4; --zk-slider-radius:0px">
        <slider curpos="60" width="200px"/>
    </div>

    <!-- Rangeslider (PE): MD3 dual-thumb range input — shares the Slider
         family's track/accent/radius/elevation vocabulary. zk-rangeslider-accent
         is a single defining-state knob — it colors the active-range fill
         between the two thumbs AND each thumb's fill (same "one knob, several
         roles" pattern as Slider's accent); the hover/focus state-layer ring is
         a tint of the same accent. The marks system and value tooltip are minor
         sub-features kept on base tokens, not knob-driven. Disabled stays on
         opacity only, not knob-driven (same convention as button/input/rating/
         slider). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Rangeslider (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <rangeslider startValue="20" endValue="80" width="200px"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Rangeslider (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-rangeslider-track-bg:#efe6ff; --zk-rangeslider-accent:#6750a4; --zk-rangeslider-radius:0px">
        <rangeslider startValue="20" endValue="80" width="200px"/>
    </div>

    <!-- Multislider (EE): MD3 multi-range slider — shares the Slider/
         Rangeslider family's track/accent/radius/elevation vocabulary (same
         Sliderbuttons sub-widget markup). zk-multislider-accent is a single
         defining-state knob — it colors every active-range fill between
         thumbs AND every thumb's fill (same "one knob, several roles"
         pattern as Rangeslider's accent); the hover/focus state-layer ring is
         a tint of the same accent. Mark labels and the value tooltip are
         minor sub-features kept on base tokens, not knob-driven. Disabled
         stays on opacity only, not knob-driven (same convention as
         button/input/rating/slider/rangeslider). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Multislider (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <multislider width="200px">
            <sliderbuttons startValue="20" endValue="80"/>
        </multislider>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Multislider (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-multislider-track-bg:#efe6ff; --zk-multislider-accent:#6750a4; --zk-multislider-radius:0px">
        <multislider width="200px">
            <sliderbuttons startValue="20" endValue="80"/>
        </multislider>
    </div>

    <!-- Checkbox: default mold — resting border/text + checked/indeterminate accent
         (fill + border + hover-ring tint), the defining state. Switch/toggle molds
         and radio/radiogroup are out of scope for this pass — see
         doc/spec/component-theme-variables.md. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Checkbox (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <checkbox label="Unchecked"/>
        <checkbox label="Checked" checked="true"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Checkbox (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-checkbox-border-color:#6750a4; --zk-checkbox-accent:#6750a4">
        <checkbox label="Unchecked"/>
        <checkbox label="Checked" checked="true"/>
    </div>

    <!-- Radio: no z-radio-mold element, input[type="radio"] IS the visual.
         Resting (unselected) reads the border/text knobs; selected swaps the
         border and the ring/inner-dot fill to a single zk-radio-accent, the
         defining state (same "one knob, several roles" pattern as checkbox's
         accent). The circular shape stays hardcoded, not a knob. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Radio (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <radiogroup>
            <radio label="Option A"/>
            <radio label="Option B" checked="true"/>
        </radiogroup>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Radio (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-radio-border-color:#6750a4; --zk-radio-accent:#6750a4">
        <radiogroup>
            <radio label="Option A"/>
            <radio label="Option B" checked="true"/>
        </radiogroup>
    </div>

    <!-- Messagebox: MD3 alert dialog (Messagebox.show()) — a distinct knob family
         from window's zk-window-*, covering the dialog surface/header/border/
         radius/elevation. Messagebox.show() always parents its Window to the
         page root (Executions.createComponents(…, desktop.getFirstPage(), …)),
         never nested inside the invoking button's container, so a regional
         (container) override cannot reach it — only the whole-app :root
         override applies (same "not regionally demonstrable" precedent as
         chip; see the tracker). The icon-type colors (information/exclamation/
         error/question) are semantic status colors, intentionally not
         knob-driven (same convention as progressmeter's color variants). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Messagebox (default)"/></div>
    <div sclass="z-hstack z-mb-8">
        <button label="Show Messagebox">
            <attribute name="onClick">
                Messagebox.show("Default messagebox, zero override applied.", "Component Theming Demo", Messagebox.OK, Messagebox.INFORMATION);
            </attribute>
        </button>
    </div>

    <!-- Popup: floating surface (tooltips/dropdowns/overlays). Base knobs cover the
         surface fill/text/border/radius/elevation. On open(), Popup.ts reparents the
         widget's real DOM node to document.body (zk.makeVParent(), for stacking above
         any ancestor's overflow/clipping) — verified empirically: the open .z-popup's
         parentElement is BODY, not its authored ZUL ancestor. So — like messagebox,
         for a different root cause — a regional (container) override cannot reach it;
         only the whole-app :root override applies (see the tracker). The tooltip
         variant (.z-popup-tooltip.z-popup — dark bg, white text) is a distinct color
         VARIANT that keeps its own colors, not knob-driven (same convention as
         button's outlined/text variants). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Popup (default)"/></div>
    <div sclass="z-hstack z-mb-8">
        <button label="Show Popup" popup="popupThemingDefault"/>
        <popup id="popupThemingDefault">
            <div sclass="z-p-2">Default popup content</div>
        </popup>
    </div>

    <!-- Notification: floating alert card (Clients.showNotification()). Only the
         untyped/default state reads these knobs — the info/warning/error type
         variants pin their own bg/fg/accent via higher-specificity compound
         selectors (same treatment as button/progressmeter's color variants), so
         a typed notification is unaffected by an override. Elevation (box-shadow)
         stays on its base token, not knob-driven. Rendered here as static markup
         (h:div), mirroring notification.zul's own demo, since Notification is a
         transient JS popup, not an embeddable ZUL component. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Notification (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <h:div class="z-notification" style="position:relative">
            <h:div class="z-notification-content">Default notification message</h:div>
        </h:div>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Notification (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-notification-bg:#eef2ff; --zk-notification-fg:#1a1a2e; --zk-notification-radius:0px">
        <h:div class="z-notification" style="position:relative">
            <h:div class="z-notification-content">Scoped notification message</h:div>
        </h:div>
    </div>

    <!-- Toast: MD3 snackbar (zkmax). Every toast always carries a type variant
         (Toast.show() defaults a null type to "info"), so these knobs drive the
         INFO (default) variant only — the warning/error type variants pin their
         own bg/fg/accent via higher-specificity rules (same treatment as
         notification's type variants), so a typed toast is unaffected by an
         override. Rendered here as static markup (h:div), mirroring toast.zul's
         own demo, since Toast is a transient JS popup, not an embeddable ZUL
         component. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Toast (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <h:div class="z-toast z-toast-info">
            <h:i class="z-toast-icon z-icon-info"></h:i>
            <h:div class="z-toast-content">Default toast message</h:div>
            <h:div class="z-toast-close"><h:i class="z-toast-icon z-icon-x"></h:i></h:div>
        </h:div>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Toast (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-toast-bg:#eef2ff; --zk-toast-fg:#1a1a2e; --zk-toast-radius:0px; --zk-toast-accent:#6750a4">
        <h:div class="z-toast z-toast-info">
            <h:i class="z-toast-icon z-icon-info"></h:i>
            <h:div class="z-toast-content">Scoped toast message</h:div>
            <h:div class="z-toast-close"><h:i class="z-toast-icon z-icon-x"></h:i></h:div>
        </h:div>
    </div>

    <!-- A (anchor/link): MD3 text link, text-only (no bg/border/radius). Resting
         AND hover color read the same fg knob (both are the same value today),
         so one knob keeps them in lockstep — the same "one knob, several roles"
         precedent as tab/calendar's accent. Focus stays on the global focus-ring
         token, not a knob; disabled stays on its own literal, not knob-driven
         (same convention as button/input/rating). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="A / Link (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <a href="https://www.zkoss.org" label="Default Link"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="A / Link (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-a-fg:#6750a4">
        <a href="https://www.zkoss.org" label="Scoped Link"/>
    </div>

    <!-- Timepicker (EE, zkmax): outlined time field + time-list popup. Same
         wrapper-border knob vocabulary as datebox/timebox/spinner/bandbox
         (bg/fg/radius, per-state border color, plus a popup-bg/popup-radius
         pair); the clock-trigger button's radius reuses the same radius knob.
         Invalid state stays on the color-error token, not knob-driven (same
         convention as datebox/timebox). readonly="false" works around
         ZK-6122 (a bare <timepicker/> renders readonly=true on the client). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Timepicker (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <timepicker format="HH:mm" readonly="false"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Timepicker (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-timepicker-radius:0px; --zk-timepicker-border-color:#6750a4">
        <timepicker format="HH:mm" readonly="false"/>
    </div>

    <!-- Chosenbox (EE, zkmax): multi-select input field + option popup. Same
         wrapper-border knob vocabulary as datebox/timebox/spinner/bandbox/
         daterangebox/timepicker (bg/fg/radius, per-state border color, plus a
         popup-bg/popup-radius pair); zk-chosenbox-fg covers both the search
         input's text and each chip's text (same value today). Selected chips
         get their own resting/defining-state fill pair: zk-chosenbox-item-bg
         is the resting fill, zk-chosenbox-item-focus-bg is the fill a chip
         swaps to once clicked (armed for keyboard delete) — the defining
         state, same "one knob per state" precedent as listbox/tree's
         selected-bg. A pre-selected model gives two chips to theme. -->
    <zscript>
        org.zkoss.zul.ListModelList chosenboxThemingModel =
            new org.zkoss.zul.ListModelList(new String[]{"Apple", "Banana", "Cherry"});
        chosenboxThemingModel.setMultiple(true);
        chosenboxThemingModel.addToSelection(chosenboxThemingModel.get(0));
        chosenboxThemingModel.addToSelection(chosenboxThemingModel.get(1));
    </zscript>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Chosenbox (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <chosenbox model="${chosenboxThemingModel}" width="220px"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Chosenbox (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-chosenbox-radius:0px; --zk-chosenbox-border-color:#6750a4;
                --zk-chosenbox-item-bg:#efe6ff; --zk-chosenbox-item-focus-bg:#6750a4">
        <chosenbox model="${chosenboxThemingModel}" width="220px"/>
    </div>

    <!-- Cascader (EE, zkmax): read-only trigger + right-expanding tree popup.
         Same wrapper-border knob vocabulary as datebox/timebox/spinner/
         bandbox/daterangebox/timepicker/chosenbox (bg/fg/radius, per-state
         border color, plus a popup-bg/popup-radius pair); zk-cascader-fg
         covers both the trigger's selected-path label text and each popup
         item's text (same value today). zk-cascader-accent is the defining
         state: the selected item's text color inside the popup. A
         pre-selected model gives the trigger a visible label to theme. -->
    <zscript>
        org.zkoss.zul.DefaultTreeNode cascaderThemingLeaf = new org.zkoss.zul.DefaultTreeNode("Kyoto");
        org.zkoss.zul.DefaultTreeModel cascaderThemingModel = new org.zkoss.zul.DefaultTreeModel(
            new org.zkoss.zul.DefaultTreeNode("ROOT", java.util.Arrays.asList(new org.zkoss.zul.TreeNode[]{
                new org.zkoss.zul.DefaultTreeNode("Japan", java.util.Arrays.asList(new org.zkoss.zul.TreeNode[]{
                    new org.zkoss.zul.DefaultTreeNode("Tokyo"), cascaderThemingLeaf}))
            })));
        cascaderThemingModel.addToSelection(cascaderThemingLeaf);
    </zscript>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Cascader (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <cascader model="${cascaderThemingModel}" width="200px"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Cascader (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-cascader-radius:0px; --zk-cascader-border-color:#6750a4; --zk-cascader-fg:#6750a4">
        <cascader model="${cascaderThemingModel}" width="200px"/>
    </div>

    <!-- Searchbox (EE, zkmax): multi-select dropdown trigger + detached search
         popup. Same wrapper-border knob vocabulary as datebox/timebox/spinner/
         bandbox/daterangebox/timepicker/chosenbox/cascader (bg/fg/radius,
         per-state border color, plus a popup-bg/popup-radius pair);
         zk-searchbox-fg covers the trigger's selected-label text, the popup's
         own text, the search input's text, and each item's text (same value
         today). The selected item is the defining state:
         zk-searchbox-selected-bg / -fg (the LIST-ROW family, NOT the chip
         family — see doc/contracts/searchbox.md). A pre-selected model gives
         the trigger a visible label to theme. -->
    <zscript>
        org.zkoss.zul.ListModelList searchboxThemingModel =
            new org.zkoss.zul.ListModelList(new String[]{"Apple", "Banana", "Cherry"});
        searchboxThemingModel.addToSelection(searchboxThemingModel.get(0));
    </zscript>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Searchbox (default)"/></div>
    <div sclass="z-hstack z-mb-6 z-items-center">
        <searchbox model="${searchboxThemingModel}" width="200px"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Searchbox (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-searchbox-radius:0px; --zk-searchbox-border-color:#6750a4; --zk-searchbox-fg:#6750a4">
        <searchbox model="${searchboxThemingModel}" width="200px"/>
    </div>

    <!-- Drawer (EE, zkmax): sliding side-sheet panel + header + close button.
         Knobs cover the panel fill, its static elevation (every position gets
         the same shadow, unlike window's mode-driven elevation), the header's
         divider color and text color, and the close button's hover fill.
         Drawer.prototype.setVisible() reparents the ENTIRE .z-drawer root to
         the floating root (document.body) on open() and moves it back on
         close() (confirmed empirically: an open drawer's parentElement is
         BODY, not its authored ZUL ancestor), so a regional (container)
         override cannot reach it while open — same "not regionally
         demonstrable" class as messagebox/popup, a different root cause each
         time. Only the whole-app :root override applies (see the tracker). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Drawer (default)"/></div>
    <div sclass="z-hstack z-mb-8">
        <button label="Open Drawer" onClick="drawerTheming.open()"/>
        <drawer id="drawerTheming" title="Component Theming Demo" closable="true">
            <div sclass="z-p-2">Default drawer, zero override applied.</div>
        </drawer>
    </div>

    <!-- Nav (EE, zkmax): navbar container + collapsible nav group + leaf
         navitem sidebar navigation. zk-navitem-fg / -radius are shared by
         BOTH the group header link (.z-nav-content) and the leaf item link
         (.z-navitem-content, same value today). The selected leaf item is
         the defining state: a rounded tonal pill, zk-navitem-selected-bg /
         -fg (no left-edge accent bar — see doc/contracts/navbar.md c7). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Nav (default)"/></div>
    <div sclass="z-mb-6">
        <navbar orient="vertical" width="200px">
            <navitem label="Home" iconSclass="z-icon-home"/>
            <navitem label="Dashboard" iconSclass="z-icon-gauge" selected="true"/>
            <navseparator/>
            <nav label="Settings" iconSclass="z-icon-cog">
                <navitem label="Profile"/>
                <navitem label="Security"/>
            </nav>
        </navbar>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Nav (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-navbar-bg:#efe6ff; --zk-navitem-radius:0px; --zk-navitem-selected-bg:#6750a4; --zk-navitem-selected-fg:#ffffff">
        <navbar orient="vertical" width="200px">
            <navitem label="Home" iconSclass="z-icon-home"/>
            <navitem label="Dashboard" iconSclass="z-icon-gauge" selected="true"/>
            <navseparator/>
            <nav label="Settings" iconSclass="z-icon-cog">
                <navitem label="Profile"/>
                <navitem label="Security"/>
            </nav>
        </navbar>
    </div>

    <!-- Anchornav (EE, zkmax): anchor-link navigation list built on a plain
         listbox. zk-anchornav-accent is a single defining-state knob that
         colors BOTH the active item's left border indicator and the item's
         own link text (both read the primary color token today, the same
         "one knob, several roles" precedent as tab/calendar/nav's accent);
         zk-anchornav-fg is the resting (non-active) item link's text color.
         The indicator's border-left WIDTH (3px) stays hardcoded (same
         convention as tab's border-bottom-color knob). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Anchornav (default)"/></div>
    <div sclass="z-mb-6">
        <anchornav>
            <listbox sizedByContent="true" hflex="min">
                <listitem><listcell><a>Overview</a></listcell></listitem>
                <listitem selected="true"><listcell><a>Details</a></listcell></listitem>
                <listitem><listcell><a>Summary</a></listcell></listitem>
            </listbox>
        </anchornav>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Anchornav (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-anchornav-fg:#6750a4; --zk-anchornav-accent:#6750a4">
        <anchornav>
            <listbox sizedByContent="true" hflex="min">
                <listitem><listcell><a>Overview</a></listcell></listitem>
                <listitem selected="true"><listcell><a>Details</a></listcell></listitem>
                <listitem><listcell><a>Summary</a></listcell></listitem>
            </listbox>
        </anchornav>
    </div>

    <!-- Stepbar (EE, zkmax): connected-circle step-progress indicator.
         activeIndex=1 with 3 steps exercises all three states at once: the
         first step is complete, the second is active, the third is
         upcoming. zk-stepbar-accent is a single defining-state knob that
         colors the active/complete icon fill + border AND the lit connector
         leading into them, paired with zk-stepbar-accent-fg for the glyph
         inside that filled circle (same "one knob, several roles"
         precedent as tab/calendar/nav's accent). zk-stepbar-connector-color
         is the resting (upcoming) connector line; zk-stepbar-icon-border-color
         is the upcoming icon's ring color. zk-stepbar-fg is the resting AND
         complete title text; zk-stepbar-fg-active is the active title text.
         Error state stays on zk-color-error, not knob-driven. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Stepbar (default)"/></div>
    <div sclass="z-mb-6">
        <stepbar activeIndex="1" width="480px">
            <step title="First Step"/>
            <step title="Second Step"/>
            <step title="Third Step"/>
        </stepbar>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Stepbar (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-stepbar-connector-color:#6750a4; --zk-stepbar-icon-border-color:#6750a4; --zk-stepbar-fg:#6750a4; --zk-stepbar-fg-active:#6750a4; --zk-stepbar-accent:#6750a4; --zk-stepbar-accent-fg:#1a1a1a">
        <stepbar activeIndex="1" width="480px">
            <step title="First Step"/>
            <step title="Second Step"/>
            <step title="Third Step"/>
        </stepbar>
    </div>

    <!-- Coachmark (EE, zkmax): guided-tour rich-tooltip card pointing at a
         target element. Knobs cover the card fill (shared by the pointer-
         triangle border-color, so the triangle always reads as an extension
         of the card), text, radius, and elevation. Coachmark's _open() calls
         zk.makeVParent() on the root .z-coachmark node, reparenting the
         ENTIRE root (content + pointer + close button) to the floating root
         (document.body) while visible, and undoVParent() restores it on
         close() (confirmed in the compiled zkmax widget bundle) — so, like
         drawer, a regional (container) override cannot reach it; only the
         whole-app :root override applies (see the tracker). The close
         button's icon color and hover overlay stay on base tokens, not
         knob-driven. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Coachmark (default)"/></div>
    <div sclass="z-hstack z-mb-8 z-items-center">
        <button id="coachmarkTarget" label="Target Button"/>
        <button label="Show Coachmark" onClick="coachmarkTheming.open()"/>
        <coachmark id="coachmarkTheming" visible="false" target="coachmarkTarget" position="after_center">
            Default coachmark, zero override applied.
        </coachmark>
    </div>

    <!-- Colorbox (PE, zkex): color-picker swatch trigger + gradient/palette
         popup. No focus/open border state exists on .z-colorbox (only resting
         + hover), so there is no border-color-focus knob; there is also no
         fg/text knob — the root shows only the swatch (colored inline per
         selection) and a caret icon, no visible text. The popup reuses the
         bg/radius pair convention from the other dropdown-input family
         members' popups (border-color/box-shadow stay on base tokens). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Colorbox (default)"/></div>
    <div sclass="z-hstack z-mb-6">
        <colorbox color="#184dc6"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Colorbox (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-colorbox-radius:0px; --zk-colorbox-border-color:#6750a4; --zk-colorbox-border-color-hover:#6750a4">
        <colorbox color="#184dc6"/>
    </div>

    <!-- Biglistbox (EE, zkmax): virtual/lazy-loading data table. Same curated
         surface as Grid (no stripe/foot rows in this component): a single
         border-color knob is shared by the wrapper's own border, the
         header's border-bottom, and each row's border-bottom; row-hover
         keeps its stock rgba literal (zero regression, same as
         zk-grid-row-hover-bg). The sort-icon color, the sort-hover tint, and
         the custom WScroll scrollbar colors stay on base tokens, not
         knob-driven (same convention as grid's column-sort-icon). -->
    <zscript>
        import zk.example.FakerMatrixModel;
        FakerMatrixModel biglistboxThemingModel = new FakerMatrixModel(2, 3);
        FakerMatrixModel biglistboxThemingScopedModel = new FakerMatrixModel(2, 3);
    </zscript>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Biglistbox (default)"/></div>
    <div sclass="z-mb-6">
        <biglistbox model="${biglistboxThemingModel}" width="300px" height="140px" colWidth="140px">
            <template name="heads">
                <html><![CDATA[<div>${each[matrixInfo[0]]}</div>]]></html>
            </template>
            <template name="rows">
                <html><![CDATA[<div>${each[matrixInfo[0]]}</div>]]></html>
            </template>
        </biglistbox>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Biglistbox (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-biglistbox-radius:0px; --zk-biglistbox-border-color:#6750a4; --zk-biglistbox-header-fg:#6750a4">
        <biglistbox model="${biglistboxThemingScopedModel}" width="300px" height="140px" colWidth="140px">
            <template name="heads">
                <html><![CDATA[<div>${each[matrixInfo[0]]}</div>]]></html>
            </template>
            <template name="rows">
                <html><![CDATA[<div>${each[matrixInfo[0]]}</div>]]></html>
            </template>
        </biglistbox>
    </div>

    <!-- Fisheye / Fisheyebar (PE, zkex): magnetic dock icon bar. Magnification
         is JS-driven (mousemove sets inline width/height), so there is no
         hover/selected color state to expose. The knob surface is just the
         item label text and the icon's corner radius; the bar's own
         background stays transparent by design (a floating dock overlay, not
         a card), not knob-driven. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Fisheye (default)"/></div>
    <div sclass="z-hstack z-mb-6">
        <fisheyebar attachEdge="bottom" itemWidth="48" itemHeight="48" itemMaxHeight="96" itemMaxWidth="96">
            <fisheye image="~./img/Centigrade-Widget-Icons/FolderABlue-128x128.png" label="Folder"/>
            <fisheye image="~./img/Centigrade-Widget-Icons/ReadingGlass-128x128.png" label="Search"/>
            <fisheye image="~./img/Centigrade-Widget-Icons/MailboxFlag-128x128.png" label="Mail"/>
        </fisheyebar>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Fisheye (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-fisheye-fg:#6750a4; --zk-fisheye-radius:0px">
        <fisheyebar attachEdge="bottom" itemWidth="48" itemHeight="48" itemMaxHeight="96" itemMaxWidth="96">
            <fisheye image="~./img/Centigrade-Widget-Icons/FolderABlue-128x128.png" label="Folder"/>
            <fisheye image="~./img/Centigrade-Widget-Icons/ReadingGlass-128x128.png" label="Search"/>
            <fisheye image="~./img/Centigrade-Widget-Icons/MailboxFlag-128x128.png" label="Mail"/>
        </fisheyebar>
    </div>

    <!-- Pdfviewer (PE, zkex): PDF document viewer — root wrapper + scrollable
         canvas area + a floating, bottom-centred toolbar (pill-shaped, icon
         buttons). The border-color knob is shared by BOTH the root
         wrapper's own border AND the toolbar separator's border-left (one
         knob, several roles, same precedent as toolbar/messagebox's shared
         border-color knob). The canvas area and floating toolbar are
         separate surfaces with their own bg/radius knobs; the per-page and
         toolbar box-shadows stay on base tokens, not knob-driven (same
         convention as the wrapper-border family's popup shadows). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Pdfviewer (default)"/></div>
    <div sclass="z-mb-6">
        <pdfviewer src="~./link-annotation.pdf" width="320px" height="200px"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Pdfviewer (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-pdfviewer-radius:0px; --zk-pdfviewer-border-color:#6750a4; --zk-pdfviewer-toolbar-bg:#6750a4; --zk-pdfviewer-toolbar-fg:#ffffff">
        <pdfviewer src="~./link-annotation.pdf" width="320px" height="200px"/>
    </div>

    <!-- Tbeditor (EE, zkmax): MD3 outlined rich-text editor — .z-tbeditor-box
         wrapper (border-color/radius/elevation + focus-within outline) + the
         toolbar pane's own tonal fill + the editor canvas (bg/fg, shared with
         the source textarea and the formatting/link dropdown's text — one
         knob, several roles). The toggled-button accent (active-bg, the
         defining state) and the dropdown popup's own bg/radius are also
         knob-driven but not demonstrable via static markup (no pre-toggled
         button, no open popup), same convention as the wrapper-border
         family's popup knobs. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Tbeditor (default)"/></div>
    <div sclass="z-mb-6">
        <tbeditor width="100%"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Tbeditor (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-tbeditor-radius:0px; --zk-tbeditor-border-color:#6750a4; --zk-tbeditor-toolbar-bg:#6750a4">
        <tbeditor width="100%"/>
    </div>

    <!-- Signature (EE, zkmax): signature-pad canvas field — .z-signature root
         wrapper (canvas + a floating toolbar of icon-only tool buttons). The
         wrapper's only border states are resting + focus-within (no hover),
         so there is no border-color-hover knob; there is also no fg/text
         knob — the root shows no text, only the canvas and the toolbar's
         icon-only buttons, which stay on base tokens (not knob-driven). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Signature (default)"/></div>
    <div sclass="z-mb-6">
        <signature width="200px" height="120px"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Signature (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-signature-radius:0px; --zk-signature-border-color:#6750a4">
        <signature width="200px" height="120px"/>
    </div>

    <!-- Cropper (EE, zkmax): image-crop field — .z-cropper root wrapper
         (border-color/radius only; no bg knob, since the root paints no fill
         of its own, it just wraps the opaque image) + a floating, pill-shaped
         toolbar with two text action links (Crop / Cancel). The toolbar is
         the component's one filled surface, so it gets its own bg/radius
         pair; the Cancel link reads the resting/neutral zk-cropper-fg, the
         Crop (confirming) link reads the defining zk-cropper-accent — a
         rating-style resting/accent pair. An initial selection (x/y/w/h) is
         seeded so the toolbar actually renders for the demo. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Cropper (default)"/></div>
    <div sclass="z-mb-6">
        <cropper src="~./img/sun.jpg" width="200px" x="20" y="20" w="80" h="80" toolbarVisible="true"/>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Cropper (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-cropper-radius:0px; --zk-cropper-border-color:#6750a4; --zk-cropper-toolbar-bg:#6750a4; --zk-cropper-accent:#ffffff; --zk-cropper-fg:#ffffff">
        <cropper src="~./img/sun.jpg" width="200px" x="20" y="20" w="80" h="80" toolbarVisible="true"/>
    </div>

    <!-- Dropupload (EE, zkmax): HTML5 drag-and-drop file-upload drop zone —
         .z-dropupload root is the ONLY themeable surface (border-color/
         radius/background only; border-width/style stay literal, same
         convention as every other family). ZK emits no drag-over or
         disabled state class (see .claude/skills/zk-component-rules/
         components/dropupload.md), so there is no hover/focus/disabled
         knob to expose, and no fg/text knob — the content attribute is
         arbitrary author HTML, never restyled by the component.
         detection="none" keeps the box always visible for the demo. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Dropupload (default)"/></div>
    <div sclass="z-mb-6">
        <dropupload detection="none">
            <attribute name="content"><![CDATA[
                <b>Drop Here</b>
            ]]></attribute>
        </dropupload>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Dropupload (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-dropupload-radius:0px; --zk-dropupload-border-color:#6750a4; --zk-dropupload-bg:#6750a4">
        <dropupload detection="none">
            <attribute name="content"><![CDATA[
                <b>Drop Here</b>
            ]]></attribute>
        </dropupload>
    </div>

    <!-- Organigram (EE, zkmax): org-chart tree — .z-orgnode card (bg/fg/
         radius/border-color) + hover (-hover-bg/-border-color-hover) + the
         connector lines (bus + drop-down/drop-out segments, sharing the same
         -border-color knob as the card's resting border, one knob several
         roles) + the expand/collapse icon (-icon-fg). Selected is the
         defining state — its own bg/border/fg triad (-selected-bg/-border-
         color/-fg); the selected node's icon reads the same -selected-fg.
         A pre-selected leaf node is seeded so the selected-state knobs are
         actually exercised by the demo. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Organigram (default)"/></div>
    <div sclass="z-mb-6">
        <organigram>
            <orgchildren>
                <orgitem label="CEO">
                    <orgchildren>
                        <orgitem label="Selected" selected="true"/>
                        <orgitem label="VP"/>
                    </orgchildren>
                </orgitem>
            </orgchildren>
        </organigram>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Organigram (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-organigram-radius:0px; --zk-organigram-border-color:#6750a4; --zk-organigram-selected-bg:#6750a4; --zk-organigram-selected-fg:#ffffff">
        <organigram>
            <orgchildren>
                <orgitem label="CEO">
                    <orgchildren>
                        <orgitem label="Selected" selected="true"/>
                        <orgitem label="VP"/>
                    </orgchildren>
                </orgitem>
            </orgchildren>
        </organigram>
    </div>

    <!-- Goldenlayout (EE, zkmax): dockable tab layout — .lm_header tab strip
         (-header-bg fill + shared -border-color bottom divider) + .lm_tab
         (resting -fg, hover -fg-hover, active label/underline/state-layer
         -accent) + .z-goldenpanel content card (-panel-bg fill + the same
         shared -border-color + shared -radius as the header's top corners).
         Two panels share one area so GL stacks them as tabs, seeding an
         active tab (first-added) that exercises the -accent knob. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Goldenlayout (default)"/></div>
    <div sclass="z-mb-6">
        <goldenlayout hflex="1" height="200px">
            <attribute name="areas">
                A
            </attribute>
            <goldenpanel area="A" title="Project">Project panel</goldenpanel>
            <goldenpanel area="A" title="Files">Files panel</goldenpanel>
        </goldenlayout>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Goldenlayout (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-goldenlayout-radius:0px; --zk-goldenlayout-border-color:#6750a4; --zk-goldenlayout-header-bg:#6750a4; --zk-goldenlayout-accent:#6750a4">
        <goldenlayout hflex="1" height="200px">
            <attribute name="areas">
                A
            </attribute>
            <goldenpanel area="A" title="Project">Project panel</goldenpanel>
            <goldenpanel area="A" title="Files">Files panel</goldenpanel>
        </goldenlayout>
    </div>

    <!-- Portallayout (EE, zkmax): transparent drag-drop dashboard shell — the
         framed column (title="" attribute) is the component's only card
         surface: -bg/-border-color/-radius style the frame, -fg styles the
         title text. counterVisible="true" shows the panel-count badge,
         styled by its own -counter-bg/-fg/-radius triad. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Portallayout (default)"/></div>
    <div sclass="z-mb-6">
        <portallayout hflex="1" height="180px">
            <portalchildren width="100%" title="Widgets" counterVisible="true">
                <panel height="60px" title="Tasks" border="normal">
                    <panelchildren>Pending tasks</panelchildren>
                </panel>
                <panel height="60px" title="Notes" border="normal">
                    <panelchildren>Quick notes</panelchildren>
                </panel>
            </portalchildren>
        </portallayout>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Portallayout (regional override)"/></div>
    <div sclass="z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-portallayout-radius:0px; --zk-portallayout-border-color:#6750a4; --zk-portallayout-counter-bg:#6750a4; --zk-portallayout-counter-fg:#ffffff">
        <portallayout hflex="1" height="180px">
            <portalchildren width="100%" title="Widgets" counterVisible="true">
                <panel height="60px" title="Tasks" border="normal">
                    <panelchildren>Pending tasks</panelchildren>
                </panel>
                <panel height="60px" title="Notes" border="normal">
                    <panelchildren>Quick notes</panelchildren>
                </panel>
            </portalchildren>
        </portallayout>
    </div>

    <!-- Confirmpopup (native, CE, zul/wgt/css/confirmpopup.css): lightweight anchored
         confirmation popover (Popover analog, not a modal dialog). Knobs cover the
         card fill/text/border/radius/elevation (zk-confirmpopup-bg/-fg/-header-fg/
         -border-color/-radius/-elevation), plus the footer's OK (filled) / Cancel
         (outlined) actions, which are plain native button elements rather than
         .z-button widgets, so they read their own knobs (zk-confirmpopup-button-radius,
         shared by both; zk-confirmpopup-ok-bg/-ok-fg; zk-confirmpopup-cancel-fg/
         -cancel-border-color) instead of the button family's. Confirmpopup extends
         Popup and its open() calls super.open(), inheriting Popup's own
         zk.makeVParent() reparenting to document.body on open — the identical root
         cause as zk-popup-*, its closest sibling — so, like messagebox/popup/coachmark,
         a regional (container) override cannot reach it; only the whole-app :root
         override applies (see the tracker). Severity recolors only the icon
         (identical mapping to chip/badge) and stays on its own semantic tokens,
         intentionally not knob-driven (same convention as messagebox's icon-type
         colors). -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Confirmpopup (default)"/></div>
    <div sclass="z-hstack z-mb-8">
        <button label="Show Confirmpopup" popup="confirmpopupThemingDefault"/>
        <confirmpopup id="confirmpopupThemingDefault" severity="warning" title="Confirm"
                      message="Default confirmpopup, zero override applied."/>
    </div>

    <!-- Breadcrumb (native, CE, zul/wgt/css/breadcrumb.css): plain inline nav trail,
         no card surface (borderless text chrome, same curation choice as `a`/
         `caption`) so there is no bg/border/radius knob. The zk-breadcrumb-fg knob covers
         the separator + ellipsis button (resting) + link item (resting); the
         zk-breadcrumb-fg-hover knob covers link-hover/focus + ellipsis-hover/focus; the
         zk-breadcrumb-current-fg knob is the one defining-state knob (the terminal
         "you are here" item). Renders in place (no client-side reparenting), so
         region scoping works normally. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Breadcrumb (default)"/></div>
    <div sclass="z-hstack z-mb-6">
        <breadcrumb>
            <breadcrumbitem label="Home" href="/"/>
            <breadcrumbitem label="Products" href="/products"/>
            <breadcrumbitem label="Current Page"/>
        </breadcrumb>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Breadcrumb (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-breadcrumb-fg:#6750a4; --zk-breadcrumb-fg-hover:#6750a4; --zk-breadcrumb-current-fg:#6750a4">
        <breadcrumb>
            <breadcrumbitem label="Home" href="/"/>
            <breadcrumbitem label="Products" href="/products"/>
            <breadcrumbitem label="Current Page"/>
        </breadcrumb>
    </div>

    <!-- Carousel (native, CE, zul/wgt/css/carousel.css): full-bleed slideshow frame
         with overlay arrows/indicators/caption atop arbitrary slide content; see
         doc/contracts/carousel.md Design Contract. Because the slide content is
         arbitrary imagery, none of the overlay chrome keys off surface/on-surface
         tokens; the eight knobs instead cover the arrow/indicator/label regions'
         dark voice (the scrim token) plus light voice (the inverse-on-surface
         token) pairing, plus a shared radius knob for the root frame and caption
         chip. Renders in place (no client-side reparenting), so region scoping
         works normally. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Carousel (default)"/></div>
    <div sclass="z-mb-6">
        <carousel width="240px" height="140px">
            <carouselitem label="Slide 1">
                <div sclass="z-w-100 z-h-100 z-bg-primary-container"/>
            </carouselitem>
            <carouselitem>
                <div sclass="z-w-100 z-h-100 z-bg-secondary-container"/>
            </carouselitem>
        </carousel>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Carousel (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-carousel-arrow-bg:#6750a4; --zk-carousel-indicator-active-bg:#6750a4">
        <carousel width="240px" height="140px">
            <carouselitem label="Slide 1">
                <div sclass="z-w-100 z-h-100 z-bg-primary-container"/>
            </carouselitem>
            <carouselitem>
                <div sclass="z-w-100 z-h-100 z-bg-secondary-container"/>
            </carouselitem>
        </carousel>
    </div>

    <!-- Codeeditor (native, CE @since ZK 11.0.0, zul/code/css/codeeditor.css): the
         outlined-text-field chrome wrapped around a CodeMirror 6 viewport; see
         doc/contracts/codeeditor.md. Fifteen knobs in two families — Marble's own
         light chrome (-bg/-fg/-radius/-border-color[-hover|-focus] + the gutter
         triad + the dark focus ring), and four keeping ZK core's authored spelling
         for the dark surface (-background/-color/-gutter-color). The probe below
         uses -bg and -border-color rather than the focus ring, so no interaction is
         needed to read the override. Renders in place (no client-side reparenting),
         so region scoping works normally. -->
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Codeeditor (default)"/></div>
    <div sclass="z-mb-6">
        <codeeditor language="java" width="240px" height="90px">
            <attribute name="value"><![CDATA[int a = 1;]]></attribute>
        </codeeditor>
    </div>
    <div sclass="z-text-uppercase z-mb-3"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Codeeditor (regional override)"/></div>
    <div sclass="z-hstack z-mb-8 z-p-4 z-bg-surface-variant z-rounded"
         style="--zk-codeeditor-bg:#6750a4; --zk-codeeditor-border-color:#6750a4; --zk-codeeditor-gutter-bg:#6750a4">
        <codeeditor language="java" width="240px" height="90px">
            <attribute name="value"><![CDATA[int a = 1;]]></attribute>
        </codeeditor>
    </div>
</div>
</zk>
