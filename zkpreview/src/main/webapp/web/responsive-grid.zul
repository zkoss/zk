<?page title="Responsive Grid" contentType="text/html;charset=UTF-8"?>
<zk>
<div sclass="z-p-8">
    <div>
        <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Responsive Grid (stacking)"/></div>

        <div sclass="z-py-3 z-mb-6"><label sclass="z-text-sm z-text-secondary" value="A grid with responsive=&quot;stacking&quot; reflows its table into a card-per-row layout when the grid's own width drops below a breakpoint (default 768px). Each row becomes a card; each cell becomes a labelled value. The check is against the grid's container width — not the viewport — so a grid in a narrow column or popup stacks too. (Stacking transformation ships in ZK EE / zkmax; ZK-5409.)"/></div>
    </div>

    <!-- 1. Basic stacking: a narrow grid always renders as cards -->
    <div sclass="z-mb-8">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Basic stacking (narrow container)"/></div>
        <div sclass="z-py-3 z-mb-3"><label sclass="z-text-sm z-text-secondary" value="Fixed at 460px — below the 768px default breakpoint, so it stacks to one card per row."/></div>
        <grid responsive="stacking" width="460px">
            <columns>
                <column label="Name"/>
                <column label="Email"/>
                <column label="Department"/>
            </columns>
            <rows>
                <row><label value="Alice Chen"/><label value="alice@example.com"/><label value="Engineering"/></row>
                <row><label value="Bob Diaz"/><label value="bob@example.com"/><label value="Design"/></row>
                <row><label value="Carol Wu"/><label value="carol@example.com"/><label value="Marketing"/></row>
            </rows>
        </grid>
    </div>

    <!-- 2. Live breakpoint: full-width grid switches when the window crosses 768px -->
    <div sclass="z-mb-8">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Live breakpoint (resize the window)"/></div>
        <div sclass="z-py-3 z-mb-3"><label sclass="z-text-sm z-text-secondary" value="Full width — renders as a normal table at ≥768px. Narrow the browser below 768px to watch it stack, and widen it again to restore the table."/></div>
        <grid responsive="stacking" width="100%">
            <columns>
                <column label="Author"/>
                <column label="Title"/>
                <column label="Publisher"/>
                <column label="Pages"/>
            </columns>
            <rows>
                <row><label value="Philip Hensher"/><label value="The Northern Clemency"/><label value="Knopf"/><label value="608"/></row>
                <row><label value="Michael Greenberg"/><label value="Hurry Down Sunshine"/><label value="Other Press"/><label value="240"/></row>
                <row><label value="Rick Perlstein"/><label value="Nixonland"/><label value="Scribner"/><label value="896"/></row>
            </rows>
        </grid>
    </div>

    <!-- 3. responsiveColumns: multiple cards per row -->
    <div sclass="z-mb-8">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="responsiveColumns=&quot;sm-1 md-2 lg-none&quot;"/></div>
        <div sclass="z-py-3 z-mb-3"><label sclass="z-text-sm z-text-secondary" value="Bootstrap-style cascade: 1 card/row below 768px, 2 cards/row from 768–991px, normal table at ≥992px. Fixed at 820px here → 2 cards per row."/></div>
        <grid responsive="stacking" responsiveColumns="sm-1 md-2 lg-none" width="820px">
            <columns>
                <column label="Product"/>
                <column label="SKU"/>
                <column label="Price"/>
            </columns>
            <rows>
                <row><label value="Wireless Mouse"/><label value="WM-100"/><label value="$24.99"/></row>
                <row><label value="Mechanical Keyboard"/><label value="MK-220"/><label value="$89.00"/></row>
                <row><label value="USB-C Hub"/><label value="UH-7"/><label value="$39.50"/></row>
                <row><label value="Laptop Stand"/><label value="LS-3"/><label value="$32.00"/></row>
            </rows>
        </grid>
    </div>

    <!-- 4. responsiveVisible: hide a column from cards -->
    <div sclass="z-mb-8">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Per-column hide (responsiveVisible=&quot;false&quot;)"/></div>
        <div sclass="z-py-3 z-mb-3"><label sclass="z-text-sm z-text-secondary" value="The &quot;Internal ID&quot; column is visible in table mode but omitted from each card in stacking mode — useful for technical/debug columns that are noise on mobile."/></div>
        <grid responsive="stacking" width="460px">
            <columns>
                <column label="Name"/>
                <column label="Email"/>
                <column label="Internal ID" responsiveVisible="false"/>
            </columns>
            <rows>
                <row><label value="Alice Chen"/><label value="alice@example.com"/><label value="EMP-000241"/></row>
                <row><label value="Bob Diaz"/><label value="bob@example.com"/><label value="EMP-000318"/></row>
            </rows>
        </grid>
    </div>

    <!-- 5. Paging + footer compatibility -->
    <div sclass="z-mb-8">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Paging + footer"/></div>
        <div sclass="z-py-3 z-mb-3"><label sclass="z-text-sm z-text-secondary" value="mold=&quot;paging&quot; and the &lt;foot&gt; both work in stacking mode: the footer renders as a full-width card below the row grid."/></div>
        <grid responsive="stacking" mold="paging" pageSize="3" width="460px">
            <columns>
                <column label="Order"/>
                <column label="Customer"/>
                <column label="Amount"/>
            </columns>
            <rows>
                <row><label value="#1001"/><label value="Alice Chen"/><label value="$120.00"/></row>
                <row><label value="#1002"/><label value="Bob Diaz"/><label value="$54.00"/></row>
                <row><label value="#1003"/><label value="Carol Wu"/><label value="$233.50"/></row>
                <row><label value="#1004"/><label value="Dan Park"/><label value="$18.75"/></row>
                <row><label value="#1005"/><label value="Eve Lin"/><label value="$402.10"/></row>
            </rows>
            <foot>
                <footer label="Total"/>
                <footer label=""/>
                <footer label="$828.35"/>
            </foot>
        </grid>
    </div>
</div>
</zk>
