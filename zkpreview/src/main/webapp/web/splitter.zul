<?page title="Splitter" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">Splitter</h:span></h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Default Mold</h:span></h:div>
        <h:div class="z-py-3">
            <hbox spacing="0" height="300px" style="border: 1px solid rgba(0, 0, 0, 0.15)">
                <vbox spacing="0" width="100%" height="100%">
                    Vbox Top
                    <splitter collapse="before"/>
                    Vbox Bottom
                </vbox>
                <splitter collapse="before"/>
                Hbox Right
            </hbox>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">OS Mold — Collapse None</h:span></h:div>
        <h:div class="z-py-3">
            <hbox spacing="0" height="300px" style="border: 1px solid rgba(0, 0, 0, 0.15)">
                <vbox spacing="0" width="100%" height="100%">
                    Vbox Top
                    <splitter mold="os" collapse="none"/>
                    Vbox Bottom
                </vbox>
                <splitter mold="os" collapse="none"/>
                Hbox Right
            </hbox>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">OS Mold — Collapse Before</h:span></h:div>
        <h:div class="z-py-3">
            <hbox spacing="0" height="300px" style="border: 1px solid rgba(0, 0, 0, 0.15)">
                <vbox spacing="0" width="100%" height="100%">
                    Vbox Top
                    <splitter mold="os" collapse="before"/>
                    Vbox Bottom
                </vbox>
                <splitter mold="os" collapse="before"/>
                Hbox Right
            </hbox>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Collapsed (open=false)</h:span></h:div>
        <h:div class="z-py-3">
            <hbox spacing="0" height="160px" style="border: 1px solid rgba(0, 0, 0, 0.15)">
                Hbox Left
                <splitter collapse="before" open="false"/>
                Hbox Right
            </hbox>
        </h:div>
    </h:div>
</h:div>
</zk>
