<?page title="Mesh header and footer" contentType="text/html;charset=UTF-8"?>
<!-- Fixture for mesh-header-footer.spec.ts: Grid, Listbox and Tree with a narrow ascending-sorted
     "Department" column (96px, the label does not fit), a footer row, and a Grid/Listbox variant
     whose columns carry a column-menu button, the same sorted column with an image (Grid, Listbox, Tree),
     Trees whose headers hold images, an icon and the select-all box, and Listboxes with a plain, a labelled
     select-all and a centred select-all header for the tablet guard, and a Tree/Grid pair with the same labels
     for the header height guard. Lives under pv/ so
     gallery-scan, forced-colors-gallery and font-size-equivalence do not pick it up as a page. -->
<zk>
<div sclass="z-p-8">
    <grid sclass="mhf-grid" width="360px">
        <columns>
            <column label="Name" width="120px"/>
            <column label="Department" width="96px" sort="auto" sortDirection="ascending"/>
            <column label="Salary" width="120px"/>
        </columns>
        <rows>
            <row><label value="Alice"/><label value="Engineering"/><label value="100"/></row>
            <row><label value="Bob"/><label value="Sales"/><label value="90"/></row>
        </rows>
        <foot>
            <footer label="Total"/><footer label="2"/><footer label="190"/>
        </foot>
    </grid>
    <grid sclass="mhf-grid-menu" width="360px">
        <columns menupopup="auto">
            <column label="Name" width="120px"/>
            <column label="Department" width="96px" sort="auto" sortDirection="ascending"/>
            <column label="Salary" width="120px"/>
        </columns>
        <rows>
            <row><label value="Alice"/><label value="Engineering"/><label value="100"/></row>
        </rows>
    </grid>
    <listbox sclass="mhf-listbox" width="360px">
        <listhead>
            <listheader label="Name" width="120px"/>
            <listheader label="Department" width="96px" sort="auto" sortDirection="ascending"/>
            <listheader label="Salary" width="120px"/>
        </listhead>
        <listitem><listcell label="Alice"/><listcell label="Engineering"/><listcell label="100"/></listitem>
        <listitem><listcell label="Bob"/><listcell label="Sales"/><listcell label="90"/></listitem>
        <listfoot>
            <listfooter label="Total"/><listfooter label="2"/><listfooter label="190"/>
        </listfoot>
    </listbox>
    <listbox sclass="mhf-listbox-menu" width="360px">
        <listhead menupopup="auto">
            <listheader label="Name" width="120px"/>
            <listheader label="Department" width="96px" sort="auto" sortDirection="ascending"/>
            <listheader label="Salary" width="120px"/>
        </listhead>
        <listitem><listcell label="Alice"/><listcell label="Engineering"/><listcell label="100"/></listitem>
    </listbox>
    <tree sclass="mhf-tree" width="360px">
        <treecols>
            <treecol label="Name" width="120px"/>
            <treecol label="Department" width="96px" sort="auto" sortDirection="ascending"/>
            <treecol label="Salary" width="120px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell label="Alice"/><treecell label="Engineering"/><treecell label="100"/></treerow></treeitem>
            <treeitem><treerow><treecell label="Bob"/><treecell label="Sales"/><treecell label="90"/></treerow></treeitem>
        </treechildren>
        <treefoot>
            <treefooter label="Total"/><treefooter label="2"/><treefooter label="190"/>
        </treefoot>
    </tree>
    <grid sclass="mhf-grid-image" width="360px">
        <columns>
            <column label="Name" width="120px"/>
            <column label="Department" width="96px" sort="auto" sortDirection="ascending" image="/web/img/received.png"/>
            <column label="Salary" width="120px"/>
        </columns>
        <rows>
            <row><label value="Alice"/><label value="Engineering"/><label value="100"/></row>
        </rows>
    </grid>
    <grid sclass="mhf-grid-image-menu" width="360px">
        <columns menupopup="auto">
            <column label="Name" width="120px"/>
            <column label="Department" width="96px" sort="auto" sortDirection="ascending" image="/web/img/received.png"/>
            <column label="Salary" width="120px"/>
        </columns>
        <rows>
            <row><label value="Alice"/><label value="Engineering"/><label value="100"/></row>
        </rows>
    </grid>
    <listbox sclass="mhf-listbox-image" width="360px">
        <listhead>
            <listheader label="Name" width="120px"/>
            <listheader label="Department" width="96px" sort="auto" sortDirection="ascending" image="/web/img/received.png"/>
            <listheader label="Salary" width="120px"/>
        </listhead>
        <listitem><listcell label="Alice"/><listcell label="Engineering"/><listcell label="100"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-image-menu" width="360px">
        <listhead menupopup="auto">
            <listheader label="Name" width="120px"/>
            <listheader label="Department" width="96px" sort="auto" sortDirection="ascending" image="/web/img/received.png"/>
            <listheader label="Salary" width="120px"/>
        </listhead>
        <listitem><listcell label="Alice"/><listcell label="Engineering"/><listcell label="100"/></listitem>
    </listbox>
    <tree sclass="mhf-tree-image" width="360px">
        <treecols>
            <treecol label="Name" width="120px"/>
            <treecol label="Department" width="96px" sort="auto" sortDirection="ascending" image="/web/img/received.png"/>
            <treecol label="Salary" width="120px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell label="Alice"/><treecell label="Engineering"/><treecell label="100"/></treerow></treeitem>
        </treechildren>
    </tree>
    <!-- Header media next to a label: plain column first, then 16px, 24px and 30px images and an icon. -->
    <tree sclass="mhf-tree-media" width="560px">
        <treecols>
            <treecol label="Plain" width="100px"/>
            <treecol label="Img16" width="100px" image="/web/img/received.png"/>
            <treecol label="Img24" width="100px" image="/web/img/Centigrade-Widget-Icons/Listbox-24x24.png"/>
            <treecol label="Img30" width="100px" image="/web/img/inet.png"/>
            <treecol label="Icon" width="100px" iconSclass="z-icon-home"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell label="a"/><treecell label="b"/><treecell label="c"/><treecell label="d"/><treecell label="e"/></treerow></treeitem>
        </treechildren>
    </tree>
    <!-- The checkable (select-all) column. -->
    <tree sclass="mhf-tree-checkable" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol label="Name" width="120px"/>
            <treecol label="Department" width="120px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell label="Alice"/><treecell label="Engineering"/></treerow></treeitem>
        </treechildren>
    </tree>
    <!-- A select-all-only 40px header column: the box must not push an ellipsis into the header. -->
    <listbox sclass="mhf-listbox-checkable" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader width="40px"/>
            <listheader label="Name" width="160px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <!-- Select-all headers on the tablet guard: one carries a label, one is a centred box-only column.
         The first listbox is the plain-header reference for the header height. -->
    <listbox sclass="mhf-listbox-plain" width="360px">
        <listhead>
            <listheader label="Name" width="160px"/>
            <listheader label="Department" width="160px"/>
        </listhead>
        <listitem><listcell label="Alice"/><listcell label="Engineering"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-select-all-label" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader label="Name" width="160px"/>
            <listheader label="Department" width="160px"/>
        </listhead>
        <listitem><listcell label="Alice"/><listcell label="Engineering"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-select-all-centre" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader width="60px" align="center"/>
            <listheader label="Name" width="160px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <!-- A centred and a right-aligned first column of a checkmark Listbox (NS14 round 2, D18): the box of a row that holds
         only the checkmark stays under the header box, and an image or a component after the box keeps the position
         the compensation of the first cell gives it. The label and inline rows are measured by the report only. -->
    <listbox sclass="mhf-listbox-align-center" width="240px" checkmark="true" multiple="true">
        <listhead>
            <listheader width="160px" align="center"/>
            <listheader label="Type" width="60px"/>
        </listhead>
        <listitem sclass="mhf-box-row"><listcell/><listcell label="A"/></listitem>
        <listitem sclass="mhf-label-row"><listcell label="Label"/><listcell label="B"/></listitem>
        <listitem sclass="mhf-image-row"><listcell image="/web/img/received.png" label="Image"/><listcell label="C"/></listitem>
        <listitem sclass="mhf-inline-row"><listcell><label value="Label "/><a label="link"/></listcell><listcell label="D"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-align-right" width="240px" checkmark="true" multiple="true">
        <listhead>
            <listheader width="160px" align="right"/>
            <listheader label="Type" width="60px"/>
        </listhead>
        <listitem sclass="mhf-box-row"><listcell/><listcell label="A"/></listitem>
        <listitem sclass="mhf-label-row"><listcell label="Label"/><listcell label="B"/></listitem>
        <listitem sclass="mhf-image-row"><listcell image="/web/img/received.png" label="Image"/><listcell label="C"/></listitem>
        <listitem sclass="mhf-inline-row"><listcell><label value="Label "/><a label="link"/></listcell><listcell label="D"/></listitem>
    </listbox>
    <!-- A select-all-only 40px Tree header column (D15): the 16px box must not be clipped by the header padding. -->
    <tree sclass="mhf-tree-checkbox-only" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol width="40px"/>
            <treecol label="Name" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell/><treecell label="Alice"/></treerow></treeitem>
        </treechildren>
    </tree>
    <!-- A select-all Listbox header next to a Grid with the same labels (D16): the header rows must be as tall
         as each other and the select-all box must sit on the label centre. -->
    <listbox sclass="mhf-listbox-vs-grid" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader label="Name" width="160px"/>
            <listheader label="Type" width="160px"/>
        </listhead>
        <listitem><listcell label="Alice"/><listcell label="Engineering"/></listitem>
    </listbox>
    <grid sclass="mhf-grid-vs-listbox" width="360px">
        <columns>
            <column label="Name" width="160px"/>
            <column label="Type" width="160px"/>
        </columns>
        <rows>
            <row><label value="Alice"/><label value="Engineering"/></row>
        </rows>
    </grid>
    <!-- Other content in the first cell of a checkmark Listbox row (NS14, D18): the image, the label and the link are
         flex items with a 4px gap and the text stays on the keyline of the header label. -->
    <listbox sclass="mhf-listbox-first-cell" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader label="Name" width="160px"/>
            <listheader label="Type" width="160px"/>
        </listhead>
        <listitem sclass="mhf-text-row"><listcell label="Alice"/><listcell label="Engineering"/></listitem>
        <listitem sclass="mhf-image-row"><listcell image="/web/img/received.png" label="With image"/><listcell label="Engineering"/></listitem>
        <listitem sclass="mhf-inline-row"><listcell><label value="Alice "/><a label="link"/></listcell><listcell label="Engineering"/></listitem>
    </listbox>
    <grid sclass="mhf-grid-first-cell" width="360px">
        <columns>
            <column label="Name" width="160px"/>
            <column label="Type" width="160px"/>
        </columns>
        <rows>
            <row sclass="mhf-text-row"><label value="Alice"/><label value="Engineering"/></row>
            <row sclass="mhf-image-row"><label value="With image"/><label value="Engineering"/></row>
            <row sclass="mhf-inline-row"><label value="Alice link"/><label value="Engineering"/></row>
        </rows>
    </grid>
    <!-- A control in the first cell of a checkmark Listbox or Tree row: the row box stays centred on it, and the Listbox
         row is as tall as the Grid row below. -->
    <listbox sclass="mhf-listbox-control-row" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader label="Name" width="160px"/>
            <listheader label="Type" width="160px"/>
        </listhead>
        <listitem sclass="mhf-textbox-row"><listcell><textbox value="Alice"/></listcell><listcell label="Engineering"/></listitem>
        <listitem sclass="mhf-button-row"><listcell><button label="Go"/></listcell><listcell label="Engineering"/></listitem>
    </listbox>
    <grid sclass="mhf-grid-control-row" width="360px">
        <columns>
            <column label="Name" width="160px"/>
            <column label="Type" width="160px"/>
        </columns>
        <rows>
            <row sclass="mhf-textbox-row"><textbox value="Alice"/><label value="Engineering"/></row>
            <row sclass="mhf-button-row"><button label="Go"/><label value="Engineering"/></row>
        </rows>
    </grid>
    <tree sclass="mhf-tree-control-row" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol label="Name" width="160px"/>
            <treecol label="Type" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow sclass="mhf-textbox-row"><treecell><textbox value="Alice"/></treecell><treecell label="Engineering"/></treerow></treeitem>
            <treeitem><treerow sclass="mhf-button-row"><treecell><button label="Go"/></treecell><treecell label="Engineering"/></treerow></treeitem>
        </treechildren>
    </tree>
    <!-- Select-all headers that also hold the sort arrow, the column-menu button or both (D11 follow-through):
         the label box must stop short of each. -->
    <listbox sclass="mhf-listbox-select-all-sort" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader label="Department" width="120px" sort="auto" sortDirection="ascending"/>
            <listheader label="Name" width="200px"/>
        </listhead>
        <listitem><listcell label="Engineering"/><listcell label="Alice"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-select-all-menu" width="360px" checkmark="true" multiple="true">
        <listhead menupopup="auto">
            <listheader label="Department" width="120px"/>
            <listheader label="Name" width="200px"/>
        </listhead>
        <listitem><listcell label="Engineering"/><listcell label="Alice"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-select-all-sort-menu" width="360px" checkmark="true" multiple="true">
        <listhead menupopup="auto">
            <listheader label="Department" width="120px" sort="auto" sortDirection="ascending"/>
            <listheader label="Name" width="200px"/>
        </listhead>
        <listitem><listcell label="Engineering"/><listcell label="Alice"/></listitem>
    </listbox>
    <!-- A Tree next to a Grid with the same labels (D17): the header rows are as tall as each other in default,
         compact and tablet, and so are the data rows on a tablet. -->
    <tree sclass="mhf-tree-vs-grid" width="360px">
        <treecols>
            <treecol label="Name" width="160px"/>
            <treecol label="Type" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell label="Alice"/><treecell label="Engineering"/></treerow></treeitem>
        </treechildren>
    </tree>
    <grid sclass="mhf-grid-vs-tree" width="360px">
        <columns>
            <column label="Name" width="160px"/>
            <column label="Type" width="160px"/>
        </columns>
        <rows>
            <row><label value="Alice"/><label value="Engineering"/></row>
        </rows>
    </grid>
    <!-- Image-only header columns that carry the column-menu button, at the documented minimum widths (56px on
         desktop, 76px on a tablet; see data-components.md, "Narrow icon/image column"). -->
    <grid sclass="mhf-grid-icon-menu" width="360px">
        <columns menupopup="auto">
            <column width="56px" image="/web/img/received.png"/>
            <column width="76px" image="/web/img/received.png"/>
            <column label="Name" width="200px"/>
        </columns>
        <rows>
            <row><label value="a"/><label value="b"/><label value="Alice"/></row>
        </rows>
    </grid>
    <listbox sclass="mhf-listbox-icon-menu" width="360px">
        <listhead menupopup="auto">
            <listheader width="56px" image="/web/img/received.png"/>
            <listheader width="76px" image="/web/img/received.png"/>
            <listheader label="Name" width="200px"/>
        </listhead>
        <listitem><listcell label="a"/><listcell label="b"/><listcell label="Alice"/></listitem>
    </listbox>
    <!-- Select-all-only headers that carry the column-menu button, at the documented minimum widths (68px on
         desktop, 88px on a tablet; contracts/listbox.md). -->
    <listbox sclass="mhf-listbox-select-all-only-menu-desktop" width="360px" checkmark="true" multiple="true">
        <listhead menupopup="auto">
            <listheader width="68px"/>
            <listheader label="Name" width="200px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-select-all-only-menu-tablet" width="360px" checkmark="true" multiple="true">
        <listhead menupopup="auto">
            <listheader width="88px"/>
            <listheader label="Name" width="200px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <!-- A checkmark Tree next to the Tree/Grid pair above: the data rows are as tall as the Grid rows. -->
    <tree sclass="mhf-tree-checkmark" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol label="Name" width="160px"/>
            <treecol label="Type" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell label="Alice"/><treecell label="Engineering"/></treerow></treeitem>
        </treechildren>
    </tree>
    <!-- A Tree whose first cell holds plain text, a textbox or a button, next to the Grids above: the rows are as tall as
         the Grid rows (follow-ups 34 and 38). -->
    <tree sclass="mhf-tree-plain-control-row" width="360px">
        <treecols>
            <treecol label="Name" width="160px"/>
            <treecol label="Type" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow sclass="mhf-textbox-row"><treecell><textbox value="Alice"/></treecell><treecell label="Engineering"/></treerow></treeitem>
            <treeitem><treerow sclass="mhf-button-row"><treecell><button label="Go"/></treecell><treecell label="Engineering"/></treerow></treeitem>
        </treechildren>
    </tree>
    <!-- A Listbox group row next to a Grid group row (follow-up 40). -->
    <listbox sclass="mhf-listbox-group" width="360px">
        <listhead>
            <listheader label="Name" width="160px"/>
            <listheader label="Type" width="160px"/>
        </listhead>
        <listgroup label="Group"/>
        <listitem><listcell label="Alice"/><listcell label="Engineering"/></listitem>
    </listbox>
    <grid sclass="mhf-grid-group" width="360px">
        <columns>
            <column label="Name" width="160px"/>
            <column label="Type" width="160px"/>
        </columns>
        <rows>
            <group label="Group"/>
            <row><label value="Alice"/><label value="Engineering"/></row>
        </rows>
    </grid>
    <!-- A Listbox whose groups are selectable (groupSelect), one of them disabled (follow-up 41). -->
    <listbox sclass="mhf-listbox-group-select" width="360px" checkmark="true" multiple="true">
        <custom-attributes org.zkoss.zul.listbox.groupSelect="true"/>
        <listhead>
            <listheader label="Name" width="160px"/>
            <listheader label="Type" width="160px"/>
        </listhead>
        <listgroup label="Group"/>
        <listitem><listcell label="Alice"/><listcell label="Engineering"/></listitem>
        <listgroup label="Disabled group" disabled="true"/>
        <listitem><listcell label="Bob"/><listcell label="Engineering"/></listitem>
    </listbox>
    <!-- A centred select-all-only column that carries the column-menu button, at 68 and 88px (follow-up 52): the header keeps
         its box in the cell the button leaves; only a centred column without the button is centred on the whole cell. -->
    <listbox sclass="mhf-listbox-centre-menu-68" width="360px" checkmark="true" multiple="true">
        <listhead menupopup="auto">
            <listheader width="68px" align="center"/>
            <listheader label="Name" width="200px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-centre-menu-88" width="360px" checkmark="true" multiple="true">
        <listhead menupopup="auto">
            <listheader width="88px" align="center"/>
            <listheader label="Name" width="200px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <!-- A select-all-only column of 24 to 160px, centred and left-aligned, in a checkmark Listbox (follow-up 52): the header box and the row box share one centre. -->
    <listbox sclass="mhf-listbox-box-column mhf-box-column-center-24" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader width="24px" align="center"/>
            <listheader label="Name" width="160px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-box-column mhf-box-column-center-40" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader width="40px" align="center"/>
            <listheader label="Name" width="160px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-box-column mhf-box-column-center-48" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader width="48px" align="center"/>
            <listheader label="Name" width="160px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-box-column mhf-box-column-center-160" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader width="160px" align="center"/>
            <listheader label="Name" width="160px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-box-column mhf-box-column-left-24" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader width="24px" align="left"/>
            <listheader label="Name" width="160px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-box-column mhf-box-column-left-40" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader width="40px" align="left"/>
            <listheader label="Name" width="160px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-box-column mhf-box-column-left-48" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader width="48px" align="left"/>
            <listheader label="Name" width="160px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <listbox sclass="mhf-listbox-box-column mhf-box-column-left-160" width="360px" checkmark="true" multiple="true">
        <listhead>
            <listheader width="160px" align="left"/>
            <listheader label="Name" width="160px"/>
        </listhead>
        <listitem><listcell/><listcell label="Alice"/></listitem>
    </listbox>
    <!-- A select-all-only column of 24 to 160px, centred and left-aligned, in a checkmark Tree (follow-up 54): same guard as the Listbox above. -->
    <tree sclass="mhf-tree-box-column mhf-tree-box-column-center-24" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol width="24px" align="center"/>
            <treecol label="Name" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell/><treecell label="Alice"/></treerow></treeitem>
        </treechildren>
    </tree>
    <tree sclass="mhf-tree-box-column mhf-tree-box-column-center-40" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol width="40px" align="center"/>
            <treecol label="Name" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell/><treecell label="Alice"/></treerow></treeitem>
        </treechildren>
    </tree>
    <tree sclass="mhf-tree-box-column mhf-tree-box-column-center-48" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol width="48px" align="center"/>
            <treecol label="Name" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell/><treecell label="Alice"/></treerow></treeitem>
        </treechildren>
    </tree>
    <tree sclass="mhf-tree-box-column mhf-tree-box-column-center-160" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol width="160px" align="center"/>
            <treecol label="Name" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell/><treecell label="Alice"/></treerow></treeitem>
        </treechildren>
    </tree>
    <tree sclass="mhf-tree-box-column mhf-tree-box-column-left-24" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol width="24px" align="left"/>
            <treecol label="Name" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell/><treecell label="Alice"/></treerow></treeitem>
        </treechildren>
    </tree>
    <tree sclass="mhf-tree-box-column mhf-tree-box-column-left-40" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol width="40px" align="left"/>
            <treecol label="Name" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell/><treecell label="Alice"/></treerow></treeitem>
        </treechildren>
    </tree>
    <tree sclass="mhf-tree-box-column mhf-tree-box-column-left-48" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol width="48px" align="left"/>
            <treecol label="Name" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell/><treecell label="Alice"/></treerow></treeitem>
        </treechildren>
    </tree>
    <tree sclass="mhf-tree-box-column mhf-tree-box-column-left-160" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol width="160px" align="left"/>
            <treecol label="Name" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem><treerow><treecell/><treecell label="Alice"/></treerow></treeitem>
        </treechildren>
    </tree>
    <!-- A centred first column that carries a label next to the select-all box, 100px with a label far wider than the column and 160px with a short one, with nested items (follow-up 59): the box-only rules of follow-up 54 must not reach it. -->
    <tree sclass="mhf-tree-label-column mhf-tree-label-100" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol label="Select everything in this tree" width="100px" align="center"/>
            <treecol label="Name" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem open="true">
                <treerow><treecell label="Parent"/><treecell label="Alice"/></treerow>
                <treechildren>
                    <treeitem open="true">
                        <treerow><treecell label="Child"/><treecell label="Bob"/></treerow>
                        <treechildren>
                            <treeitem><treerow><treecell label="Grandchild"/><treecell label="Carol"/></treerow></treeitem>
                        </treechildren>
                    </treeitem>
                </treechildren>
            </treeitem>
        </treechildren>
    </tree>
    <tree sclass="mhf-tree-label-column mhf-tree-label-160" width="360px" checkmark="true" multiple="true">
        <treecols>
            <treecol label="All" width="160px" align="center"/>
            <treecol label="Name" width="160px"/>
        </treecols>
        <treechildren>
            <treeitem open="true">
                <treerow><treecell label="Parent"/><treecell label="Alice"/></treerow>
                <treechildren>
                    <treeitem open="true">
                        <treerow><treecell label="Child"/><treecell label="Bob"/></treerow>
                        <treechildren>
                            <treeitem><treerow><treecell label="Grandchild"/><treecell label="Carol"/></treerow></treeitem>
                        </treechildren>
                    </treeitem>
                </treechildren>
            </treeitem>
        </treechildren>
    </tree>
</div>
