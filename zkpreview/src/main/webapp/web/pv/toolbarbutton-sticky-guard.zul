<?page title="Toolbarbutton under a sticky header" contentType="text/html;charset=UTF-8"?>
<!-- Fixture for the sticky-header case of focus-ring-scan.spec.ts (follow-up 36): a Listbox with the opt-in
     `z-sticky-header` class in a scrolling container, whose rows hold a toolbarbutton. A focused toolbarbutton that has
     been scrolled under the header must stay under it. Lives under pv/ so gallery-scan, forced-colors-gallery and
     font-size-equivalence do not pick it up as a page. -->
<zk>
<div sclass="z-p-8">
    <div sclass="tsg-scroller" style="height:160px; overflow-y:auto; width:400px;">
        <listbox sclass="z-sticky-header" width="380px">
            <listhead>
                <listheader label="Row #" width="100px"/>
                <listheader label="Action"/>
            </listhead>
            <listitem><listcell label="1"/><listcell><toolbarbutton label="Open 1"/></listcell></listitem>
            <listitem><listcell label="2"/><listcell><toolbarbutton label="Open 2"/></listcell></listitem>
            <listitem><listcell label="3"/><listcell><toolbarbutton label="Open 3"/></listcell></listitem>
            <listitem><listcell label="4"/><listcell><toolbarbutton label="Open 4"/></listcell></listitem>
            <listitem><listcell label="5"/><listcell><toolbarbutton label="Open 5"/></listcell></listitem>
            <listitem><listcell label="6"/><listcell><toolbarbutton label="Open 6"/></listcell></listitem>
            <listitem><listcell label="7"/><listcell><toolbarbutton label="Open 7"/></listcell></listitem>
            <listitem><listcell label="8"/><listcell><toolbarbutton label="Open 8"/></listcell></listitem>
            <listitem><listcell label="9"/><listcell><toolbarbutton label="Open 9"/></listcell></listitem>
            <listitem><listcell label="10"/><listcell><toolbarbutton label="Open 10"/></listcell></listitem>
        </listbox>
    </div>
</div>
</zk>
