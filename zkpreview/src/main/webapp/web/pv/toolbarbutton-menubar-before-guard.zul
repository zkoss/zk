<?page title="Toolbarbutton after a menubar" contentType="text/html;charset=UTF-8"?>
<!-- Fixture for the menubar-before case of focus-ring-scan.spec.ts (follow-up 36 F1): a toolbarbutton that follows a
     `.z-menubar` (z-index 100) in the same container, with no gap, so the 4px of its focus ring that reach towards the
     menubar are painted over it unless the focused button rises above the menubar. Lives under pv/ so gallery-scan,
     forced-colors-gallery and font-size-equivalence do not pick it up as a page. -->
<zk>
<div sclass="z-p-8">
    <div sclass="tmb-row" style="display:flex; align-items:center;">
        <menubar>
            <menu label="File">
                <menupopup>
                    <menuitem label="New"/>
                </menupopup>
            </menu>
        </menubar>
        <toolbarbutton label="After the menubar"/>
    </div>
</div>
</zk>
