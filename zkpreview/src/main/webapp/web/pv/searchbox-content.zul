<zk xmlns:h="native">
<zscript><![CDATA[
    import org.zkoss.zul.ListModelList;
    ListModelList searchboxSingle = new ListModelList(new String[]{
        "Apple", "Banana", "Cherry", "Dragonfruit", "Elderberry"
    });
    searchboxSingle.setMultiple(false);
    searchboxSingle.addToSelection(searchboxSingle.get(0));

    ListModelList searchboxMulti = new ListModelList(new String[]{
        "Apple", "Banana", "Cherry", "Dragonfruit", "Elderberry"
    });
    searchboxMulti.setMultiple(true);
    searchboxMulti.addToSelection(searchboxMulti.get(0));
    searchboxMulti.addToSelection(searchboxMulti.get(1));
]]></zscript>

<apply templateURI="~./pv/matrix.zul" title="States"
       cols="${['Default','Disabled']}"
       rowsTemplate="searchbox-rows">
    <template name="searchbox-rows">
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Default"/></div>
            <div>
                <searchbox model="${searchModel}" placeholder="Search regions..." autoclose="true">
                    <template name="model"><html><![CDATA[<i class="z-icon-globe"></i> ${each}]]></html></template>
                </searchbox>
            </div>
            <div>
                <searchbox model="${searchModel}" placeholder="Search regions..." disabled="true"/>
            </div>
        </div>
    </template>
</apply>

<h:div class="z-mb-6">
    <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Selected + Multiple + Clear + searchMessage</h:span></h:div>
    <h:div class="z-d-flex z-flex-wrap z-gap-6 z-py-3">
        <h:div class="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">Single — pre-selected (clear icon visible)</label>
            <searchbox model="${searchboxSingle}" searchMessage="Type to search…"/>
        </h:div>
        <h:div class="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">Multiple — two items pre-selected (chips)</label>
            <searchbox model="${searchboxMulti}" multiple="true"/>
        </h:div>
        <h:div class="z-d-flex z-flex-col z-gap-2">
            <label sclass="z-text-xs z-text-secondary">searchMessage placeholder (empty)</label>
            <searchbox model="${searchModel}" searchMessage="Find a fruit"/>
        </h:div>
    </h:div>
</h:div>
</zk>
