<?page title="Rowlayout" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">Rowlayout</h:span></h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">12-Column Grid (3 equal columns)</h:span></h:div>
        <h:div class="z-py-3">
            <rowlayout ncols="12">
                <forEach begin="1" end="3">
                    <rowchildren colspan="4" style="background-color: skyblue;  text-align: center;">
                        1/3
                    </rowchildren>
                </forEach>
            </rowlayout>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Mixed Column Spans</h:span></h:div>
        <h:div class="z-py-3">
            <rowlayout ncols="12">
                <rowchildren colspan="8" style="background-color: #b3d9ff;  text-align: center;">
                    8/12
                </rowchildren>
                <rowchildren colspan="4" style="background-color: #ffe0b3;  text-align: center;">
                    4/12
                </rowchildren>
            </rowlayout>
            <rowlayout ncols="12">
                <rowchildren colspan="6" style="background-color: #c8e6c9;  text-align: center;">
                    6/12
                </rowchildren>
                <rowchildren colspan="6" style="background-color: #f8bbd0;  text-align: center;">
                    6/12
                </rowchildren>
            </rowlayout>
        </h:div>
    </h:div>

</h:div>
</zk>
