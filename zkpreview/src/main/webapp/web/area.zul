<?page title="Area" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">Area</h:span></h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Imagemap with Areas (click to see area id)</h:span></h:div>
        <h:div class="z-py-3">
            <imagemap src="~./img/sun.jpg" onClick="alert(event.area)">
                <area id="First" coords="0, 0, 100, 100"/>
                <area id="Second" shape="circle" coords="200, 200, 100"/>
            </imagemap>
        </h:div>
    </h:div>

</h:div>
</zk>
