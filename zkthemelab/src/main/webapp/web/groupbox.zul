<?page title="Groupbox" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">Groupbox</h:span></h:div>

    <div sclass="z-mb-6 z-d-grid z-grid-cols-auto z-overflow-x-auto z-gap-x-6 z-gap-y-2 z-items-start" style="--zk-cols:2; --zk-col-min:min-content">
        <div sclass="z-grid-col-full z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Default Mold"/></div>
        <div sclass="z-d-contents">
            <div/>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Caption + Image"/></div>
            <div><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Caption Only"/></div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Default"/></div>
            <div>
                <groupbox width="240px">
                    <caption image="~./img/volumn.gif" label="Caption" />
                    Groupbox Content
                </groupbox>
            </div>
            <div>
                <groupbox width="240px">
                    <caption label="Caption" />
                    Groupbox Content
                </groupbox>
            </div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Title Attr"/></div>
            <div>
                <groupbox width="240px" title="Title" height="200px">
                    Groupbox Content (title attr, no caption)
                </groupbox>
            </div>
            <div>
                <groupbox width="240px" title="Title" height="200px">
                    <caption label="Caption" />
                    Groupbox Content (caption + title)
                </groupbox>
            </div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Image Only"/></div>
            <div>
                <groupbox width="240px">
                    <caption image="~./img/volumn.gif" />
                    Groupbox Content
                </groupbox>
            </div>
            <div>
                <groupbox width="240px">
                    Groupbox Content (no caption)
                </groupbox>
            </div>
        </div>
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Collapsed"/></div>
            <div>
                <groupbox width="240px" open="false">
                    <caption image="~./img/volumn.gif" label="Caption" />
                    Groupbox Content
                </groupbox>
            </div>
            <div>
                <groupbox width="240px" open="false">
                    <caption label="Caption" />
                    Groupbox Content
                </groupbox>
            </div>
        </div>
    </div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">3D Mold — Caption Variants</h:span></h:div>
        <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">Caption + Image</h:span></h:div>
                <groupbox width="240px" mold="3d">
                    <caption image="~./img/volumn.gif" label="Caption" />
                    Groupbox Content
                </groupbox>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">Caption Only</h:span></h:div>
                <groupbox width="240px" mold="3d">
                    <caption label="Caption" />
                    Groupbox Content
                </groupbox>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">Title Attr (no caption)</h:span></h:div>
                <groupbox width="240px" mold="3d" title="Title">
                    Groupbox Content
                </groupbox>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">Caption + Title mixed</h:span></h:div>
                <groupbox width="240px" mold="3d" title="Title">
                    <caption label="Caption" />
                    Groupbox Content
                </groupbox>
            </h:div>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">3D Mold — Edge Cases</h:span></h:div>
        <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">Image only caption</h:span></h:div>
                <groupbox width="240px" mold="3d">
                    <caption image="~./img/volumn.gif" />
                    Groupbox Content
                </groupbox>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">No caption</h:span></h:div>
                <groupbox width="240px" mold="3d">
                    Groupbox Content
                </groupbox>
            </h:div>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Non-Closable (closable=false)</h:span></h:div>
        <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <groupbox width="240px" title="Not closable" closable="false">
                Groupbox Content
            </groupbox>
        </h:div>
    </h:div>
</h:div>
</zk>
