<?page title="Video" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">Video</h:span></h:div>
    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Player</h:span></h:div>
        <h:div class="z-py-3 z-d-flex z-flex-col z-gap-4">
            <h:div><h:span class="z-text-xs z-text-secondary">Note: provide a valid video URL via src attribute (e.g. an .mp4 file).</h:span></h:div>
            <video id="video" width="480px" src="~./media/video.mp4" poster="~./img/ZK-Logo.gif" controls="true"/>
        </h:div>
    </h:div>
    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Controls</h:span></h:div>
        <h:div class="z-py-3 z-d-flex z-gap-4 z-flex-wrap">
            <button label="Play" onClick="video.play()"/>
            <button label="Pause" onClick="video.pause()"/>
            <button label="Stop" onClick="video.stop()"/>
        </h:div>
    </h:div>
</h:div>
</zk>
