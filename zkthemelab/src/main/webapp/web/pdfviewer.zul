<?page title="PDF Viewer" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">PDF Viewer</h:span></h:div>
    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Document Viewer</h:span></h:div>
        <h:div class="z-py-3 z-d-flex z-flex-col z-gap-4">
            <h:div><h:span class="z-text-xs z-text-secondary">Note: provide a valid PDF URL via src attribute.</h:span></h:div>
            <pdfviewer src="~./link-annotation.pdf" width="100%" height="600px"/>
        </h:div>
    </h:div>
</h:div>
</zk>
