<?page title="Stack Utilities"?>
<zk xmlns:h="native">
<style src="~./usecase/usecase.css"/>
<vlayout hflex="1" sclass="z-d-flex z-flex-col z-gap-4 z-p-4 z-bg-surface-container-low">

    <label value="Stack Utilities" sclass="z-h2"/>

    <!-- Concept -->
    <div sclass="z-paper">
        <label value="Concept" sclass="z-d-block z-text-lg z-fw-medium z-text-on-surface z-mb-3"/>
        <label sclass="z-d-block z-text-secondary z-text-md z-mb-2"
               value="Marble has two opt-in container utilities for grouping items with consistent spacing. Naming follows Bootstrap 5 / SwiftUI."/>
        <div sclass="z-d-grid z-grid-cols-2 z-gap-4">
            <div sclass="z-bg-surface z-p-4 z-rounded-md">
                <label value=".z-vstack — vertical group" sclass="z-d-block z-text-lg z-fw-semibold z-mb-2"/>
                <label sclass="z-d-block z-text-secondary z-text-sm z-mb-3"
                       value="Lobotomized Owl pattern. Every child except the first gets margin-top. Use for stacked items in a column."/>
                <html><![CDATA[<pre style="margin:0;font-size:12px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;background:var(--zk-color-surface-variant);color:var(--zk-color-on-surface);padding:8px;border-radius:4px;white-space:pre;overflow:auto">&lt;div sclass="z-vstack"&gt;
  &lt;textbox/&gt;
  &lt;textbox/&gt;
  &lt;button label="Submit"/&gt;
&lt;/div&gt;</pre>]]></html>
            </div>
            <div sclass="z-bg-surface z-p-4 z-rounded-md">
                <label value=".z-hstack — horizontal group" sclass="z-d-block z-text-lg z-fw-semibold z-mb-2"/>
                <label sclass="z-d-block z-text-secondary z-text-sm z-mb-3"
                       value="display:flex + gap + wrap. Use for buttons / chips / atomic widgets in a row."/>
                <html><![CDATA[<pre style="margin:0;font-size:12px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;background:var(--zk-color-surface-variant);color:var(--zk-color-on-surface);padding:8px;border-radius:4px;white-space:pre;overflow:auto">&lt;div sclass="z-hstack"&gt;
  &lt;button label="Save"/&gt;
  &lt;button label="Cancel"/&gt;
&lt;/div&gt;</pre>]]></html>
            </div>
        </div>
    </div>

    <!-- z-vstack demo -->
    <div sclass="z-paper">
        <label value=".z-vstack — vertical stack" sclass="z-d-block z-text-lg z-fw-medium z-text-on-surface z-mb-3"/>
        <label sclass="z-d-block z-text-secondary z-text-sm z-mb-3"
               value="Five size variants. Default = 12px (z-vstack), sm = 8px, md = 16px, lg = 24px, 0 = none."/>
        <div sclass="z-d-grid z-grid-cols-5 z-gap-4">
            <div>
                <label value=".z-vstack-sm  (8px)" sclass="z-d-block z-text-sm z-text-secondary z-mb-2"/>
                <div sclass="z-bg-surface-variant z-rounded z-p-3 z-vstack-sm">
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 1"/></div>
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 2"/></div>
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 3"/></div>
                </div>
            </div>
            <div>
                <label value=".z-vstack    (12px)" sclass="z-d-block z-text-sm z-text-secondary z-mb-2"/>
                <div sclass="z-bg-surface-variant z-rounded z-p-3 z-vstack">
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 1"/></div>
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 2"/></div>
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 3"/></div>
                </div>
            </div>
            <div>
                <label value=".z-vstack-md (16px)" sclass="z-d-block z-text-sm z-text-secondary z-mb-2"/>
                <div sclass="z-bg-surface-variant z-rounded z-p-3 z-vstack-md">
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 1"/></div>
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 2"/></div>
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 3"/></div>
                </div>
            </div>
            <div>
                <label value=".z-vstack-lg (24px)" sclass="z-d-block z-text-sm z-text-secondary z-mb-2"/>
                <div sclass="z-bg-surface-variant z-rounded z-p-3 z-vstack-lg">
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 1"/></div>
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 2"/></div>
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 3"/></div>
                </div>
            </div>
            <div>
                <label value=".z-vstack-0   (0)" sclass="z-d-block z-text-sm z-text-secondary z-mb-2"/>
                <div sclass="z-bg-surface-variant z-rounded z-p-3 z-vstack-0">
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 1"/></div>
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 2"/></div>
                    <div sclass="z-bg-primary-container z-rounded z-py-2 z-px-3"><label sclass="z-text-sm z-fw-medium" value="Item 3"/></div>
                </div>
            </div>
        </div>
    </div>

    <!-- z-hstack demo -->
    <div sclass="z-paper">
        <label value=".z-hstack — horizontal stack" sclass="z-d-block z-text-lg z-fw-medium z-text-on-surface z-mb-3"/>
        <label sclass="z-d-block z-text-secondary z-text-sm z-mb-3"
               value="Four size variants. Wraps automatically when the row overflows. Default = 12px, sm = 8px, md = 16px, lg = 24px."/>

        <label value=".z-hstack-sm  (8px)" sclass="z-d-block z-text-sm z-text-secondary z-mb-2"/>
        <div sclass="z-bg-surface-variant z-rounded z-p-3 z-hstack-sm z-mb-3">
            <button label="Save"/>
            <button label="Cancel"/>
            <button label="Discard"/>
        </div>

        <label value=".z-hstack    (12px)" sclass="z-d-block z-text-sm z-text-secondary z-mb-2"/>
        <div sclass="z-bg-surface-variant z-rounded z-p-3 z-hstack z-mb-3">
            <button label="Save"/>
            <button label="Cancel"/>
            <button label="Discard"/>
        </div>

        <label value=".z-hstack-md (16px)" sclass="z-d-block z-text-sm z-text-secondary z-mb-2"/>
        <div sclass="z-bg-surface-variant z-rounded z-p-3 z-hstack-md z-mb-3">
            <button label="Save"/>
            <button label="Cancel"/>
            <button label="Discard"/>
        </div>

        <label value=".z-hstack-lg (24px)" sclass="z-d-block z-text-sm z-text-secondary z-mb-2"/>
        <div sclass="z-bg-surface-variant z-rounded z-p-3 z-hstack-lg">
            <button label="Save"/>
            <button label="Cancel"/>
            <button label="Discard"/>
        </div>
    </div>

    <!-- Mixed example -->
    <div sclass="z-paper">
        <label value="Real-world Example — Form Actions" sclass="z-d-block z-text-lg z-fw-medium z-text-on-surface z-mb-3"/>
        <label sclass="z-d-block z-text-secondary z-text-sm z-mb-3"
               value="Stack form rows vertically with .z-vstack, then group the action buttons horizontally with .z-hstack."/>
        <div sclass="z-bg-surface z-p-4 z-rounded-md" style="max-width:480px">
            <div sclass="z-vstack-md">
                <div>
                    <label value="Name" sclass="z-d-block z-text-sm z-text-secondary z-mb-1"/>
                    <textbox hflex="1" value="Hawk Chen"/>
                </div>
                <div>
                    <label value="Email" sclass="z-d-block z-text-sm z-text-secondary z-mb-1"/>
                    <textbox hflex="1" value="hawk@example.com"/>
                </div>
                <div>
                    <label value="Notes" sclass="z-d-block z-text-sm z-text-secondary z-mb-1"/>
                    <textbox hflex="1" rows="3"/>
                </div>
                <div sclass="z-hstack">
                    <button label="Save"/>
                    <button label="Cancel" sclass="z-button-outlined"/>
                </div>
            </div>
        </div>
    </div>

    <!-- Opt-in spacing (no default widget margins) -->
    <div sclass="z-paper">
        <label value="Opt-in Spacing — Widgets Have No Default Margins" sclass="z-d-block z-text-lg z-fw-medium z-text-on-surface z-mb-3"/>
        <label sclass="z-d-block z-text-secondary z-text-sm z-mb-3"
               value="No widget carries a theme-default margin (ZK's hflex/vflex sizing measures child margins — see doc/spec/spacing-policy.md). To space stacked widgets, put .z-vstack on the parent; it works for container widgets (panel, window, grid, …) and atomic widgets alike."/>
        <div sclass="z-d-grid z-grid-cols-2 z-gap-4">
            <div>
                <label value=".z-vstack — container widgets" sclass="z-d-block z-text-sm z-fw-semibold z-mb-2"/>
                <div sclass="z-bg-surface-variant z-rounded z-p-3 z-vstack">
                    <panel title="Panel A" border="normal">
                        <panelchildren style="padding:12px">Block widget #1</panelchildren>
                    </panel>
                    <panel title="Panel B" border="normal">
                        <panelchildren style="padding:12px">Block widget #2</panelchildren>
                    </panel>
                    <panel title="Panel C" border="normal">
                        <panelchildren style="padding:12px">Block widget #3</panelchildren>
                    </panel>
                </div>
                <label sclass="z-d-block z-text-secondary z-text-xs z-mt-2"
                       value="One sclass on the container — 12px between each panel. Without it the panels sit flush."/>
            </div>
            <div>
                <label value=".z-vstack — atomic widgets" sclass="z-d-block z-text-sm z-fw-semibold z-mb-2"/>
                <div sclass="z-bg-surface-variant z-rounded z-p-3 z-vstack">
                    <textbox hflex="1" placeholder="textbox #1"/>
                    <textbox hflex="1" placeholder="textbox #2"/>
                    <textbox hflex="1" placeholder="textbox #3"/>
                </div>
                <label sclass="z-d-block z-text-secondary z-text-xs z-mt-2"
                       value="Same pattern for textbox, button, checkbox — spacing is always declared on the parent."/>
            </div>
        </div>
    </div>

    <!-- Class reference -->
    <div sclass="z-paper">
        <label value="Class Reference" sclass="z-d-block z-text-lg z-fw-medium z-text-on-surface z-mb-3"/>
        <div sclass="z-d-grid z-grid-cols-2 z-gap-6">
            <div>
                <label value="Vertical (margin-top on child #2+)" sclass="z-d-block z-text-sm z-fw-semibold z-mb-2"/>
                <div sclass="z-d-grid z-grid-cols-auto-1fr z-gap-x-4 z-gap-y-2">
                    <label value=".z-vstack-sm" sclass="z-text-sm z-text-secondary"/><label value="8px"  sclass="z-text-sm"/>
                    <label value=".z-vstack"    sclass="z-text-sm z-text-secondary"/><label value="12px (default)" sclass="z-text-sm"/>
                    <label value=".z-vstack-md" sclass="z-text-sm z-text-secondary"/><label value="16px" sclass="z-text-sm"/>
                    <label value=".z-vstack-lg" sclass="z-text-sm z-text-secondary"/><label value="24px" sclass="z-text-sm"/>
                    <label value=".z-vstack-0"  sclass="z-text-sm z-text-secondary"/><label value="0 (escape hatch)" sclass="z-text-sm"/>
                </div>
            </div>
            <div>
                <label value="Horizontal (flex + gap, wraps)" sclass="z-d-block z-text-sm z-fw-semibold z-mb-2"/>
                <div sclass="z-d-grid z-grid-cols-auto-1fr z-gap-x-4 z-gap-y-2">
                    <label value=".z-hstack-sm" sclass="z-text-sm z-text-secondary"/><label value="8px"  sclass="z-text-sm"/>
                    <label value=".z-hstack"    sclass="z-text-sm z-text-secondary"/><label value="12px (default)" sclass="z-text-sm"/>
                    <label value=".z-hstack-md" sclass="z-text-sm z-text-secondary"/><label value="16px" sclass="z-text-sm"/>
                    <label value=".z-hstack-lg" sclass="z-text-sm z-text-secondary"/><label value="24px" sclass="z-text-sm"/>
                </div>
            </div>
        </div>
    </div>

</vlayout>
</zk>
