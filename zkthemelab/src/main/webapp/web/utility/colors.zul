<?page title="Color Utilities"?>
<zk>
<style src="~./usecase/usecase.css"/>
<vlayout hflex="1" sclass="z-d-flex z-flex-col z-gap-4 z-p-4 z-bg-surface-container-low">

    <label value="Color Utilities" sclass="z-h2"/>

    <!-- Text Colors -->
    <div sclass="z-paper">
        <label value="Text Colors" sclass="z-d-block z-text-lg z-fw-medium z-text-on-surface z-mb-3"/>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px">
            <div sclass="z-d-flex z-items-center z-gap-2">
                <label value="Sample Text" sclass="z-text-primary z-fw-medium"/>
                <label value=".z-text-primary" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-items-center z-gap-2">
                <label value="Sample Text" sclass="z-text-secondary z-fw-medium"/>
                <label value=".z-text-secondary" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-items-center z-gap-2">
                <label value="Sample Text" sclass="z-text-success z-fw-medium"/>
                <label value=".z-text-success" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-items-center z-gap-2">
                <label value="Sample Text" sclass="z-text-warning z-fw-medium"/>
                <label value=".z-text-warning" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-items-center z-gap-2">
                <label value="Sample Text" sclass="z-text-error z-fw-medium"/>
                <label value=".z-text-error" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-items-center z-gap-2">
                <label value="Sample Text" sclass="z-text-info z-fw-medium"/>
                <label value=".z-text-info" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-items-center z-gap-2">
                <label value="Sample Text" sclass="z-text-neutral z-fw-medium"/>
                <label value=".z-text-neutral" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-items-center z-gap-2">
                <label value="Sample Text" sclass="z-text-disabled z-fw-medium"/>
                <label value=".z-text-disabled" sclass="z-text-secondary z-text-sm"/>
            </div>
            <div sclass="z-d-flex z-items-center z-gap-2">
                <label value="Sample Text" sclass="z-text-on-surface z-fw-medium"/>
                <label value=".z-text-on-surface" sclass="z-text-secondary z-text-sm"/>
            </div>
        </div>
    </div>

    <!-- Background Colors -->
    <div sclass="z-paper">
        <label value="Background Colors" sclass="z-d-block z-text-lg z-fw-medium z-text-on-surface z-mb-3"/>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px">
            <div sclass="z-bg-primary z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-primary" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-primary-container z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-primary-container" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-secondary z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-secondary" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-secondary-container z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-secondary-container" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-error z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-error" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-error-container z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-error-container" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-success z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-success" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-warning z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-warning" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-info z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-info" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-surface z-p-3 z-rounded-md z-text-center z-border">
                <label value=".z-bg-surface" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-surface-variant z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-surface-variant" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-surface-container z-p-3 z-rounded-md z-text-center">
                <label value=".z-bg-surface-container" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-surface-container-low z-p-3 z-rounded-md z-text-center z-border">
                <label value=".z-bg-surface-container-low" sclass="z-fw-medium"/>
            </div>
            <div sclass="z-bg-transparent z-p-3 z-rounded-md z-text-center z-border">
                <label value=".z-bg-transparent" sclass="z-fw-medium"/>
            </div>
        </div>
    </div>

    <!-- Surface container steps -->
    <div sclass="z-paper">
        <label value="Surface Container Steps  (.z-bg-surface-container-lowest → -highest)" sclass="z-d-block z-text-lg z-fw-medium z-text-on-surface z-mb-3"/>
        <div sclass="z-d-flex z-gap-3 z-flex-wrap">
            <div sclass="z-bg-surface-container-lowest z-border z-p-3 z-rounded-md pv-bg-lowest"><label value="-lowest"/></div>
            <div sclass="z-bg-surface-container-low z-border z-p-3 z-rounded-md"><label value="-low"/></div>
            <div sclass="z-bg-surface-container z-border z-p-3 z-rounded-md"><label value="(base)"/></div>
            <div sclass="z-bg-surface-container-high z-border z-p-3 z-rounded-md pv-bg-high"><label value="-high"/></div>
            <div sclass="z-bg-surface-container-highest z-border z-p-3 z-rounded-md pv-bg-highest"><label value="-highest"/></div>
            <vlayout sclass="z-bg-surface-container-high z-p-3 z-rounded-md pv-bg-vlayout"><label value="Vlayout -high"/></vlayout>
        </div>
    </div>

    <!-- Text on containers -->
    <div sclass="z-paper">
        <label value="Text on Containers  (.z-text-on-{role}-container)" sclass="z-d-block z-text-lg z-fw-medium z-text-on-surface z-mb-3"/>
        <div sclass="z-d-flex z-gap-3 z-flex-wrap">
            <div sclass="z-bg-primary-container z-p-3 z-rounded-md">
                <label value="Plain label" sclass="z-d-block pv-container-plain"/>
                <label value="On primary container" sclass="z-text-on-primary-container z-fw-medium pv-on-primary-container"/>
            </div>
            <div sclass="z-bg-secondary-container z-p-3 z-rounded-md"><label value="On secondary container" sclass="z-text-on-secondary-container z-fw-medium pv-on-secondary-container"/></div>
            <div sclass="z-bg-error-container z-p-3 z-rounded-md"><label value="On error container" sclass="z-text-on-error-container z-fw-medium pv-on-error-container"/></div>
            <div sclass="z-bg-success-container z-p-3 z-rounded-md"><label value="On success container" sclass="z-text-on-success-container z-fw-medium pv-on-success-container"/></div>
            <div sclass="z-bg-warning-container z-p-3 z-rounded-md"><label value="On warning container" sclass="z-text-on-warning-container z-fw-medium pv-on-warning-container"/></div>
        </div>
        <label value="A Label sets its own colour, so the container's text colour never reaches it. Put .z-text-on-*-container on the Label." sclass="z-text-secondary z-text-xs z-mt-3"/>
    </div>

    <!-- Inverse text on dark background -->
    <div sclass="z-paper">
        <label value="Inverse Text" sclass="z-d-block z-text-lg z-fw-medium z-text-on-surface z-mb-3"/>
        <div sclass="z-bg-inverse-surface z-p-4 z-rounded-md z-d-inline-block pv-bg-inverse">
            <label value=".z-text-inverse on .z-bg-inverse-surface" sclass="z-text-inverse z-fw-medium pv-text-inverse"/>
        </div>
        <div sclass="z-bg-primary z-p-4 z-rounded-md z-d-inline-block z-ms-3">
            <label value=".z-text-on-primary on .z-bg-primary" sclass="z-text-on-primary z-fw-medium"/>
        </div>
        <label value="Each text class pairs with its own background. A Label sets its own colour, so put the text class on the Label." sclass="z-d-block z-text-secondary z-text-xs z-mt-3"/>
    </div>

</vlayout>
</zk>
