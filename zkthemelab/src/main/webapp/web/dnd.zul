<?page title="Drag &amp; Drop" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
	<h:div class="z-p-8">
		<h:div class="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Drag &amp; drop feedback"/></h:div>

		<!-- Live drag & drop (manual): listitem (message-ghost path) + div (clone-ghost path).
		     Frozen-column .z-word-nowrap is covered by grid.zul (Frozen Columns example). -->
		<h:div class="z-mb-8">
			<h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Live drag &amp; drop (drag to see ghost feedback)"/></h:div>
			<h:div class="z-d-flex z-gap-6 z-items-start z-mb-6">
				<listbox id="srcList" width="200px">
					<listhead><listheader label="Drag a row"/></listhead>
					<listitem draggable="true" label="Item Alpha"/>
					<listitem draggable="true" label="Item Beta"/>
				</listbox>
				<listbox id="dropList" width="200px" droppable="true">
					<listhead><listheader label="Drop zone"/></listhead>
					<listitem label="(drop here)"/>
				</listbox>
			</h:div>
			<h:div class="z-d-flex z-gap-6 z-items-center">
				<div draggable="true" sclass="z-bg-primary-container z-text-on-primary-container z-rounded z-p-3"><label sclass="z-text-sm z-fw-medium" value="Drag me (div)"/></div>
				<div droppable="true" sclass="z-bg-surface-variant z-rounded z-p-6" style="min-width:160px;min-height:72px;display:flex;align-items:center;justify-content:center;"><label sclass="z-text-secondary z-text-sm" value="Drop target"/></div>
			</h:div>
		</h:div>

		<!-- Static swatches: rendered ghost structures for visual reference (no drag needed) -->
		<h:div class="z-mb-8">
			<h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Ghost appearance reference (static replicas)</h:span></h:div>
			<div sclass="z-d-flex z-gap-8 z-items-center" style="position:relative;height:48px;">
				<h:div class="z-drop-ghost z-drop-disallow" style="position:static;">
					<h:div class="z-drop-content">
						<h:span class="z-drop-icon"></h:span>
						<h:span class="z-drop-text">Item Alpha (invalid)</h:span>
					</h:div>
				</h:div>
				<h:div class="z-drop-ghost z-drop-allow" style="position:static;">
					<h:div class="z-drop-content">
						<h:span class="z-drop-icon"></h:span>
						<h:span class="z-drop-text">Item Alpha (drop ok)</h:span>
					</h:div>
				</h:div>
			</div>
		</h:div>
	</h:div>
</zk>
