<?page title="Progressmeter" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native" xmlns:w="http://www.zkoss.org/2005/zk/client">
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Progressmeter"/></div>
    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Values"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="0%"/></div>
                <progressmeter value="0" width="200px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="25%"/></div>
                <progressmeter value="25" width="200px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="50%"/></div>
                <progressmeter value="50" width="200px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="75%"/></div>
                <progressmeter value="75" width="200px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="100%"/></div>
                <progressmeter value="100" width="200px"/>
            </div>
        </div>
    </div>
    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Colors"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Secondary"/></div>
                <progressmeter value="60" width="200px" sclass="z-progressmeter-secondary"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Success"/></div>
                <progressmeter value="60" width="200px" sclass="z-progressmeter-success"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Warning"/></div>
                <progressmeter value="60" width="200px" sclass="z-progressmeter-warning"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Error"/></div>
                <progressmeter value="60" width="200px" sclass="z-progressmeter-error"/>
            </div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Interactive"/></div>
        <div sclass="z-d-flex z-flex-col z-gap-3 z-py-3">
            <div sclass="z-d-flex z-items-center z-gap-3">
                <progressmeter id="pm" value="50" width="200px"/>
                <label id="lb" value="50"/><span sclass="z-text-xs z-text-secondary">/100</span>
            </div>
            <slider curpos="50" width="200px">
                <attribute w:name="onScroll"><![CDATA[
                    var pos = this.getCurpos();
                    this.$f("pm").setValue(pos);
                    this.$f("lb").setValue(pos);
                ]]></attribute>
            </slider>
            <div><label sclass="z-text-xs z-text-secondary" value="Drag slider to change value"/></div>
        </div>
    </div>

    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Indeterminate"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="indeterminate=&quot;true&quot; (animated)"/></div>
                <progressmeter indeterminate="true" width="200px"/>
            </div>
        </div>
    </div>
</div>
</zk>
