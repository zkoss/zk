<?page title="Camera guard" contentType="text/html;charset=UTF-8"?>
<!-- Fixture for camera.spec.ts: a 320px camera; the spec drives requestCamera/start/pause on the
     widget with Chrome's fake 640x480 device. Lives under pv/ so gallery-scan,
     forced-colors-gallery and font-size-equivalence do not pick it up as a page. -->
<zk xmlns:h="native">
<h:div class="z-p-8">
    <camera id="cam" width="320px" previewRecord="true"/>
</h:div>
</zk>
