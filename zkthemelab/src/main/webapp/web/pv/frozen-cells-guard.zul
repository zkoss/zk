<?page title="Frozen cells" contentType="text/html;charset=UTF-8"?>
<!-- Fixture for the frozen-column guards in mesh-header-footer.spec.ts: a Grid whose rows are built with
     <cell> (TD.z-cell, not TD.z-row-inner) with both left and right frozen columns, the same Grid with right
     frozen columns only, and a Listbox and a Tree with right frozen columns. Each has an auxhead (grid), a
     header and a footer. Lives under pv/ so gallery-scan, forced-colors-gallery and font-size-equivalence do not pick it up. -->
<zk>
<vlayout sclass="z-p-8" spacing="20px">
    <grid sclass="fz-grid-both" width="500px" height="200px"><frozen columns="2" rightColumns="1"/>
        <auxhead><auxheader label="Aux 1"/><auxheader label="Aux 2"/><auxheader label="Aux 3"/><auxheader label="Aux 4"/><auxheader label="Aux 5"/><auxheader label="Aux 6"/><auxheader label="Aux 7"/><auxheader label="Aux 8"/><auxheader label="Aux 9"/><auxheader label="Aux 10"/></auxhead>
        <columns><column label="Column 1" width="120px"/><column label="Column 2" width="120px"/><column label="Column 3" width="120px"/><column label="Column 4" width="120px"/><column label="Column 5" width="120px"/><column label="Column 6" width="120px"/><column label="Column 7" width="120px"/><column label="Column 8" width="120px"/><column label="Column 9" width="120px"/><column label="Column 10" width="120px"/></columns>
        <rows><row><cell><label value="r1c1"/></cell><cell><label value="r1c2"/></cell><cell><label value="r1c3"/></cell><cell><label value="r1c4"/></cell><cell><label value="r1c5"/></cell><cell><label value="r1c6"/></cell><cell><label value="r1c7"/></cell><cell><label value="r1c8"/></cell><cell><label value="r1c9"/></cell><cell><label value="r1c10"/></cell></row><row><cell><label value="r2c1"/></cell><cell><label value="r2c2"/></cell><cell><label value="r2c3"/></cell><cell><label value="r2c4"/></cell><cell><label value="r2c5"/></cell><cell><label value="r2c6"/></cell><cell><label value="r2c7"/></cell><cell><label value="r2c8"/></cell><cell><label value="r2c9"/></cell><cell><label value="r2c10"/></cell></row><row><cell><label value="r3c1"/></cell><cell><label value="r3c2"/></cell><cell><label value="r3c3"/></cell><cell><label value="r3c4"/></cell><cell><label value="r3c5"/></cell><cell><label value="r3c6"/></cell><cell><label value="r3c7"/></cell><cell><label value="r3c8"/></cell><cell><label value="r3c9"/></cell><cell><label value="r3c10"/></cell></row></rows>
        <foot><footer label="Footer 1" width="120px"/><footer label="Footer 2" width="120px"/><footer label="Footer 3" width="120px"/><footer label="Footer 4" width="120px"/><footer label="Footer 5" width="120px"/><footer label="Footer 6" width="120px"/><footer label="Footer 7" width="120px"/><footer label="Footer 8" width="120px"/><footer label="Footer 9" width="120px"/><footer label="Footer 10" width="120px"/></foot>
    </grid>
    <grid sclass="fz-grid-right" width="500px" height="200px"><frozen columns="0" rightColumns="1"/>
        <auxhead><auxheader label="Aux 1"/><auxheader label="Aux 2"/><auxheader label="Aux 3"/><auxheader label="Aux 4"/><auxheader label="Aux 5"/><auxheader label="Aux 6"/><auxheader label="Aux 7"/><auxheader label="Aux 8"/><auxheader label="Aux 9"/><auxheader label="Aux 10"/></auxhead>
        <columns><column label="Column 1" width="120px"/><column label="Column 2" width="120px"/><column label="Column 3" width="120px"/><column label="Column 4" width="120px"/><column label="Column 5" width="120px"/><column label="Column 6" width="120px"/><column label="Column 7" width="120px"/><column label="Column 8" width="120px"/><column label="Column 9" width="120px"/><column label="Column 10" width="120px"/></columns>
        <rows><row><cell><label value="r1c1"/></cell><cell><label value="r1c2"/></cell><cell><label value="r1c3"/></cell><cell><label value="r1c4"/></cell><cell><label value="r1c5"/></cell><cell><label value="r1c6"/></cell><cell><label value="r1c7"/></cell><cell><label value="r1c8"/></cell><cell><label value="r1c9"/></cell><cell><label value="r1c10"/></cell></row><row><cell><label value="r2c1"/></cell><cell><label value="r2c2"/></cell><cell><label value="r2c3"/></cell><cell><label value="r2c4"/></cell><cell><label value="r2c5"/></cell><cell><label value="r2c6"/></cell><cell><label value="r2c7"/></cell><cell><label value="r2c8"/></cell><cell><label value="r2c9"/></cell><cell><label value="r2c10"/></cell></row><row><cell><label value="r3c1"/></cell><cell><label value="r3c2"/></cell><cell><label value="r3c3"/></cell><cell><label value="r3c4"/></cell><cell><label value="r3c5"/></cell><cell><label value="r3c6"/></cell><cell><label value="r3c7"/></cell><cell><label value="r3c8"/></cell><cell><label value="r3c9"/></cell><cell><label value="r3c10"/></cell></row></rows>
        <foot><footer label="Footer 1" width="120px"/><footer label="Footer 2" width="120px"/><footer label="Footer 3" width="120px"/><footer label="Footer 4" width="120px"/><footer label="Footer 5" width="120px"/><footer label="Footer 6" width="120px"/><footer label="Footer 7" width="120px"/><footer label="Footer 8" width="120px"/><footer label="Footer 9" width="120px"/><footer label="Footer 10" width="120px"/></foot>
    </grid>
    <listbox sclass="fz-listbox" width="500px" height="200px"><frozen columns="2" rightColumns="1"/>
        <listhead><listheader label="Column 1" width="120px"/><listheader label="Column 2" width="120px"/><listheader label="Column 3" width="120px"/><listheader label="Column 4" width="120px"/><listheader label="Column 5" width="120px"/><listheader label="Column 6" width="120px"/><listheader label="Column 7" width="120px"/><listheader label="Column 8" width="120px"/><listheader label="Column 9" width="120px"/><listheader label="Column 10" width="120px"/></listhead>
        <listitem><listcell label="r1c1"/><listcell label="r1c2"/><listcell label="r1c3"/><listcell label="r1c4"/><listcell label="r1c5"/><listcell label="r1c6"/><listcell label="r1c7"/><listcell label="r1c8"/><listcell label="r1c9"/><listcell label="r1c10"/></listitem><listitem><listcell label="r2c1"/><listcell label="r2c2"/><listcell label="r2c3"/><listcell label="r2c4"/><listcell label="r2c5"/><listcell label="r2c6"/><listcell label="r2c7"/><listcell label="r2c8"/><listcell label="r2c9"/><listcell label="r2c10"/></listitem><listitem><listcell label="r3c1"/><listcell label="r3c2"/><listcell label="r3c3"/><listcell label="r3c4"/><listcell label="r3c5"/><listcell label="r3c6"/><listcell label="r3c7"/><listcell label="r3c8"/><listcell label="r3c9"/><listcell label="r3c10"/></listitem>
        <listfoot><listfooter label="Footer 1" width="120px"/><listfooter label="Footer 2" width="120px"/><listfooter label="Footer 3" width="120px"/><listfooter label="Footer 4" width="120px"/><listfooter label="Footer 5" width="120px"/><listfooter label="Footer 6" width="120px"/><listfooter label="Footer 7" width="120px"/><listfooter label="Footer 8" width="120px"/><listfooter label="Footer 9" width="120px"/><listfooter label="Footer 10" width="120px"/></listfoot>
    </listbox>
    <tree sclass="fz-tree" width="500px" height="200px"><frozen columns="2" rightColumns="1"/>
        <treecols><treecol label="Column 1" width="120px"/><treecol label="Column 2" width="120px"/><treecol label="Column 3" width="120px"/><treecol label="Column 4" width="120px"/><treecol label="Column 5" width="120px"/><treecol label="Column 6" width="120px"/><treecol label="Column 7" width="120px"/><treecol label="Column 8" width="120px"/><treecol label="Column 9" width="120px"/><treecol label="Column 10" width="120px"/></treecols>
        <treechildren><treeitem><treerow><treecell label="r1c1"/><treecell label="r1c2"/><treecell label="r1c3"/><treecell label="r1c4"/><treecell label="r1c5"/><treecell label="r1c6"/><treecell label="r1c7"/><treecell label="r1c8"/><treecell label="r1c9"/><treecell label="r1c10"/></treerow></treeitem><treeitem><treerow><treecell label="r2c1"/><treecell label="r2c2"/><treecell label="r2c3"/><treecell label="r2c4"/><treecell label="r2c5"/><treecell label="r2c6"/><treecell label="r2c7"/><treecell label="r2c8"/><treecell label="r2c9"/><treecell label="r2c10"/></treerow></treeitem><treeitem><treerow><treecell label="r3c1"/><treecell label="r3c2"/><treecell label="r3c3"/><treecell label="r3c4"/><treecell label="r3c5"/><treecell label="r3c6"/><treecell label="r3c7"/><treecell label="r3c8"/><treecell label="r3c9"/><treecell label="r3c10"/></treerow></treeitem></treechildren>
        <treefoot><treefooter label="Footer 1"/><treefooter label="Footer 2" width="120px"/><treefooter label="Footer 3" width="120px"/><treefooter label="Footer 4" width="120px"/><treefooter label="Footer 5" width="120px"/><treefooter label="Footer 6" width="120px"/><treefooter label="Footer 7" width="120px"/><treefooter label="Footer 8" width="120px"/><treefooter label="Footer 9" width="120px"/><treefooter label="Footer 10" width="120px"/></treefoot>
    </tree>
</vlayout>
</zk>
