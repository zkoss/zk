<zk xmlns:h="native">
<apply templateURI="~./pv/matrix.zul" title="States"
       cols="${['Default','Disabled']}"
       rowsTemplate="selectbox-rows">
    <template name="selectbox-rows">
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="Default"/></div>
            <div>
                <selectbox model="${selectModel}">
                    <template name="model">${each}</template>
                </selectbox>
            </div>
            <div>
                <selectbox model="${selectModel}" disabled="true">
                    <template name="model">${each}</template>
                </selectbox>
            </div>
        </div>
    </template>
</apply>

<h:div class="z-mb-6">
    <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Pre-selected Value</h:span></h:div>
    <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
        <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
            <h:div><h:span class="z-text-xs z-text-secondary">selectedIndex=&quot;2&quot; (shows &quot;Charlie&quot; on load)</h:span></h:div>
            <selectbox model="${selectModel}" >
                <template name="model">${each}</template>
            </selectbox>
        </h:div>
    </h:div>
</h:div>
</zk>
