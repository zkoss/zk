<?page title="Toolbarbutton height" contentType="text/html;charset=UTF-8"?>
<!-- Fixture for explicit-size.spec.ts (toolbarbutton). Lives under pv/ so gallery-scan, forced-colors-gallery and
     font-size-equivalence do not pick it up as a page. -->
<zk>
	<toolbar>
		<toolbarbutton id="plain" label="Default"/>
		<toolbarbutton id="height24" label="Height" height="24px"/>
		<div height="24px" style="display:inline-block"><toolbarbutton id="vflex" label="Vflex" vflex="1"/></div>
		<toolbarbutton id="image" image="~./zul/img/misc/progress-72-noanim.png"/>
		<toolbarbutton id="imageHeight24" image="~./zul/img/misc/progress-72-noanim.png" height="24px"/>
	</toolbar>
</zk>
