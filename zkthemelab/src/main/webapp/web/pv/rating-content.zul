<zk xmlns:h="native">
<apply templateURI="~./pv/matrix.zul" title="States"
       cols="${['Default','Disabled','Readonly']}"
       rowsTemplate="rating-rows">
    <template name="rating-rows">
        <div sclass="z-d-contents">
            <div><label sclass="z-text-sm z-text-secondary" value="3 stars"/></div>
            <div><rating rating="3"/></div>
            <div><rating rating="3" disabled="true"/></div>
            <div><rating rating="3" readonly="true"/></div>
        </div>
    </template>
</apply>

<h:div class="z-mb-6">
    <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Max Stars</h:span></h:div>
    <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
        <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
            <h:div><h:span class="z-text-xs z-text-secondary">3 max</h:span></h:div>
            <rating max="3" rating="2"/>
        </h:div>
        <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
            <h:div><h:span class="z-text-xs z-text-secondary">5 max (default)</h:span></h:div>
            <rating max="5" rating="3"/>
        </h:div>
        <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
            <h:div><h:span class="z-text-xs z-text-secondary">10 max</h:span></h:div>
            <rating max="10" rating="7"/>
        </h:div>
    </h:div>
</h:div>

<h:div class="z-mb-6">
    <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Custom Icon (iconSclass)</h:span></h:div>
    <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
        <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
            <h:div><h:span class="z-text-xs z-text-secondary">z-icon-bolt (3/5)</h:span></h:div>
            <rating iconSclass="z-icon-bolt" rating="3"/>
        </h:div>
        <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
            <h:div><h:span class="z-text-xs z-text-secondary">z-icon-gift (2/5)</h:span></h:div>
            <rating iconSclass="z-icon-gift" rating="2"/>
        </h:div>
    </h:div>
</h:div>

<h:div class="z-mb-6">
    <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Vertical</h:span></h:div>
    <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
        <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
            <h:div><h:span class="z-text-xs z-text-secondary">Vertical (3/5)</h:span></h:div>
            <rating orient="vertical" rating="3"/>
        </h:div>
        <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
            <h:div><h:span class="z-text-xs z-text-secondary">Vertical disabled</h:span></h:div>
            <rating orient="vertical" rating="3" disabled="true"/>
        </h:div>
        <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
            <h:div><h:span class="z-text-xs z-text-secondary">Vertical readonly</h:span></h:div>
            <rating orient="vertical" rating="3" readonly="true"/>
        </h:div>
    </h:div>
</h:div>
</zk>
