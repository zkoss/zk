<?page title="Video guard" contentType="text/html;charset=UTF-8"?>
<!-- Fixture for media.spec.ts (video): width/height, clipToFit and dimBackground. No src, so each <video>
     keeps the browser's 300x150 default size. Lives under pv/ so gallery-scan,
     forced-colors-gallery and font-size-equivalence do not pick it up as a page. -->
<zk xmlns:h="native">
<h:div class="z-p-8">
    <video sclass="sized" width="200px" height="100px"/>
    <video sclass="clip" width="200px" height="100px" clipToFit="true"/>
    <video sclass="dim" width="200px" height="100px" dimBackground="true"/>
</h:div>
</zk>
