<?page title="Empty combobox popup guard" contentType="text/html;charset=UTF-8"?>
<!-- Fixture for hit-target.spec.ts (empty Combobox popup): an open combobox without items. Lives under pv/ so gallery-scan, forced-colors-gallery and font-size-equivalence do not pick it up. -->
