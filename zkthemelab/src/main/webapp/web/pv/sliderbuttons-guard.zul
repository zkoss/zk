<?page title="Sliderbuttons guard" contentType="text/html;charset=UTF-8"?>
<!-- Fixture for sliderbuttons.spec.ts: a rangeslider (zkex) and a multislider (zkmax) on one page.
     Both render the shared Sliderbuttons sub-widget, so the `.z-sliderbuttons-*` rules of one must not
     restyle the other. Lives under pv/ so gallery-scan, forced-colors-gallery and
     font-size-equivalence do not pick it up as a page. -->
<zk xmlns:h="native">
<h:div class="z-p-8">
    <h:div class="z-py-12">
        <rangeslider startValue="20" endValue="80" width="400px"/>
    </h:div>
    <h:div class="z-py-12">
        <multislider width="400px">
            <sliderbuttons startValue="20" endValue="80"/>
        </multislider>
    </h:div>
</h:div>
</zk>
