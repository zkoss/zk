<?page title="Portallayout last panel guard" contentType="text/html;charset=UTF-8"?>
<!-- Fixture for explicit-size.spec.ts (portallayout last panel): vflex panels in a column without a title, and a panel
     in a column with a title. Lives under pv/ so gallery-scan, forced-colors-gallery and font-size-equivalence do not pick it up. -->
<zk>
<div style="padding:16px">
    <portallayout id="plain" width="500px" height="300px" style="border: 1px solid green">
        <portalchildren hflex="1" vflex="1">
            <panel title="Panel 1" vflex="1" border="normal"/>
            <panel title="Panel 2" vflex="1" border="normal"/>
        </portalchildren>
        <portalchildren hflex="1">
            <panel title="Panel 3" vflex="1" border="normal"/>
        </portalchildren>
    </portallayout>
    <portallayout id="framedAuto" width="500px" style="margin-top:16px">
        <portalchildren title="Framed, auto height" hflex="1">
            <panel title="Panel 6" height="100px" border="normal"/>
        </portalchildren>
    </portallayout>
</div>
</zk>
