<?page title="Daterangebox anchor" contentType="text/html;charset=UTF-8"?>
<!-- Fixture for daterangebox-anchor.spec.ts: an empty box (for the hover preview band) and a box whose
     range crosses 1 February (for the committed band). Lives under pv/ so gallery-scan,
     forced-colors-gallery and font-size-equivalence do not pick it up as a page. -->
<zk>
<zscript><![CDATA[
	java.util.Date b = new java.util.Date(125, 0, 25); // 2025-01-25
	java.util.Date e = new java.util.Date(125, 1, 5);  // 2025-02-05
]]></zscript>
<vlayout spacing="16px">
	<daterangebox id="empty" format="yyyy-MM-dd"/>
	<daterangebox id="crossing" format="yyyy-MM-dd" beginValue="${b}" endValue="${e}"/>
</vlayout>
</zk>
