<?page title="Sticky header guard" contentType="text/html;charset=UTF-8"?>
<!-- Fixture for mesh-header-footer.spec.ts (sticky header): a grid, a listbox and a tree with sclass="z-sticky-header",
     each in its own 200px scroll container with more rows than fit. Lives under pv/ so
     gallery-scan, forced-colors-gallery and font-size-equivalence do not pick it up as a page. -->
<zk xmlns:h="native">
<zscript><![CDATA[
    String[] items = new String[30];
    for (int i = 0; i < items.length; i++) items[i] = "Item " + (i + 1);
]]></zscript>
<h:div class="z-p-8">
    <div style="height:200px; overflow-y:auto">
        <grid sclass="z-sticky-header" width="400px">
            <columns><column label="Name"/></columns>
            <rows><row forEach="${items}"><label value="${each}"/></row></rows>
        </grid>
    </div>
    <div style="height:200px; overflow-y:auto">
        <listbox sclass="z-sticky-header" width="400px">
            <listhead><listheader label="Name"/></listhead>
            <listitem forEach="${items}" label="${each}"/>
        </listbox>
    </div>
    <div style="height:200px; overflow-y:auto">
        <tree sclass="z-sticky-header" width="400px">
            <treecols><treecol label="Name"/></treecols>
            <treechildren>
                <treeitem forEach="${items}" label="${each}"/>
            </treechildren>
        </tree>
    </div>
</h:div>
</zk>
