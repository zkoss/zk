<?page title="Narrow input fields" contentType="text/html;charset=UTF-8"?>
<!-- Fixture for hit-target.spec.ts. The .ing-fit rows give each field a width that is common in a table cell but
     narrower than its input's old em floor plus its button: the button has to stay whole inside the box and own its
     centre. The second .ing-fit row repeats them in compact density. The .ing-35 row is B50-3101558: 35px is narrower
     than the input's padding plus the button, so only the box is guaranteed: nothing runs into the next field.
     Lives under pv/ so gallery-scan does not pick it up. -->
<zk xmlns:ca="client/attribute">
<vlayout spacing="12px">
    <div sclass="ing-fit">
        <combobox width="60px"><comboitem label="Item 1"/></combobox>
        <bandbox width="70px"><bandpopup>Content</bandpopup></bandbox>
        <datebox width="80px"/>
        <timebox width="70px"/>
        <spinner width="60px"/>
    </div>
    <div sclass="ing-fit" ca:data-density="compact">
        <combobox width="60px"><comboitem label="Item 1"/></combobox>
        <bandbox width="70px"><bandpopup>Content</bandpopup></bandbox>
        <datebox width="80px"/>
        <timebox width="70px"/>
        <spinner width="60px"/>
    </div>
    <div sclass="ing-35">
        <combobox width="35px"/>
        <bandbox width="35px"/>
        <datebox width="35px"/>
        <timebox width="35px"/>
        <spinner width="35px"/>
        <textbox width="35px"/>
    </div>
</vlayout>
</zk>
