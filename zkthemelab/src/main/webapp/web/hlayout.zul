<?page title="Hlayout" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="native">
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">Hlayout</h:span></h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Basic Horizontal Layout</h:span></h:div>
        <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">Default spacing</h:span></h:div>
                <hlayout>
                    <button label="Button 1"/>
                    <button label="Button 2"/>
                    <button label="Button 3"/>
                </hlayout>
            </h:div>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Spacing Variants</h:span></h:div>
        <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">spacing=&quot;0&quot;</h:span></h:div>
                <hlayout spacing="0">
                    <button label="A"/>
                    <button label="B"/>
                    <button label="C"/>
                </hlayout>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">spacing=&quot;16px&quot;</h:span></h:div>
                <hlayout spacing="16px">
                    <button label="A"/>
                    <button label="B"/>
                    <button label="C"/>
                </hlayout>
            </h:div>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Vertical Alignment (valign)</h:span></h:div>
        <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">valign=&quot;top&quot; (default)</h:span></h:div>
                <hlayout valign="top">
                    <button label="Short"/>
                    <button label="Tall" style="height:60px"/>
                    <label value="Label"/>
                </hlayout>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">valign=&quot;middle&quot;</h:span></h:div>
                <hlayout valign="middle">
                    <button label="Short"/>
                    <button label="Tall" style="height:60px"/>
                    <label value="Label"/>
                </hlayout>
            </h:div>
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">valign=&quot;bottom&quot;</h:span></h:div>
                <hlayout valign="bottom">
                    <button label="Short"/>
                    <button label="Tall" style="height:60px"/>
                    <label value="Label"/>
                </hlayout>
            </h:div>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Spacing Auto</h:span></h:div>
        <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">spacing=&quot;auto&quot; (theme controls gap)</h:span></h:div>
                <hlayout spacing="auto">
                    <button label="A"/>
                    <button label="B"/>
                    <button label="C"/>
                </hlayout>
            </h:div>
        </h:div>
    </h:div>

    <h:div class="z-mb-6">
        <h:div class="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><h:span class="z-text-xs z-fw-semibold z-text-secondary">Mixed Children</h:span></h:div>
        <h:div class="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <h:div class="z-d-flex z-flex-col z-items-start z-gap-2">
                <h:div><h:span class="z-text-xs z-text-secondary">Label + Textbox + Button</h:span></h:div>
                <hlayout>
                    <label value="Label"/>
                    <textbox value="Text"/>
                    <button label="Submit"/>
                </hlayout>
            </h:div>
        </h:div>
    </h:div>

</h:div>
</zk>
