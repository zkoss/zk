    java.util.Date sampleBegin = new java.util.Date(125, 0, 10);  // 2025-01-10
    java.util.Date sampleEnd   = new java.util.Date(125, 0, 15);  // 2025-01-15
]]></zscript>
<h:div class="z-p-8">
