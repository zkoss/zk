<?page title="Lucide Icons" contentType="text/html;charset=UTF-8"?>
<zk>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Lucide Icons"/></div>

    <label sclass="z-text-sm z-text-secondary z-d-block z-mb-4" value="All 1947 Lucide icons. Usage: iconSclass=&quot;z-icon-{name}&quot; or sclass=&quot;z-icon-{name}&quot;"/>
