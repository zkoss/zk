<?page title="Overview" contentType="text/html;charset=UTF-8"?>
<?component name="hlayout" extends="hlayout" spacing="10px" ?>
<?component name="vlayout" extends="vlayout" spacing="10px" ?>
<zk xmlns:h="native">
<zscript><![CDATA[
    import org.zkoss.zul.*;
    String[] strs = new String[20];
    for (int i = 0; i < 20; i++)
        strs[i] = "Item " + i;
    ListModel model = new SimpleListModel(strs);
    model.multiple = true;
]]></zscript>
<div sclass="z-p-8">
    <div sclass="z-border-bottom z-mb-8 z-pb-3"><label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Overview"/></div>
    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Tabbox"/></div>
        <div sclass="z-py-3 z-d-flex z-gap-6">
            <tabbox hflex="1" style="min-height:120px">
                <tabs>
                    <tab forEach="1,2,3" label="Tab ${each}"/>
                </tabs>
                <tabpanels>
                    <tabpanel forEach="1,2,3">
                        Tabpanel ${each}
                    </tabpanel>
                </tabpanels>
            </tabbox>
            <tabbox hflex="1" mold="accordion" style="min-height:120px">
                <tabs>
                    <tab forEach="1,2,3" label="Tab ${each}"/>
                </tabs>
                <tabpanels>
                    <tabpanel forEach="1,2,3">
                        Tabpanel ${each}
                    </tabpanel>
                </tabpanels>
            </tabbox>
        </div>
    </div>
    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Data Components"/></div>
        <div sclass="z-py-3 z-d-flex z-gap-6">
            <grid model="${model}" hflex="1" mold="paging" pageSize="10" style="min-height:200px">
                <auxhead>
                    <auxheader label="Auxheader" colspan="2"/>
                </auxhead>
                <columns>
                    <column label="Header 1" sort="auto"/>
                    <column label="Header 2" sort="auto"/>
                </columns>
                <foot>
                    <footer span="2">Footer</footer>
                </foot>
            </grid>
            <listbox model="${model}" hflex="1" mold="paging" pageSize="10" checkmark="true" style="min-height:200px">
                <auxhead>
                    <auxheader label="Auxheader" colspan="2"/>
                </auxhead>
                <listhead>
                    <listheader label="Header 1" sort="auto"/>
                    <listheader label="Header 2" sort="auto"/>
                </listhead>
                <listfoot>
                    <listfooter span="2">Listfooter</listfooter>
                </listfoot>
            </listbox>
        </div>
    </div>
    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Form Inputs"/></div>
        <div sclass="z-d-flex z-items-start z-flex-wrap z-gap-6 z-py-3">
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Doublebox"/></div>
                <doublebox width="160px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Datebox"/></div>
                <datebox width="160px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Bandbox"/></div>
                <bandbox width="160px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Combobox"/></div>
                <combobox width="160px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Timebox"/></div>
                <timebox width="160px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Spinner"/></div>
                <spinner width="120px"/>
            </div>
            <div sclass="z-d-flex z-flex-col z-items-start z-gap-2">
                <div><label sclass="z-text-xs z-text-secondary" value="Doublespinner"/></div>
                <doublespinner width="120px"/>
            </div>
        </div>
    </div>
    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Buttons"/></div>
        <div sclass="z-py-3 z-d-flex z-gap-4 z-flex-wrap">
            <button label="Button"/>
            <combobutton label="Combobutton"/>
        </div>
    </div>
    <div sclass="z-mb-6">
        <div sclass="z-text-uppercase z-border-bottom z-pb-2 z-mb-4"><label sclass="z-text-xs z-fw-semibold z-text-secondary" value="Menubar"/></div>
        <div sclass="z-py-3">
            <menubar>
                <menu label="Menu">
                    <menupopup>
                        <menuitem label="Menuitem"/>
                        <menuseparator/>
                        <menuitem label="Menuitem" image="~./img/Centigrade-Widget-Icons/DisketteBlack-16x16.png"/>
                    </menupopup>
                </menu>
                <menuitem label="Menuitem"/>
            </menubar>
        </div>
    </div>
</div>
</zk>
