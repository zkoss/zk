<zscript>
ListModel searchModel = new ListModelArray(new String[]{
    "North America", "South America", "Europe", "Asia", "Africa", "Oceania", "Antarctica"
});
</zscript>
<h:div class="z-p-8">
    <h:div class="z-border-bottom z-mb-8 z-pb-3"><h:span class="z-text-2xl z-fw-medium z-text-on-surface">Searchbox</h:span></h:div>
    <apply templateURI="~./pv/searchbox-content.zul"/>
</h:div>
</zk>
