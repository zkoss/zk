<?page title="Marble preview — index" contentType="text/html;charset=UTF-8"?>
<!-- The home page of the preview app: a link to every preview page.
     The list comes from PageIndexVM, which scans /web at request time, so a page added on disk
     appears here without editing this file.
     Typography is set on each <label>/<a>, never on a wrapper <div>: ZK renders raw text as a
     zul.wgt.Label and .z-label declares its own font and colour, which makes a font-size on the
     container a dead declaration. See the marble-theme skill, reference/zul-authoring.md. -->
<zk>
<div viewModel="@id('vm')@init('zk.example.PageIndexVM')" sclass="z-p-8">

	<div sclass="z-border-bottom z-mb-3 z-pb-3">
		<label sclass="z-text-2xl z-fw-medium z-text-on-surface" value="Marble preview"/>
	</div>

	<div sclass="z-mb-8">
		<label sclass="z-text-sm z-text-secondary" value="@init(vm.totalCount)"/>
		<label sclass="z-text-sm z-text-secondary"
			   value=" pages under src/main/webapp/web/. These links use the direct URL form, the same addresses the Playwright specs drive."/>
	</div>

	<div sclass="z-border-bottom z-pb-2 z-mb-4">
		<label sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary" value="Entry points"/>
	</div>
	<div sclass="z-d-flex z-flex-col z-gap-2 z-mb-8">
		<a href="usecase/index.zul" sclass="z-text-sm"
		   label="usecase/index.zul — navigable app shell, grouped nav tree, #hash deep links"/>
		<a href="preview.zul" sclass="z-text-sm"
		   label="preview.zul — every root-level page inlined on a single scroll"/>
		<a href="smoke.zul" sclass="z-text-sm"
		   label="smoke.zul — five widgets, proves the server and the theme came up"/>
	</div>

	<forEach items="@init(vm.groups)" var="g">
		<div sclass="z-mb-8">
			<div sclass="z-border-bottom z-pb-2 z-mb-2">
				<label sclass="z-text-xs z-fw-semibold z-text-uppercase z-text-secondary" value="@init(g.label)"/>
				<label sclass="z-text-xs z-text-secondary z-ms-2" value="@init(g.count)"/>
			</div>
			<div sclass="z-mb-4">
				<label sclass="z-text-xs z-text-secondary" value="@init(g.note)"/>
			</div>
			<div sclass="z-d-grid z-grid-fill z-grid-fill-sm z-gap-2">
				<forEach items="@init(g.pages)" var="p">
					<a href="@init(p.href)" sclass="z-text-sm" label="@init(p.name)"/>
				</forEach>
			</div>
		</div>
	</forEach>

</div>
</zk>
