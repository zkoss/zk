<!-- Jess #44: anchornav highlights the clicked item but does not scroll to the section.
     Same structure as the preview app shell: <center autoscroll> > <div height="100%">.
     jess-44-plain.zul is the same content without the borderlayout. -->
<zk xmlns:ca="client/attribute">
	<borderlayout height="500px">
		<center autoscroll="true">
			<div height="100%">
				<anchornav>
					<listbox sizedByContent="true" hflex="min">
						<listitem><listcell><a ca:data-anchornav-target="$win1">First Window</a></listcell></listitem>
						<listitem><listcell><a ca:data-anchornav-target="$win2">Second Window</a></listcell></listitem>
						<listitem><listcell><a ca:data-anchornav-target="$win3">Third Window</a></listcell></listitem>
					</listbox>
				</anchornav>
				<div id="win1" style="height:800px;background:skyblue">1. First Section</div>
				<div id="win2" style="height:800px;background:coral">2. Second Section</div>
				<div id="win3" style="height:800px;background:bisque">3. Third Section</div>
			</div>
		</center>
	</borderlayout>
</zk>
