<!-- Jess #56: window mode=popup is shown at the bottom of the page, outside the viewport.
     `auto` mirrors the preview page (mode=popup with no visible="false"); `shown` is the same window
     opened on demand with doPopup(). -->
<zk>
	<button id="btn" label="Show Popup" onClick="shown.doPopup();"/>
	<window id="shown" visible="false" title="Window: Popup (doPopup)" border="normal" mode="popup"
		closable="true" width="300px" height="180px">
		Window Content
	</window>
	<div height="900px">Page content taller than the viewport</div>
	<window id="auto" title="Window: Popup (no visible=false)" border="normal" mode="popup"
		closable="true" width="300px" height="180px">
		Window Content
	</window>
</zk>
