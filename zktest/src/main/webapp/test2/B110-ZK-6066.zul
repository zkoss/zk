<zk>
	<window title="Checkbox mold a11y attributes" border="normal" width="760px">
		<vlayout spacing="10px" style="padding: 12px;">
			<label multiline="true">
				1. run this page with the za11y (WCAG) module
				2. inspect the mold element of the switch checkbox
				3. role, aria-checked and aria-disabled must not be wrapped in extra double quotes
			</label>
			<separator />
			<hlayout spacing="8px">
				<label value="ZK Checkbox:" />
				<checkbox id="cbA11y" label="Receive notifications" />
			</hlayout>
			<hlayout spacing="8px">
				<label value="ZK Checkbox (switch mold):" />
				<checkbox mold="switch" label="Receive notifications" />
			</hlayout>
		</vlayout>
	</window>
</zk>
