<zk>
	<vlayout viewModel="@id('vm') @init('org.zkoss.zktest.test2.F111_ZK_5992VM')">
		<label value="ZK-5992 — tbeditor plugins with MVVM"/>
		<label multiline="true">
            1. tbList: plugins="@load(vm.pluginList)" binds a List → loads colors.
            2. tbCsv: plugins="@load(vm.pluginCsv)" binds a String → loads fontsize and emoji.
            3. Click "switch plugins": tbList re-renders with history only, tbCsv with no plugin.
		</label>
		<tbeditor id="tbList" plugins="@load(vm.pluginList)" width="500px"/>
		<tbeditor id="tbCsv" plugins="@load(vm.pluginCsv)" width="500px"/>
		<button id="switch" label="switch plugins" onClick="@command('switchPlugins')"/>
	</vlayout>
</zk>
