<zk>
	<label multiline="true">
        listheader responsiveVisible="false": the Email column is hidden in stacking (its cells get z-cell-hide-stacking) but shown in table mode.
    </label>
	<div style="padding: 10px;">
		<listbox id="lb1" responsive="stacking" width="100%">
			<listhead>
				<listheader label="Name" />
				<listheader label="Email" responsiveVisible="false" />
				<listheader label="Department" />
			</listhead>
			<listitem>
				<listcell label="John" />
				<listcell label="john@example.com" />
				<listcell label="Engineering" />
			</listitem>
			<listitem>
				<listcell label="Jane" />
				<listcell label="jane@example.com" />
				<listcell label="Design" />
			</listitem>
		</listbox>
	</div>
</zk>
