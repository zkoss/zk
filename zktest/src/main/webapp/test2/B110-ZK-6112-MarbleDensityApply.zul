<zk>
	<label multiline="true">
		MarbleDensity.apply(Component, Density) reaches the DOM on the first call for an already rendered
		component, not only from the second call on.
	</label>
	<div id="region">
		<textbox/>
	</div>
	<button id="compact" label="compact"
			onClick="org.zkoss.zul.theme.MarbleDensity.apply(region, org.zkoss.zul.theme.MarbleDensity.Density.COMPACT)"/>
	<button id="comfortable" label="comfortable"
			onClick="org.zkoss.zul.theme.MarbleDensity.apply(region, org.zkoss.zul.theme.MarbleDensity.Density.COMFORTABLE)"/>
</zk>
