<zk>
	<label multiline="true">
	click "show", then make the browser narrower. if the window moves to stay centered horizontally and stays near the top, it's correct.
	</label>
	<button label="show" onClick="win.doHighlighted()"/>
	<window id="win" title="highlighted" border="normal" width="300px" visible="false">
		no position is set, so ZK places this window
	</window>
</zk>
