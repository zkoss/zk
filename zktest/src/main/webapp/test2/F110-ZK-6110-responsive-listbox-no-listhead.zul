<zk>
	<label multiline="true">
        A listbox authored without a listhead has no column information at all, so
        stacking must not stamp anything on its cells — no data-label, no hide class
        and no checkbox-gutter layout. The checkmarks stay usable.
    </label>
	<div width="100%">
		<listbox id="lb1" width="100%" checkmark="true" multiple="true"
				responsive="stacking" responsiveColumns="sm-1 md-none">
			<listitem>
				<listcell label="John" /><listcell label="john@example.com" />
			</listitem>
			<listitem>
				<listcell label="Jane" /><listcell label="jane@example.com" />
			</listitem>
			<listfoot>
				<listfooter id="ftEmpty" />
			</listfoot>
		</listbox>
	</div>
</zk>
