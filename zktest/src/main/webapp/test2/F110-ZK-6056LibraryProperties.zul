<zk>
	<label multiline="true"><![CDATA[
	Run with library property org.zkoss.zul.chosenbox.filterLogic=contains.
	1. Click the chosenbox below and type "US".
	Expected: locales whose toString contains "US" appear, e.g. en_US, es_US.
	]]></label>
	<zscript><![CDATA[
		ListSubModel subModel = ListModels.toListSubModel(new ListModelList(Locale.getAvailableLocales()));
	]]></zscript>
	<chosenbox width="400px" model="${subModel}"/>
</zk>
