<zk>
	<label multiline="true">
		1. click the textbox in the window, then click "other": an error box opens to the right of the textbox in the window
		2. click the title bar of the window: the error box should stay to the right of the textbox and does not move
	</label>
	<textbox id="other" placeholder="other"/>
	<window id="win" title="Overlapped" mode="overlapped" border="normal" width="400px" height="150px">
		<textbox id="inWindow" constraint="no empty"/>
	</window>
</zk>
