<zk>
	<label multiline="true">
		1. Narrow the viewport below the breakpoint
		2. verify the nested non-responsive grid keeps its table rendering
		   (its rows are not turned into cards)
	</label>
	<div style="padding: 10px;">
		<grid id="outer" responsive="stacking" width="100%">
			<columns>
				<column label="Name" />
				<column label="Detail" />
			</columns>
			<rows>
				<row>
					<label value="John" />
					<grid id="inner" responsive="none" width="200px">
						<columns>
							<column label="Inner" />
						</columns>
						<rows>
							<row>
								<label value="alpha" />
							</row>
							<row>
								<label value="beta" />
							</row>
						</rows>
					</grid>
				</row>
			</rows>
		</grid>
	</div>
</zk>
