<zk>
	<label multiline="true">
		Every button variant is --zk-button-height tall (36px by default, 30px under data-density="compact"),
		except the icon-only button, which is --zk-icon-button-size (40px, 32px compact).
	</label>
	<hlayout id="region" spacing="12px" valign="middle">
		<button id="filled" label="Filled"/>
		<button id="outlined" label="Outlined" sclass="z-button-outlined"/>
		<button id="text" label="Text" sclass="z-button-text"/>
		<button id="iconLabel" label="With icon" iconSclass="z-icon-home"/>
		<button id="iconOnly" iconSclass="z-icon-home" sclass="z-button-icon" tooltiptext="Home"/>
	</hlayout>
	<hlayout spacing="12px">
		<button id="openConfirmpopup" label="Open confirmpopup" onClick="cp.open(self)"/>
		<button id="openMessagebox" label="Open messagebox"
				onClick='Messagebox.show("Proceed?", "Confirm", Messagebox.OK | Messagebox.CANCEL, Messagebox.QUESTION)'/>
	</hlayout>
	<confirmpopup id="cp" message="Delete this?"/>
</zk>
