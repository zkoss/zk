<zk>
	<label multiline="true" value="Open the upload dialog and choose a file. Its row should retain the usual styling. Cancel the row, choose a replacement, and submit; the result should contain only the replacement file."/>
	<button id="open" label="Open upload dialog">
		<attribute name="onClick"><![CDATA[
			Fileupload.get(1, new org.zkoss.zk.ui.event.EventListener() {
				public void onEvent(org.zkoss.zk.ui.event.Event event) {
					org.zkoss.util.media.Media[] media = ((org.zkoss.zk.ui.event.UploadEvent) event).getMedias();
					result.setValue(media == null ? "none" : media.length + ":" + media[0].getName());
				}
			});
		]]></attribute>
	</button>
	<label id="result"/>
</zk>
