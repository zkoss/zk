<?evaluator name="mvel"?>
<window id="w" title="mvel">
	<label multiline="true">
		ZK-6167: on JDK 17, the "mvel" evaluator must evaluate ordinary expressions (MVEL's default ASM optimizer cannot define classes there).

		The labels below must show 3 and mvel.
	</label>
	<label id="sum" value="${1 + 2}"/>
	<label id="title" value="${w.title}"/>
</window>
