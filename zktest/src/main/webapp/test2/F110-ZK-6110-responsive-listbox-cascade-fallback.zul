<zk>
	<label multiline="true">
        responsiveColumns="md-none" has no numeric anchor, so the client falls back to
        the default cascade "sm-1 md-none": stacking with 1 column below md, table at
        and above md. The fallback must be silent — no error box.
    </label>
	<div width="100%">
		<listbox id="lb1" width="100%" responsive="stacking" responsiveColumns="md-none">
			<listhead>
				<listheader label="Name" />
				<listheader label="Email" />
			</listhead>
			<listitem>
				<listcell label="John" /><listcell label="john@example.com" />
			</listitem>
			<listitem>
				<listcell label="Jane" /><listcell label="jane@example.com" />
			</listitem>
		</listbox>
	</div>
</zk>
