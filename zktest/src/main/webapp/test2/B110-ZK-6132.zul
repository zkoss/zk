<zk xmlns="http://www.zkoss.org/2005/zul">
	<window apply="org.zkoss.zktest.test2.B110_ZK_6132Composer">
		<vlayout spacing="10px" style="padding:16px;">
			<!-- The renamed tokens must render, i.e. reach z-<comp>-<severity>. -->
			<hlayout spacing="10px">
				<chip  id="chipError"    label="chip error"    severity="error"/>
				<chip  id="chipNeutral"  label="chip neutral"  severity="neutral"/>
				<badge id="badgeError"   value="E"             severity="error"/>
				<badge id="badgeNeutral" value="N"             severity="neutral"/>
			</hlayout>

			<hlayout spacing="10px">
				<button id="btnOpenError"   label="Open error"   onClick='cpError.open(self);'/>
				<confirmpopup id="cpError"   severity="error"   message="Permanently delete?"/>
				<button id="btnOpenNeutral" label="Open neutral" onClick='cpNeutral.open(self);'/>
				<confirmpopup id="cpNeutral" severity="neutral" message="Just FYI"/>
			</hlayout>

			<!-- The retired Bootstrap tokens must throw, with no alias fallback. -->
			<hlayout spacing="10px">
				<button id="btnChipOld"  label="chip danger/secondary"/>
				<button id="btnBadgeOld" label="badge danger/secondary"/>
				<button id="btnPopupOld" label="popup danger/secondary"/>
			</hlayout>
			<hlayout spacing="10px">
				<button id="btnChipNew"  label="chip error/neutral"/>
				<button id="btnBadgeNew" label="badge error/neutral"/>
				<button id="btnPopupNew" label="popup error/neutral"/>
			</hlayout>

			<label id="chipResult"  value=""/>
			<label id="badgeResult" value=""/>
			<label id="popupResult" value=""/>
		</vlayout>
	</window>
</zk>
