<zk>
	<label multiline="true">
        The second column is responsiveVisible="false", so its cells are hidden while
        stacked. Detaching the listhead removes the column information altogether, so
        the hide stamps must be cleared instead of leaving the cells display:none.
    </label>
	<div width="100%">
		<listbox id="lb1" width="100%" responsive="stacking" responsiveColumns="sm-1 md-none">
			<listhead id="lh">
				<listheader label="Name" />
				<listheader label="Secret" responsiveVisible="false" />
			</listhead>
			<listitem>
				<listcell label="John" /><listcell label="john-secret" />
			</listitem>
			<listitem>
				<listcell label="Jane" /><listcell label="jane-secret" />
			</listitem>
		</listbox>
		<button id="btnRemoveHead" label="Detach listhead" onClick="lh.detach()" />
	</div>
</zk>
