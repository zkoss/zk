<zk>
	<label multiline="true">
		Declaring a class in zscript turns on BeanShell's accessibility for the whole JVM.
		Reload F110-ZK-6167-zscript.zul after this page.
	</label>
	<zscript><![CDATA[
		class B110ZK6167 {
			String get() { return "declared"; }
		}
		String declared = new B110ZK6167().get();
	]]></zscript>
	<label id="declared" value="${declared}"/>
</zk>
