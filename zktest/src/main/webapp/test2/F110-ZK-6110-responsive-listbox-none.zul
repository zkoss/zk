<zk>
	<label multiline="true">
        responsive="none": stays in table mode even when narrow (never stacks).
    </label>
	<div style="padding: 10px;">
		<listbox id="lb1" responsive="none" width="100%">
			<listhead>
				<listheader label="Name" />
				<listheader label="Email" />
			</listhead>
			<listitem>
				<listcell label="John" />
				<listcell label="john@example.com" />
			</listitem>
			<listitem>
				<listcell label="Jane" />
				<listcell label="jane@example.com" />
			</listitem>
		</listbox>
	</div>
</zk>
