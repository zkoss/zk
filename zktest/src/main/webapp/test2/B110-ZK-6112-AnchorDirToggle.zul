<zk>
	<label multiline="true">
		Toggle dir: the anchor's icon gap must follow the direction (z-a-reverse added/removed).
	</label>
	<a id="anchor" label="ZK" iconSclass="z-icon-external-link" href="https://www.zkoss.org"/>
	<button id="toReverse" label="reverse" onClick='anchor.setDir("reverse")'/>
	<button id="toNormal" label="normal" onClick='anchor.setDir("normal")'/>
</zk>
