<?xml version="1.0" encoding="UTF-8"?>
<!--
F110-ZK-6085-PortallayoutPopupColumns.zul

	Purpose:
		Portallayout's move popup lists the columns the portallayout has when it opens.

	Description:
		With za11y, a column added or removed after the portallayout rendered shows up in, or
		disappears from, the move popup, and a panel can be moved into the added column. Enter on a
		column removed while the popup is open moves nothing.

	History:
		Fri Oct 16 12:01:32 CST 2026, Created by peggypeng

Copyright (C) 2026 Potix Corporation. All Rights Reserved.

-->
<zk>
	<label multiline="true">
		1. press Tab until "Mail" is focused and press Space: the popup lists "Left (current)" and "Right"; press Escape
		2. click "add a column", focus "Mail" and press Space: the popup lists "Left (current)", "Right" and "Later"
		3. press Down; with the popup still open, remove "Right" by running zAu.send(new zk.Event(zk.$('$removeColumn'), 'onClick', {}, {toServer: true})) in the console, as a click would close the popup; press Enter: the popup closes, nothing moves, and there is no error
		4. press Space: the popup lists "Left (current)" and "Later"
		5. press Down and Enter: "Mail" moves to "Later", and there is no error
	</label>
	<portallayout id="layout">
		<portalchildren title="Left" width="30%">
			<panel id="mail" title="Mail"/>
			<panel id="calendar" title="Calendar"/>
		</portalchildren>
		<portalchildren id="right" title="Right" width="30%">
			<panel id="news" title="News"/>
		</portalchildren>
	</portallayout>
	<button id="addColumn" label="add a column">
		<attribute name="onClick"><![CDATA[
			org.zkoss.zkmax.zul.Portalchildren later = new org.zkoss.zkmax.zul.Portalchildren();
			later.setId("later");
			later.setTitle("Later");
			later.setWidth("30%");
			layout.appendChild(later);
		]]></attribute>
	</button>
	<button id="removeColumn" label="remove Right" onClick="right.detach()"/>
</zk>
