<zk>
	<label multiline="true">
		1. Create a file whose name contains HTML, e.g. &lt;img src=x onerror=alert(1)&gt;.txt
		2. Click "Open upload dialog", click Browse... and pick that file.
		Expected: the dialog shows the file name as plain text, exactly as it is on disk; no image is added and no alert pops up.
	</label>
	<button id="open" label="Open upload dialog"
		onClick='Fileupload.get(1, new org.zkoss.zk.ui.event.EventListener() { public void onEvent(org.zkoss.zk.ui.event.Event e) {} });'/>
</zk>
