<zk>
	<listbox id="lb" width="400px" height="300px">
		<listhead>
			<listheader label="A"/>
			<listheader label="B"/>
		</listhead>
		<listitem>
			<listcell label="a0"/>
			<listcell label="b0"/>
		</listitem>
		<listitem>
			<listcell label="a1"/>
			<listcell label="b1"/>
		</listitem>
	</listbox>

	<grid id="gd" width="400px" height="300px">
		<columns>
			<column label="A"/>
			<column label="B"/>
		</columns>
		<rows>
			<row>
				<label value="a0"/>
				<label value="b0"/>
			</row>
			<row>
				<label value="a1"/>
				<label value="b1"/>
			</row>
		</rows>
	</grid>

	<tree id="tr" width="400px" height="300px">
		<treecols>
			<treecol label="A"/>
			<treecol label="B"/>
		</treecols>
		<treechildren>
			<treeitem>
				<treerow>
					<treecell label="a0"/>
					<treecell label="b0"/>
				</treerow>
			</treeitem>
			<treeitem>
				<treerow>
					<treecell label="a1"/>
					<treecell label="b1"/>
				</treerow>
			</treeitem>
		</treechildren>
	</tree>

	<menubar id="mb">
		<menu id="mn" label="Menu">
			<menupopup>
				<menuitem id="mi" label="Checked" checkmark="true" checked="true"/>
				<menuitem id="mi2" label="Unchecked" checkmark="true"/>
			</menupopup>
		</menu>
	</menubar>

	<toolbar id="tb">
		<toolbarbutton id="tbb" label="Toolbarbutton"/>
	</toolbar>

	<slider id="sl"/>

	<checkbox id="cb" label="Checked" checked="true"/>

	<button id="btn" label="Button"/>

	<!-- no size= : the unsized group is the one whose overlap used to be pinned
	     on .z-avatargroup itself. -->
	<avatargroup id="ag">
		<avatar label="A"/>
		<avatar label="B"/>
	</avatargroup>

	<button id="cpb" label="Confirm" onClick='cp.open(self);'/>
	<!-- default placement "top": the arrow's inner triangle is its ::after
	     border-top-color. -->
	<confirmpopup id="cp" message="Confirm?"/>

	<listbox id="lbc" checkmark="true" multiple="true" width="400px" height="200px">
		<listitem id="lic">
			<listcell label="c0"/>
		</listitem>
	</listbox>

	<carousel id="cr" width="320px" height="160px" showArrows="true">
		<!-- label present so the label-background token has a node to read it off. -->
		<carouselitem id="cri0" label="Slide one">
			<div width="100%" height="100%" style="background:#1677ff;"/>
		</carouselitem>
		<carouselitem id="cri1">
			<div width="100%" height="100%" style="background:#52c41a;"/>
		</carouselitem>
	</carousel>
</zk>
