<zk>
	<label multiline="true">
		1. Type 0 in "Intbox" inside the "Edit" window.
		2. Click "Cancel". The window should close.
		3. Wait at least 1 second and check the browser console: there should be no JavaScript error.
	</label>
	<intbox id="quantity" constraint="no negative, no zero: Quantity must be at least 1"/>
	<window id="win" title="Edit" border="normal" width="300px">
		<hlayout valign="middle">
			<label value="Intbox:"/>
			<intbox constraint="no zero"/>
		</hlayout>
		<button label="Cancel" onClick="Thread.sleep(150); win.detach();"/>
	</window>
</zk>
