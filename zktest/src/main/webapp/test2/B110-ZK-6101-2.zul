<zk>
	<label multiline="true">
		Same as B110-ZK-6101.zul but with automatic-timeout disabled, so nothing should happen
		while the user does nothing.

		Expected: after ~15s the page is still here (not redirected to "/timeout.zul"), even
		though the ignorable onTimer request observes the timeout.
	</label>
	<zscript><![CDATA[
	void tick() {
		// No-op; just keep the timer firing ignorable onTimer requests.
	}
	]]></zscript>
	<timer id="timer" delay="1000" repeats="true" onTimer="tick()" onCreate="self.start()"/>
</zk>
