<zk xmlns:n="native">
    <n:h1>WCAG 2.1 - 4.1.3 status messages</n:h1>
    <label multiline="true">
        1. press "start"
        2. open devtools and find the div right after .z-loadingbar - that sibling is the
           [aria-live=polite] region, and it is where progress is announced. The region should only change when a 25% band is crossed.
        3. press "26%" - the region reads "Loading 26%"
        4. press "27%" - the region does NOT change: 27 is still in the same 25% band
        5. press "51%" - the region reads "Loading 51%", the next band crossing
        6. press "indeterminate" - the region is emptied, since there is no progress to report
        7. with a screen reader on, only steps 3 and 5 should be spoken
    </label>
    <div apply="org.zkoss.zktest.test2.F110_ZK_6084_LoadingbarComposer">
        <hlayout>
            <button id="start" label="start"/>
            <button id="to26" label="26%"/>
            <button id="to27" label="27%"/>
            <button id="to51" label="51%"/>
            <button id="indeterminate" label="indeterminate"/>
        </hlayout>
    </div>
</zk>
