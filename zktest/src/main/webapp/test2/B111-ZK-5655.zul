<zk>
	<label multiline="true">
		Open this page in Safari on iOS.
		1. Tap "Color": the palette opens.
		2. Tap the picker icon, then the palette icon: each tap switches the pane.
		3. Tap a color: the label below shows that color.
	</label>
	<menubar>
		<menu id="menu" label="Color" content="#color=#184dc6" onChange="lb.value = event.value"/>
	</menubar>
	<label id="lb"/>
</zk>
