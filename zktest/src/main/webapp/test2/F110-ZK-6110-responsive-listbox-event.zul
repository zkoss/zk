<zk>
	<label multiline="true">
        A ZUL onResponsiveModeChange listener must still be delivered to the
        server after the event stopped being an important client event.
    </label>
	<div style="padding: 10px;">
		<label id="modeStatus" value="mode: unknown" />
		<listbox id="lbEvt" responsive="stacking" width="100%">
			<listhead>
				<listheader label="Name" />
				<listheader label="Email" />
				<listheader label="Department" />
			</listhead>
			<listitem>
				<listcell label="John" />
				<listcell label="john@example.com" />
				<listcell label="Engineering" />
			</listitem>
			<listitem>
				<listcell label="Jane" />
				<listcell label="jane@example.com" />
				<listcell label="Design" />
			</listitem>
			<listitem>
				<listcell label="Bob" />
				<listcell label="bob@example.com" />
				<listcell label="Sales" />
			</listitem>
			<attribute name="onResponsiveModeChange"><![CDATA[
				modeStatus.setValue("mode: " + event.getData().get("mode"));
			]]></attribute>
		</listbox>
	</div>
</zk>
