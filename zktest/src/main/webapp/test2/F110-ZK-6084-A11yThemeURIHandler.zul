<zk>
	<label multiline="true">
		1. Click "iceblue" (its theme jar ships za11y's stylesheet); the page reloads.
		2. In DevTools, the za11y stylesheet is loaded from .../iceblue/za11y/css/iceblue.css.dsp, the theme jar's copy.
		3. Click "marble"; the page reloads.
		4. The za11y stylesheet is loaded from .../za11y/css/marble.css.dsp, za11y's own copy.
	</label>
	<button label="iceblue" onClick='org.zkoss.zul.theme.Themes.setTheme(Executions.getCurrent(), "iceblue");Executions.sendRedirect(null);'/>
	<button label="marble" onClick='org.zkoss.zul.theme.Themes.setTheme(Executions.getCurrent(), "marble");Executions.sendRedirect(null);'/>
</zk>
