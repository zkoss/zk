<zk>
	<label multiline="true">
1. press Tab until "Translate" is focused, then press Space: the move popup opens
2. press ArrowDown: "Doing" is focused and has a focus ring, not only a grey fill
	</label>
	<portallayout>
		<portalchildren title="Todo" width="30%">
			<panel title="Calendar"/>
			<panel id="translate" title="Translate"/>
		</portalchildren>
		<portalchildren title="Doing" width="30%">
			<panel title="Mail"/>
		</portalchildren>
	</portallayout>
</zk>
