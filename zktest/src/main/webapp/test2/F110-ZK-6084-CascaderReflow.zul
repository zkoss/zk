<zk xmlns:n="native" xmlns:ca="client/attribute">
    <n:h1>Cascader popup capped to the viewport</n:h1>
    <label multiline="true">
        The cascader popup is capped to the viewport, scrolling its caves horizontally inside
        rather than widening the page.
    </label>
    <zscript><![CDATA[
        import org.zkoss.zktest.test2.F90_ZK_4392Model;
        TreeModel m1 = new F90_ZK_4392Model("A");
    ]]></zscript>
    <cascader id="cas" model="${m1}" width="300px" placeholder="empty" ca:aria-label="Choose something">
        <template name="model">
            ${each}
        </template>
    </cascader>
</zk>
