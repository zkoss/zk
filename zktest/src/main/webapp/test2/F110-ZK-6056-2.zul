<zk>
	<label multiline="true"><![CDATA[
	1. Click the chosenbox below and type "_".
	Expected: exactly 50 options, the nRows given to toListSubModel.
	]]></label>
	<zscript><![CDATA[
		ListModelList model = new ListModelList(Locale.getAvailableLocales());
		ListSubModel subModel = ListModels.toListSubModel(model, ListModels.STRING_COMPARATOR, 50);
	]]></zscript>
	<chosenbox width="400px" model="${subModel}">
		<custom-attributes org.zkoss.zul.chosenbox.filterLogic="contains"/>
	</chosenbox>
</zk>
