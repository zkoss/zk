<zk>
	<label id="msg" value="${labels.zk6089.message}"/>
	<button id="zhTW" label="zh_TW">
		<attribute name="onClick"><![CDATA[
			session.setAttribute(org.zkoss.web.Attributes.PREFERRED_LOCALE, org.zkoss.util.Locales.getLocale("zh_TW"));
			execution.sendRedirect(null);
		]]></attribute>
	</button>
</zk>
