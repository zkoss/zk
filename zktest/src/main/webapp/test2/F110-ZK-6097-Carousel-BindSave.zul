<zk xmlns="http://www.zkoss.org/2005/zul">
	<style>
		.cs { display:flex; align-items:center; justify-content:center;
			  width:100%; height:100%; box-sizing:border-box; font-size:32px; color:#fff; }
	</style>
	<window apply="org.zkoss.bind.BindComposer"
			viewModel="@id('vm') @init('org.zkoss.zktest.test2.F110_ZK_6097_CarouselBindSaveVM')">
		<vlayout spacing="8px" style="padding:16px;">
			<!-- No @command here on purpose: the VM can only learn the new index
			     through the activeIndex SAVE binding, so this page goes stale if
			     carousel loses its ZKBIND registration in zkbind's lang-addon. -->
			<carousel id="crBindSave" width="320px" height="160px"
					activeIndex="@bind(vm.activeIndex)">
				<carouselitem id="cbs0">
					<div sclass="cs" style="background:#1677ff;">Slide 1</div>
				</carouselitem>
				<carouselitem id="cbs1">
					<div sclass="cs" style="background:#52c41a;">Slide 2</div>
				</carouselitem>
				<carouselitem id="cbs2">
					<div sclass="cs" style="background:#faad14;">Slide 3</div>
				</carouselitem>
			</carousel>

			<label id="saved" value="@load(vm.savedIndex)"/>
		</vlayout>
	</window>
</zk>
