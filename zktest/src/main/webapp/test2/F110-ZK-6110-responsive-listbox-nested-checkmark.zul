<zk>
	<label multiline="true">
        A checkable listbox nested inside a listcell: the OUTER (checkmark-less)
        stacking listbox must not mistake the nested checkmark for its own
        (no z-cell-cm-lead / z-cell-cm-only on the outer cells).
    </label>
	<div style="padding: 10px;">
		<listbox id="outer" responsive="stacking" width="100%">
			<listhead>
				<listheader label="Name" />
				<listheader label="Choices" />
			</listhead>
			<listitem>
				<listcell label="John" />
				<listcell>
					<listbox id="inner" checkmark="true" multiple="true" width="200px">
						<listitem label="alpha" />
						<listitem label="beta" />
					</listbox>
				</listcell>
			</listitem>
		</listbox>
	</div>
</zk>
