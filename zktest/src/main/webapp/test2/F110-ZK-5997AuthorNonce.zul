<html xmlns="http://www.zkoss.org/2005/zk/native"
	xmlns:u="http://www.zkoss.org/2005/zul"
	xmlns:zk="http://www.zkoss.org/2005/zk">
	<head>
		<title>F110-ZK-5997 native page with an author-supplied nonce</title>
		<zkhead/>
		<!-- the page writes the nonce itself; ZK must not stamp a second one -->
		<script type="text/javascript" nonce="${cspNonce}">
			window.zkAuthorNonceNativeLoaded = true;
		</script>
	</head>
	<body>
		<u:label id="msg" value="native page with author nonce"/>
	</body>
</html>
