<zk>
	<label multiline="true">
        Basic stacking: collapses to cards below md (768px), restores on widen.
    </label>
	<div style="padding: 10px;">
		<listbox id="lb1" responsive="stacking" width="100%">
			<listhead>
				<listheader label="Name" />
				<listheader label="Email" />
				<listheader label="Department" />
			</listhead>
			<listitem>
				<listcell label="John" />
				<listcell label="john@example.com" />
				<listcell label="Engineering" />
			</listitem>
			<listitem>
				<listcell label="Jane" />
				<listcell label="jane@example.com" />
				<listcell label="Design" />
			</listitem>
			<listitem>
				<listcell label="Bob" />
				<listcell label="bob@example.com" />
				<listcell label="Sales" />
			</listitem>
		</listbox>
	</div>
</zk>
