<zk>
	<label multiline="true">
1. The blue box (a dropdown inside the borderlayout center, z-index 90000) must be painted above the red box (a body-level layer, z-index 100).
	</label>
	<div style="position: relative">
		<borderlayout height="200px">
			<center>
				<div id="dd" style="position: absolute; top: 20px; left: 20px; width: 100px; height: 100px; z-index: 90000; background: blue"/>
			</center>
		</borderlayout>
		<div id="overlay" style="position: absolute; top: 0; left: 0; width: 200px; height: 200px; z-index: 100; background: red"/>
	</div>
</zk>
