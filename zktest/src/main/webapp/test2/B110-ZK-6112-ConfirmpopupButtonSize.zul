<zk>
	<label multiline="true">
		Open the confirmpopup: its OK and Cancel must be as tall as the plain button.
	</label>
	<hlayout spacing="24px" valign="middle">
		<button id="plain" label="Plain button"/>
		<button id="opener" label="Open confirmpopup" onClick="pc.open(self)"/>
	</hlayout>
	<confirmpopup id="pc" severity="info" title="Publish changes"
				  message="Make these changes visible to everyone?"/>
</zk>
